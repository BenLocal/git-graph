<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GitGraph.App.ViewModels"
             xmlns:ctl="using:GitGraph.App.Controls"
             x:Class="GitGraph.App.Views.SidebarView"
             x:DataType="vm:MainWindowViewModel"
             Background="{DynamicResource FrameBrush}">
  <UserControl.Resources>
    <DataTemplate x:Key="FolderRowTemplate" x:DataType="vm:FolderNodeViewModel">
      <Button Classes="nav" Classes.active="{Binding IsActive}" Command="{Binding OpenCommand}" ToolTip.Tip="{Binding Path}">
        <Button.ContextMenu>
          <ContextMenu>
            <MenuItem Header="Open files" Command="{Binding OpenCommand}" />
            <MenuItem Header="Open in VS Code" Command="{Binding OpenInVsCodeCommand}" />
            <MenuItem Header="Copy path" Command="{Binding CopyPathCommand}" />
            <Separator IsVisible="{Binding IsFolder}" />
            <MenuItem Header="Remove from workspace" Command="{Binding RemoveCommand}" IsVisible="{Binding IsFolder}" />
          </ContextMenu>
        </Button.ContextMenu>
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Panel VerticalAlignment="Center">
            <LucideIcon Kind="Folder" Size="14" IsVisible="{Binding IsFolder}" />
            <LucideIcon Kind="FolderTree" Size="13" IsVisible="{Binding IsWorktree}" />
          </Panel>
          <TextBlock Grid.Column="1" Classes="name" Margin="8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
          <TextBlock Grid.Column="2" Classes="muted small" Text="{Binding Branch}" IsVisible="{Binding IsWorktree}" VerticalAlignment="Center"
                     MaxWidth="110" TextTrimming="CharacterEllipsis" />
          <Button Grid.Column="2" Classes="ghost hover" Padding="3" ToolTip.Tip="Remove from workspace" Command="{Binding RemoveCommand}"
                  IsVisible="{Binding IsFolder}">
            <LucideIcon Kind="X" Size="12" />
          </Button>
        </Grid>
      </Button>
    </DataTemplate>
  </UserControl.Resources>

  <DockPanel>
    <!-- Workspace switcher -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="8,10,6,6">
      <ComboBox Classes="switcher" ItemsSource="{Binding Workspaces}" SelectedItem="{Binding SelectedWorkspace}"
                HorizontalAlignment="Stretch" ToolTip.Tip="Switch workspace">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="vm:WorkspaceViewModel">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <LucideIcon Kind="Layers" Size="15" VerticalAlignment="Center" />
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <Button Grid.Column="1" Classes="ghost" Padding="5" Margin="2,0,0,0" Command="{Binding NewWorkspaceCommand}" ToolTip.Tip="New workspace">
        <LucideIcon Kind="Plus" Size="15" />
      </Button>
      <Button Grid.Column="2" Classes="ghost" Padding="5" ToolTip.Tip="Workspace options">
        <LucideIcon Kind="Ellipsis" Size="15" />
        <Button.Flyout>
          <MenuFlyout Placement="BottomEdgeAlignedRight">
            <MenuItem Header="Rename workspace…" Command="{Binding RenameWorkspaceCommand}" />
            <MenuItem Header="Rescan folders" Command="{Binding SelectedWorkspace.ScanCommand}" />
            <Separator />
            <MenuItem Header="Delete workspace…" Command="{Binding DeleteWorkspaceCommand}" />
          </MenuFlyout>
        </Button.Flyout>
      </Button>
    </Grid>

    <!-- Theme -->
    <Border DockPanel.Dock="Bottom" Padding="8,6">
      <Button Classes="ghost" HorizontalAlignment="Left" Command="{Binding CycleThemeCommand}" ToolTip.Tip="Switch between night, day and the system setting">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <LucideIcon Kind="SunMoon" Size="14" VerticalAlignment="Center" />
          <TextBlock Classes="muted small" VerticalAlignment="Center" Text="{Binding ThemeLabel, StringFormat='Theme: {0}'}" />
        </StackPanel>
      </Button>
    </Border>

    <ScrollViewer DataContext="{Binding SelectedWorkspace}" x:DataType="vm:WorkspaceViewModel">
      <StackPanel Margin="8,4,8,12" Spacing="2">

        <!-- Folders -->
        <Grid ColumnDefinitions="*,Auto" Margin="6,8,0,2">
          <TextBlock Classes="section" Text="Folders" VerticalAlignment="Center" />
          <Button Grid.Column="1" Classes="ghost" Padding="4" Command="{Binding AddFolderCommand}" ToolTip.Tip="Add folder">
            <LucideIcon Kind="FolderPlus" Size="15" />
          </Button>
        </Grid>
        <!--
          Workspace folders, each with the linked worktrees inside it nested underneath (like the worktrees of a
          repository below). Worktrees elsewhere are reached from the Repositories section's context menu.
          A single click previews a folder's files in a tab; a double-click keeps the tab.
        -->
        <ItemsControl ItemsSource="{Binding FolderNodes}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:FolderNodeViewModel">
              <StackPanel Spacing="1">
                <Grid ColumnDefinitions="18,*">
                  <Button Classes="ghost" Padding="1" Width="18" Height="18" IsVisible="{Binding HasWorktrees}"
                          Command="{Binding ToggleExpandedCommand}" ToolTip.Tip="Show or hide worktrees">
                    <LucideIcon Kind="ChevronDown" Size="14" Classes="chevron" Classes.collapsed="{Binding !IsExpanded}" />
                  </Button>
                  <ContentControl Grid.Column="1" Content="{Binding}" ContentTemplate="{StaticResource FolderRowTemplate}" />
                </Grid>
                <Border Classes="nest" IsVisible="{Binding IsExpanded}">
                  <ItemsControl ItemsSource="{Binding Worktrees}" ItemTemplate="{StaticResource FolderRowTemplate}" />
                </Border>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Classes="muted small" Margin="6,2,6,0" TextWrapping="Wrap" IsVisible="{Binding !HasFolders}"
                   Text="No folders yet. Add one to find the repositories inside it." />

        <!-- Repositories and their worktrees -->
        <Grid ColumnDefinitions="*,Auto" Margin="6,16,0,2">
          <TextBlock Classes="section" Text="Repositories" VerticalAlignment="Center" />
          <Button Grid.Column="1" Classes="ghost" Padding="4" Command="{Binding ScanCommand}" ToolTip.Tip="Rescan folders">
            <LucideIcon Kind="RotateCw" Size="14" />
          </Button>
        </Grid>
        <TextBlock Classes="muted small" Margin="6,0" Text="Looking for repositories…" IsVisible="{Binding IsScanning}" />
        <TextBlock Classes="muted small" Margin="6,0" TextWrapping="Wrap" IsVisible="{Binding HasNoRepos}"
                   Text="No repositories in these folders. Repositories up to three levels deep are found." />

        <ItemsControl ItemsSource="{Binding Repos}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:RepoNodeViewModel">
              <StackPanel Spacing="1">
                <Grid ColumnDefinitions="18,*">
                  <Button Classes="ghost" Padding="1" Width="18" Height="18" IsVisible="{Binding HasLinkedWorktrees}"
                          Command="{Binding ToggleExpandedCommand}" ToolTip.Tip="Show or hide worktrees">
                    <Panel>
                      <LucideIcon Kind="ChevronDown" Size="14" Classes="chevron" Classes.collapsed="{Binding !IsExpanded}" />
                    </Panel>
                  </Button>
                  <Button Grid.Column="1" Classes="nav" Classes.active="{Binding IsActive}" Command="{Binding OpenCommand}"
                          ToolTip.Tip="{Binding MainPath}">
                    <Button.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="Open history" Command="{Binding OpenCommand}" />
                        <MenuItem Header="Browse files" Command="{Binding BrowseFilesCommand}" />
                        <MenuItem Header="Open in VS Code" Command="{Binding OpenInVsCodeCommand}" />
                        <Separator />
                        <MenuItem Header="Add worktree…" Command="{Binding AddWorktreeCommand}" />
                        <MenuItem Header="Prune missing worktrees" Command="{Binding PruneWorktreesCommand}" />
                      </ContextMenu>
                    </Button.ContextMenu>
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                      <LucideIcon Kind="FolderGit2" Size="15" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Classes="name" Margin="8,0,8,0" Text="{Binding Name}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Classes="muted small" Text="{Binding Branch}" VerticalAlignment="Center"
                                 HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
                      <!-- Commits to pull and push, as in VS Code's status bar; marked when a fetch just brought them in -->
                      <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" Margin="6,0,0,0" VerticalAlignment="Center"
                                  Background="Transparent" ToolTip.Tip="{Binding SyncTooltip}">
                        <LucideIcon Kind="CloudAlert" Size="13" VerticalAlignment="Center" IsVisible="{Binding HasFetchError}" />
                        <TextBlock Classes="sync small" Classes.fresh="{Binding HasNewCommits}" Text="{Binding SyncCounts}" VerticalAlignment="Center" />
                      </StackPanel>
                    </Grid>
                  </Button>
                </Grid>
                <ItemsControl ItemsSource="{Binding Worktrees}" IsVisible="{Binding IsExpanded}" Margin="26,0,0,2">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:WorktreeNodeViewModel">
                      <Button Classes="nav" Classes.active="{Binding IsActive}" Command="{Binding OpenCommand}" ToolTip.Tip="{Binding Tooltip}"
                              Opacity="{Binding IsPrunable, Converter={x:Static vm:Converters.DimIfTrue}}">
                        <Button.ContextMenu>
                          <ContextMenu>
                            <MenuItem Header="Open history" Command="{Binding OpenCommand}" />
                            <MenuItem Header="Browse files" Command="{Binding BrowseFilesCommand}" />
                            <MenuItem Header="Open in VS Code" Command="{Binding OpenInVsCodeCommand}" />
                            <Separator />
                            <MenuItem Header="Remove worktree…" Command="{Binding RemoveCommand}" />
                          </ContextMenu>
                        </Button.ContextMenu>
                        <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                          <LucideIcon Kind="FolderTree" Size="13" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="1" Classes="name" Margin="8,0,8,0" Text="{Binding Name}" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="2" Classes="muted small" Text="{Binding Branch}" VerticalAlignment="Center"
                                     HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
                          <TextBlock Grid.Column="3" Classes="sync small" Classes.fresh="{Binding HasNewCommits}" Text="{Binding SyncCounts}"
                                     Margin="6,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
