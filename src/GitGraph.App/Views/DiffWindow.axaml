<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GitGraph.App.ViewModels"
        xmlns:ctl="using:GitGraph.App.Controls"
        x:Class="GitGraph.App.Views.DiffWindow"
        x:DataType="vm:FullDiffViewModel"
        Title="{Binding Path, StringFormat='{}{0} – Git Graph'}"
        Icon="/Assets/Icons/gitgraph-256.png"
        Width="1280" Height="800" MinWidth="640" MinHeight="400"
        WindowState="Maximized" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource CanvasBrush}">
  <Grid RowDefinitions="Auto,Auto,*">
    <!-- File and range -->
    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource RuleBrush}" BorderThickness="0,0,0,1" Padding="20,10,10,10">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="2">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Classes="title mono" Text="{Binding Path}" VerticalAlignment="Center" />
            <TextBlock Classes="add mono" Text="{Binding AddText}" VerticalAlignment="Center" />
            <TextBlock Classes="del mono" Text="{Binding DelText}" VerticalAlignment="Center" Margin="-6,0,0,0" />
          </StackPanel>
          <TextBlock Classes="muted small" Text="{Binding OldPath, StringFormat='Renamed from {0}'}" IsVisible="{Binding HasOldPath}" />
          <TextBlock Classes="muted small" Text="{Binding Range}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Top">
          <Button Classes="ghost text" Command="{Binding ExpandAllCommand}" IsVisible="{Binding HasFolds}"
                  ToolTip.Tip="Show every unchanged line">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <ctl:IconView Data="{StaticResource I.Chevron}" Width="14" Height="14" VerticalAlignment="Center" />
              <TextBlock Classes="small" Text="Expand all" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="ghost text" Command="{Binding CollapseAllCommand}" IsVisible="{Binding HasFolds}"
                  ToolTip.Tip="Fold unchanged lines again">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <ctl:IconView Data="{StaticResource I.ChevronUp}" Width="14" Height="14" VerticalAlignment="Center" />
              <TextBlock Classes="small" Text="Collapse all" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Border Width="1" Background="{DynamicResource RuleBrush}" Margin="4,6" IsVisible="{Binding HasFolds}" />
          <Button Classes="ghost" Click="OnClose" ToolTip.Tip="Close (Esc)">
            <ctl:IconView Data="{StaticResource I.Close}" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Which side is which -->
    <Grid Grid.Row="1" ColumnDefinitions="*,1,*" Background="{DynamicResource SurfaceBrush}" IsVisible="{Binding !HasMessage}">
      <TextBlock Classes="section" Text="Before" Margin="58,6" />
      <Border Grid.Column="1" Background="{DynamicResource RuleBrush}" />
      <TextBlock Grid.Column="2" Classes="section" Text="After" Margin="58,6" />
    </Grid>

    <TextBlock Grid.Row="2" Classes="muted" Text="{Binding Message}" Margin="20" IsVisible="{Binding HasMessage}" />
    <ListBox Grid.Row="2" Classes="dense plain" ItemsSource="{Binding Items}" IsVisible="{Binding !HasMessage}"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.DataTemplates>
        <DataTemplate DataType="vm:SplitRowViewModel">
          <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SplitRowTemplate}" />
        </DataTemplate>
        <!-- A folded stretch of unchanged lines; click to open or close it. -->
        <DataTemplate DataType="vm:FoldViewModel">
          <Button Classes="fold" Command="{Binding $parent[Window].((vm:FullDiffViewModel)DataContext).ToggleFoldCommand}"
                  CommandParameter="{Binding}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <ctl:IconView Data="{StaticResource I.Chevron}" Width="14" Height="14" VerticalAlignment="Center" IsVisible="{Binding !IsExpanded}" />
              <ctl:IconView Data="{StaticResource I.ChevronUp}" Width="14" Height="14" VerticalAlignment="Center" IsVisible="{Binding IsExpanded}" />
              <TextBlock Classes="small" Text="{Binding Label}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </DataTemplate>
      </ListBox.DataTemplates>
    </ListBox>
  </Grid>
</Window>
