<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GitGraph.App.ViewModels"
        xmlns:ctl="using:GitGraph.App.Controls"
        xmlns:v="using:GitGraph.App.Views"
        xmlns:svc="using:GitGraph.App.Services"
        x:Class="GitGraph.App.Views.DiffWindow"
        x:DataType="vm:FullDiffViewModel"
        Title="{Binding Path, StringFormat='{}{0} – Git Graph'}"
        Icon="/Assets/Icons/gitgraph-256.png"
        Width="1280" Height="800" MinWidth="640" MinHeight="400"
        WindowState="Maximized" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource CanvasBrush}">
  <Grid RowDefinitions="Auto,Auto,*,Auto">
    <!-- File and range -->
    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource RuleBrush}" BorderThickness="0,0,0,1" Padding="20,10,10,10">
      <Grid ColumnDefinitions="*,Auto">
        <!-- A long path trims from the left, so the file name stays visible; the full path is in the tooltip. -->
        <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*">
          <Button Classes="ghost" Padding="4" Margin="-8,0,4,0" Command="{Binding CopyPathCommand}" ToolTip.Tip="Copy path">
            <Panel>
              <LucideIcon Kind="Copy" Size="14" IsVisible="{Binding !IsCopied}" />
              <LucideIcon Kind="Check" Size="14" IsVisible="{Binding IsCopied}" Foreground="{DynamicResource AddFgBrush}" />
            </Panel>
          </Button>
          <TextBlock Grid.Column="1" Classes="title mono" Text="{Binding Path}" VerticalAlignment="Center" Background="Transparent"
                     TextTrimming="LeadingCharacterEllipsis" ToolTip.Tip="{Binding Path}" Margin="0,0,16,0">
            <TextBlock.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Copy path" Command="{Binding CopyPathCommand}" />
                <MenuItem Header="Copy full path" Command="{Binding CopyFullPathCommand}" />
              </ContextMenu>
            </TextBlock.ContextMenu>
          </TextBlock>
          <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="10" Margin="0,2,0,0">
            <TextBlock Classes="add mono small" Text="{Binding AddText}" VerticalAlignment="Center" />
            <TextBlock Classes="del mono small" Text="{Binding DelText}" VerticalAlignment="Center" Margin="-4,0,0,0" />
            <TextBlock Classes="muted small" Text="{Binding Range}" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Grid.Row="2" Grid.Column="1" Classes="muted small" Text="{Binding OldPath, StringFormat='Renamed from {0}'}"
                     IsVisible="{Binding HasOldPath}" TextTrimming="LeadingCharacterEllipsis" ToolTip.Tip="{Binding OldPath}" />
        </Grid>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Top">
          <!-- Step through the changes; the current one is outlined on both sides -->
          <TextBlock Classes="muted small" Text="{Binding ChangePosition}" VerticalAlignment="Center" Margin="0,0,4,0" />
          <Button Classes="ghost" Command="{Binding PreviousChangeCommand}" IsEnabled="{Binding HasChanges}"
                  ToolTip.Tip="{Binding Tips[PreviousChange], Source={x:Static svc:ShortcutService.Instance}}">
            <LucideIcon Kind="ArrowUp" Size="14" />
          </Button>
          <Button Classes="ghost" Command="{Binding NextChangeCommand}" IsEnabled="{Binding HasChanges}"
                  ToolTip.Tip="{Binding Tips[NextChange], Source={x:Static svc:ShortcutService.Instance}}">
            <LucideIcon Kind="ArrowDown" Size="14" />
          </Button>
          <Border Width="1" Background="{DynamicResource RuleBrush}" Margin="4,6" />
          <Button Classes="ghost text" Command="{Binding ExpandAllCommand}" IsVisible="{Binding HasFolds}"
                  ToolTip.Tip="Show every unchanged line">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <LucideIcon Kind="ChevronDown" Size="14" VerticalAlignment="Center" />
              <TextBlock Classes="small" Text="Expand all" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="ghost text" Command="{Binding CollapseAllCommand}" IsVisible="{Binding HasFolds}"
                  ToolTip.Tip="Fold unchanged lines again">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <LucideIcon Kind="ChevronUp" Size="14" VerticalAlignment="Center" />
              <TextBlock Classes="small" Text="Collapse all" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Border Width="1" Background="{DynamicResource RuleBrush}" Margin="4,6" IsVisible="{Binding HasFolds}" />
          <Button Classes="ghost" Click="OnClose" ToolTip.Tip="Close (Esc)">
            <LucideIcon Kind="X" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Which side is which -->
    <Grid Grid.Row="1" ColumnDefinitions="*,56,*,14" Background="{DynamicResource SurfaceBrush}" IsVisible="{Binding !HasMessage}">
      <TextBlock Classes="section" Text="Before" Margin="12,6" />
      <TextBlock Grid.Column="2" Classes="section" Text="After" Margin="12,6" />
    </Grid>

    <TextBlock Grid.Row="2" Classes="muted" Text="{Binding Message}" Margin="20" IsVisible="{Binding HasMessage}" />
    <v:CompareView Grid.Row="2" IsVisible="{Binding !HasMessage}" />

    <!-- The caret's line above its counterpart, with the changed words marked -->
    <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource RuleBrush}" BorderThickness="0,1,0,0"
            Padding="0,4" IsVisible="{Binding !HasMessage}">
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <StackPanel>
          <Grid Classes="diffline" Classes.del="{Binding IsDetailDeleted}" ColumnDefinitions="64,*">
            <TextBlock Classes="lineno" Text="{Binding DetailOldNo}" />
            <ctl:DiffText Grid.Column="1" Line="{Binding DetailOld.Text, FallbackValue={x:Null}}" Segments="{Binding DetailOld.Segments, FallbackValue={x:Null}}"
                          Syntax="{Binding DetailOldSyntax}" IsAdded="False" Margin="8,0,16,0" />
          </Grid>
          <Grid Classes="diffline" Classes.add="{Binding IsDetailAdded}" ColumnDefinitions="64,*">
            <TextBlock Classes="lineno" Text="{Binding DetailNewNo}" />
            <ctl:DiffText Grid.Column="1" Line="{Binding DetailNew.Text, FallbackValue={x:Null}}" Segments="{Binding DetailNew.Segments, FallbackValue={x:Null}}"
                          Syntax="{Binding DetailNewSyntax}" IsAdded="True" Margin="8,0,16,0" />
          </Grid>
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</Window>
