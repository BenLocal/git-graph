<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GitGraph.App.ViewModels"
        x:Class="GitGraph.App.Views.InteractiveRebaseWindow"
        x:DataType="vm:InteractiveRebaseViewModel"
        Title="{Binding Title, StringFormat='{}{0} – Interactive rebase – Git Graph'}"
        Icon="/Assets/Icons/gitgraph-256.png"
        Width="1040" Height="700" MinWidth="640" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBrush}">
  <Window.Styles>
    <!-- A dropped commit is struck through; one folded into the commit below it is set in. -->
    <Style Selector="TextBlock.subject.dropped">
      <Setter Property="TextDecorations" Value="Strikethrough" />
      <Setter Property="Opacity" Value="0.5" />
    </Style>
    <Style Selector="Border.handle">
      <Setter Property="Cursor" Value="SizeNorthSouth" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
  </Window.Styles>
  <Grid RowDefinitions="Auto,Auto,*,Auto">
    <Border BorderBrush="{DynamicResource RuleBrush}" BorderThickness="0,0,0,1" Padding="20,12,10,12">
      <StackPanel Spacing="3">
        <TextBlock Classes="title" Text="Interactive rebase" />
        <TextBlock Classes="muted small" Text="{Binding Summary}" TextWrapping="Wrap" />
        <TextBlock Classes="small" Text="{Binding PushedWarning}" TextWrapping="Wrap" Foreground="{DynamicResource SignalBrush}"
                   IsVisible="{Binding PushedWarning, Converter={x:Static ObjectConverters.IsNotNull}}" />
      </StackPanel>
    </Border>

    <TextBlock Grid.Row="1" Classes="muted small" Margin="20,8,20,4" TextWrapping="Wrap"
               Text="Newest at the top, as in the graph. Drag a commit by its handle (or Alt+↑/↓) to reorder; squash and fixup fold a commit into the one below it." />

    <ListBox Grid.Row="2" x:Name="List" Classes="dense pills" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="0,4,0,0">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:RebaseRowViewModel">
          <Grid ColumnDefinitions="28,112,*,76,60" Margin="8,4" MinHeight="32">
            <Border Classes="handle" PointerPressed="OnHandlePressed" PointerMoved="OnHandleMoved" PointerReleased="OnHandleReleased"
                    ToolTip.Tip="Drag to reorder">
              <LucideIcon Kind="GripVertical" Size="16" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
            </Border>
            <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:RebaseRowViewModel.Actions}" SelectedItem="{Binding Action}"
                      ToolTip.Tip="{Binding ActionTip}" VerticalAlignment="Top" MinWidth="104" />
            <StackPanel Grid.Column="2" Margin="12,0,12,0" VerticalAlignment="Center" Spacing="2">
              <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding !IsReword}">
                <LucideIcon Kind="CornerLeftDown" Size="14" Foreground="{DynamicResource MutedBrush}" IsVisible="{Binding IsFolded}" VerticalAlignment="Center"
                            ToolTip.Tip="Folded into the commit below" />
                <TextBlock Classes="subject" Classes.dropped="{Binding IsDropped}" Text="{Binding Subject}" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <TextBox Text="{Binding Message}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" MaxHeight="200"
                       IsVisible="{Binding IsReword}" FontFamily="{StaticResource CodeFont}" />
              <TextBlock Classes="muted small" Text="{Binding Meta}" />
            </StackPanel>
            <TextBlock Grid.Column="3" Classes="mono muted" Text="{Binding ShortHash}" VerticalAlignment="Top" Margin="0,6,0,0" />
            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Top">
              <Button Classes="ghost" Padding="4" Command="{Binding Owner.MoveUpCommand}" CommandParameter="{Binding}" ToolTip.Tip="Move up (newer)">
                <LucideIcon Kind="ArrowUp" Size="14" />
              </Button>
              <Button Classes="ghost" Padding="4" Command="{Binding Owner.MoveDownCommand}" CommandParameter="{Binding}" ToolTip.Tip="Move down (older)">
                <LucideIcon Kind="ArrowDown" Size="14" />
              </Button>
            </StackPanel>
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <Border Grid.Row="3" BorderBrush="{DynamicResource RuleBrush}" BorderThickness="0,1,0,0" Padding="20,10">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Classes="small" Text="{Binding Problem}" TextWrapping="Wrap" VerticalAlignment="Center"
                   Foreground="{DynamicResource DelFgBrush}" Margin="0,0,16,0" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Button Content="Cancel" Command="{Binding CancelCommand}" />
          <Button Classes="primary" Content="Start rebase" Command="{Binding StartCommand}"
                  ToolTip.Tip="Uncommitted changes are stashed first and brought back after. A conflict stops the rebase: resolve it, then continue or abort from the bar above the graph." />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
