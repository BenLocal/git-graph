<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GitGraph.App.ViewModels"
        xmlns:v="using:GitGraph.App.Views"
        xmlns:ctl="using:GitGraph.App.Controls"
        xmlns:svc="using:GitGraph.App.Services"
        x:Class="GitGraph.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Git Graph"
        Icon="/Assets/Icons/gitgraph-256.png"
        Width="1440" Height="900" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource FrameBrush}">


  <Panel>
  <DockPanel>
  <!-- Menu bar, with the layout toggles on the right as in VS Code's title bar. -->
  <Border DockPanel.Dock="Top" Classes="menubar">
    <Grid ColumnDefinitions="*,Auto">
      <Menu>
        <MenuItem Header="_File">
          <MenuItem Header="Add folder to workspace…" Command="{Binding SelectedWorkspace.AddFolderCommand}" InputGesture="{Binding Keys[AddFolder], Source={x:Static svc:ShortcutService.Instance}}" />
          <Separator />
          <MenuItem Header="New workspace…" Command="{Binding NewWorkspaceCommand}" InputGesture="{Binding Keys[NewWorkspace], Source={x:Static svc:ShortcutService.Instance}}" />
          <MenuItem Header="Rename workspace…" Command="{Binding RenameWorkspaceCommand}" />
          <MenuItem Header="Delete workspace" Command="{Binding DeleteWorkspaceCommand}" />
          <Separator />
          <MenuItem Header="Keyboard shortcuts…" Tag="KeyboardShortcuts" Click="OnMenuCommand"
                    ToolTip.Tip="{Binding Tips[KeyboardShortcuts], Source={x:Static svc:ShortcutService.Instance}}" />
          <Separator />
          <MenuItem Header="Quit" Click="OnExit" InputGesture="{Binding Keys[Quit], Source={x:Static svc:ShortcutService.Instance}}" />
        </MenuItem>
        <MenuItem Header="_View">
          <MenuItem Header="Sidebar" ToggleType="CheckBox" IsChecked="{Binding ShowSidebar, Mode=OneWay}"
                    Command="{Binding ToggleSidebarCommand}" InputGesture="{Binding Keys[ToggleSidebar], Source={x:Static svc:ShortcutService.Instance}}" />
          <MenuItem Header="Commit details panel" ToggleType="CheckBox" IsChecked="{Binding ShowDetailsPanel, Mode=OneWay}"
                    Command="{Binding TogglePanelCommand}" InputGesture="{Binding Keys[TogglePanel], Source={x:Static svc:ShortcutService.Instance}}" />
          <MenuItem Header="Maximize or restore panel" Command="{Binding ToggleMaximizePanelCommand}" InputGesture="{Binding Keys[MaximizePanel], Source={x:Static svc:ShortcutService.Instance}}" />
          <MenuItem Header="Switch diff between unified and split" Tag="ToggleDiffLayout" Click="OnMenuCommand" InputGesture="{Binding Keys[ToggleDiffLayout], Source={x:Static svc:ShortcutService.Instance}}" />
          <MenuItem Header="Author avatars">
            <MenuItem Header="Robots and GitHub pictures" ToggleType="Radio" GroupName="avatars" IsChecked="{Binding AvatarRobots, Mode=OneWay}"
                      Command="{Binding SetAvatarStyleCommand}" CommandParameter="Robots"
                      ToolTip.Tip="GitHub's picture for GitHub addresses, otherwise Gravatar, with a robot for people who don't have one" />
            <MenuItem Header="Initials" ToggleType="Radio" GroupName="avatars" IsChecked="{Binding AvatarInitials, Mode=OneWay}"
                      Command="{Binding SetAvatarStyleCommand}" CommandParameter="Initials"
                      ToolTip.Tip="Drawn here from the author's name; nothing is sent to Gravatar or GitHub" />
          </MenuItem>
          <MenuItem Header="Compact folders" ToggleType="CheckBox" IsChecked="{Binding CompactFolders, Mode=OneWay}"
                    Command="{Binding ToggleCompactFoldersCommand}"
                    ToolTip.Tip="Show folders that only contain one folder, like src/main/java/com/example, as a single row" />
          <MenuItem Header="Fetch automatically every 3 minutes" ToggleType="CheckBox" IsChecked="{Binding AutoFetch, Mode=OneWay}"
                    Command="{Binding ToggleAutoFetchCommand}" />
          <Separator />
          <MenuItem Header="{Binding ThemeLabel, StringFormat='Theme: {0}'}" Command="{Binding CycleThemeCommand}" InputGesture="{Binding Keys[CycleTheme], Source={x:Static svc:ShortcutService.Instance}}" />
        </MenuItem>
        <MenuItem Header="_Repository">
          <MenuItem Header="Find commits" Tag="Find" Click="OnMenuCommand" InputGesture="{Binding Keys[Find], Source={x:Static svc:ShortcutService.Instance}}" />
          <MenuItem Header="Next match" Tag="FindNext" Click="OnMenuCommand" InputGesture="{Binding Keys[FindNext], Source={x:Static svc:ShortcutService.Instance}}" />
          <MenuItem Header="Previous match" Tag="FindPrevious" Click="OnMenuCommand" InputGesture="{Binding Keys[FindPrevious], Source={x:Static svc:ShortcutService.Instance}}" />
          <Separator />
          <MenuItem Header="Refresh" Command="{Binding SelectedWorkspace.SelectedRepoTab.RefreshCommand}" InputGesture="{Binding Keys[Refresh], Source={x:Static svc:ShortcutService.Instance}}" />
          <MenuItem Header="Fetch from all remotes" Command="{Binding SelectedWorkspace.SelectedRepoTab.FetchCommand}" InputGesture="{Binding Keys[Fetch], Source={x:Static svc:ShortcutService.Instance}}" />
          <MenuItem Header="Pull" Command="{Binding SelectedWorkspace.SelectedRepoTab.PullCommand}" InputGesture="{Binding Keys[Pull], Source={x:Static svc:ShortcutService.Instance}}" />
          <MenuItem Header="Push" Command="{Binding SelectedWorkspace.SelectedRepoTab.PushCommand}" InputGesture="{Binding Keys[Push], Source={x:Static svc:ShortcutService.Instance}}" />
          <MenuItem Header="Sync (pull, then push)…" Command="{Binding SelectedWorkspace.SelectedRepoTab.SyncNowCommand}" InputGesture="{Binding Keys[Sync], Source={x:Static svc:ShortcutService.Instance}}" />
          <Separator />
          <MenuItem Header="Show remote branches" ToggleType="CheckBox"
                    IsChecked="{Binding SelectedWorkspace.SelectedRepoTab.ShowRemotes, FallbackValue=False}" />
        </MenuItem>
        <MenuItem Header="_Tabs">
          <MenuItem Header="Next tab" Tag="NextTab" Click="OnMenuCommand" InputGesture="{Binding Keys[NextTab], Source={x:Static svc:ShortcutService.Instance}}" />
          <MenuItem Header="Previous tab" Tag="PreviousTab" Click="OnMenuCommand" InputGesture="{Binding Keys[PreviousTab], Source={x:Static svc:ShortcutService.Instance}}" />
          <MenuItem Header="Keep preview tab open" Tag="KeepTabOpen" Click="OnMenuCommand"
                    ToolTip.Tip="{Binding Tips[KeepTabOpen], Source={x:Static svc:ShortcutService.Instance}}" />
          <Separator />
          <MenuItem Header="Close tab" Tag="CloseTab" Click="OnMenuCommand" InputGesture="{Binding Keys[CloseTab], Source={x:Static svc:ShortcutService.Instance}}" />
          <MenuItem Header="Close all tabs" Tag="CloseAllTabs" Click="OnMenuCommand"
                    ToolTip.Tip="{Binding Tips[CloseAllTabs], Source={x:Static svc:ShortcutService.Instance}}" />
        </MenuItem>
      </Menu>

      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" Margin="0,0,8,0" VerticalAlignment="Center">
        <ToggleButton Classes="ghost bar" IsChecked="{Binding ShowSidebar, Mode=OneWay}" Command="{Binding ToggleSidebarCommand}"
                      ToolTip.Tip="{Binding Tips[ToggleSidebar], Source={x:Static svc:ShortcutService.Instance}}">
          <ctl:IconView Data="{StaticResource I.Sidebar}" Width="15" Height="15" />
        </ToggleButton>
        <ToggleButton Classes="ghost bar" IsChecked="{Binding ShowDetailsPanel, Mode=OneWay}" Command="{Binding TogglePanelCommand}"
                      ToolTip.Tip="{Binding Tips[TogglePanel], Source={x:Static svc:ShortcutService.Instance}}">
          <ctl:IconView Data="{StaticResource I.Panel}" Width="15" Height="15" />
        </ToggleButton>
      </StackPanel>
    </Grid>
  </Border>

  <Grid ColumnDefinitions="Auto,Auto,*">
    <!-- The sidebar hides on request, but never while no repository is open. -->
    <Panel Grid.Column="0" Grid.ColumnSpan="2">
      <Panel.IsVisible>
        <MultiBinding Converter="{x:Static BoolConverters.Or}">
          <Binding Path="ShowSidebar" />
          <Binding Path="SelectedWorkspace.HasTabs" Converter="{x:Static BoolConverters.Not}" />
        </MultiBinding>
      </Panel.IsVisible>
      <v:SidebarView Width="256" />
    </Panel>

    <Grid Grid.Column="2" RowDefinitions="Auto,*" DataContext="{Binding SelectedWorkspace}" x:DataType="vm:WorkspaceViewModel">
      <!-- Open repositories in this workspace: tabs on the frame, the selected one merging into the sheet below. -->
      <Panel Grid.Row="0" MinHeight="8">
        <!-- Too many tabs scroll sideways without a scrollbar: wheel over the strip, or select one to bring it into view. -->
        <ListBox x:Name="TabStrip" Classes="tabs" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}" IsVisible="{Binding HasTabs}" Margin="18,4,8,0"
                 ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Disabled">
          <!-- Tabs running past the edge fade out instead of being cut off. -->
          <ListBox.OpacityMask>
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
              <GradientStop Offset="0.96" Color="Black" />
              <GradientStop Offset="1" Color="Transparent" />
            </LinearGradientBrush>
          </ListBox.OpacityMask>
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:TabViewModel">
              <Grid RowDefinitions="2,*" ToolTip.Tip="{Binding Path}" Background="Transparent" DoubleTapped="OnTabDoubleTapped">
                <Grid.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="Keep open" Command="{Binding Workspace.PinTabCommand}" CommandParameter="{Binding}" IsVisible="{Binding IsPreview}" />
                    <MenuItem Header="Close" Command="{Binding Workspace.CloseTabCommand}" CommandParameter="{Binding}" />
                    <MenuItem Header="Close tabs to the right" Command="{Binding Workspace.CloseTabsToRightCommand}" CommandParameter="{Binding}" />
                    <MenuItem Header="Close all" Command="{Binding Workspace.CloseAllTabsCommand}" />
                  </ContextMenu>
                </Grid.ContextMenu>
                <Border Grid.Row="0" Classes="tabline" />
                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="7" Margin="14,0,6,0" Height="34">
                  <ctl:IconView Data="{StaticResource I.Worktree}" Width="13" Height="13" IsVisible="{Binding IsWorktree}" VerticalAlignment="Center" />
                  <ctl:IconView Data="{StaticResource I.Folder}" Width="13" Height="13" IsVisible="{Binding IsFolder}" VerticalAlignment="Center" />
                  <TextBlock Classes="name" Classes.preview="{Binding IsPreview}" Text="{Binding Title}" VerticalAlignment="Center" MaxWidth="180" TextTrimming="CharacterEllipsis" />
                  <TextBlock Classes="muted small" Text="{Binding Subtitle}" VerticalAlignment="Center" MaxWidth="160" TextTrimming="CharacterEllipsis" />
                  <Button Classes="ghost close" Padding="3" Margin="2,0,0,0"
                          Command="{Binding $parent[ListBox].((vm:WorkspaceViewModel)DataContext).CloseTabCommand}"
                          CommandParameter="{Binding}" ToolTip.Tip="{Binding Tips[CloseTab], Source={x:Static svc:ShortcutService.Instance}}">
                    <ctl:IconView Data="{StaticResource I.Close}" Width="12" Height="12" />
                  </Button>
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Panel>

      <!-- The sheet: everything about the open repository -->
      <Border Grid.Row="1" Classes="sheet">
      <Grid RowDefinitions="Auto,*">

      <!-- Git errors surface here, in place, until dismissed -->
      <Border Grid.Row="0" Background="{DynamicResource DelBgBrush}" Padding="14,8"
              DataContext="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext)}" x:DataType="vm:MainWindowViewModel"
              IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
        <Grid ColumnDefinitions="*,Auto">
          <SelectableTextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" MaxHeight="120" />
          <Button Grid.Column="1" Classes="ghost" Command="{Binding DismissErrorCommand}" ToolTip.Tip="Dismiss" VerticalAlignment="Top">
            <ctl:IconView Data="{StaticResource I.Close}" Width="14" Height="14" />
          </Button>
        </Grid>
      </Border>

      <v:RepoTabView Grid.Row="1" DataContext="{Binding SelectedRepoTab}"
                     IsVisible="{Binding $parent[Grid].((vm:WorkspaceViewModel)DataContext).SelectedRepoTab, Converter={x:Static ObjectConverters.IsNotNull}}" />
      <v:FolderTabView Grid.Row="1" DataContext="{Binding SelectedFolderTab}"
                       IsVisible="{Binding $parent[Grid].((vm:WorkspaceViewModel)DataContext).SelectedFolderTab, Converter={x:Static ObjectConverters.IsNotNull}}" />

      <!-- Nothing open yet -->
      <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14" MaxWidth="420"
                  IsVisible="{Binding !HasTabs}">
        <ctl:IconView Data="{StaticResource I.Repo}" Width="40" Height="40" HorizontalAlignment="Center" StrokeThickness="1.4" />
        <TextBlock Classes="title" HorizontalAlignment="Center" TextAlignment="Center"
                   Text="{Binding Name, StringFormat='{}{0} has nothing open'}" />
        <TextBlock Classes="muted" TextAlignment="Center" TextWrapping="Wrap" IsVisible="{Binding HasFolders}"
                   Text="Pick a repository or worktree on the left to see its history." />
        <TextBlock Classes="muted" TextAlignment="Center" TextWrapping="Wrap" IsVisible="{Binding !HasFolders}"
                   Text="Add a folder to this workspace. Every repository inside it, and each of its worktrees, shows up in the sidebar." />
        <Button Classes="primary" HorizontalAlignment="Center" Command="{Binding AddFolderCommand}" IsVisible="{Binding !HasFolders}"
                Content="Add folder" />
      </StackPanel>
      </Grid>
      </Border>
    </Grid>
  </Grid>
  </DockPanel>

  <!-- While a two-key shortcut (Ctrl+K …) waits for its second key -->
  <Border x:Name="ChordHintBorder" Classes="toast" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24"
          IsHitTestVisible="False">
    <TextBlock x:Name="ChordHint" Classes="small" />
  </Border>
  </Panel>
</Window>
