<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GitGraph.App.ViewModels"
        xmlns:ctl="using:GitGraph.App.Controls"
        x:Class="GitGraph.App.Views.KeyboardShortcutsWindow"
        x:DataType="vm:ShortcutsEditorViewModel"
        Title="Keyboard shortcuts"
        Icon="/Assets/Icons/gitgraph-256.png"
        Width="760" Height="620" MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource CanvasBrush}">
  <Grid RowDefinitions="Auto,Auto,*">
    <Border Padding="20,16,20,10">
      <StackPanel Spacing="4">
        <TextBlock Classes="title" Text="Keyboard shortcuts" />
        <TextBlock Classes="muted small" TextWrapping="Wrap"
                   Text="Double-click a command, or use its pencil, to record a new shortcut. Defaults follow VS Code where it has the same command." />
      </StackPanel>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="20,0,20,10">
      <TextBox Text="{Binding Filter}" PlaceholderText="Search by command or keys" />
      <Button Grid.Column="1" Classes="ghost text" Margin="8,0,0,0" Command="{Binding ResetAllCommand}" Content="Reset all" />
    </Grid>

    <ListBox x:Name="List" Grid.Row="2" Classes="dense pills" ItemsSource="{Binding Rows}" Margin="0,0,0,12"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:ShortcutRowViewModel">
          <Grid ColumnDefinitions="90,*,180,Auto" Height="34" Margin="14,0,8,0" Background="Transparent">
            <TextBlock Classes="muted small" Text="{Binding Category}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Text="{Binding Title}" Classes.changed="{Binding IsChanged}" />
              <TextBlock Classes="small" Foreground="{DynamicResource DangerBrush}" Text="{Binding Conflict}" IsVisible="{Binding HasConflict}" />
            </StackPanel>
            <Border Grid.Column="2" Classes="keycap" IsVisible="{Binding HasShortcut}" HorizontalAlignment="Left" VerticalAlignment="Center"
                    ToolTip.Tip="{Binding DefaultLabel}">
              <TextBlock Text="{Binding Label}" />
            </Border>
            <TextBlock Grid.Column="2" Classes="muted small" Text="Not assigned" IsVisible="{Binding !HasShortcut}" VerticalAlignment="Center"
                       HorizontalAlignment="Left" Margin="8,0,0,0" />
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
              <Button Classes="ghost" Padding="5" Click="OnChange" ToolTip.Tip="Record a new shortcut">
                <LucideIcon Kind="Pencil" Size="13" />
              </Button>
              <Button Classes="ghost" Padding="5" Command="{Binding $parent[Window].((vm:ShortcutsEditorViewModel)DataContext).ResetCommand}"
                      CommandParameter="{Binding}" IsVisible="{Binding IsChanged}" ToolTip.Tip="Back to the default">
                <LucideIcon Kind="RotateCw" Size="13" />
              </Button>
              <Button Classes="ghost" Padding="5" Command="{Binding $parent[Window].((vm:ShortcutsEditorViewModel)DataContext).RemoveCommand}"
                      CommandParameter="{Binding}" IsVisible="{Binding HasShortcut}" ToolTip.Tip="Remove the shortcut">
                <LucideIcon Kind="X" Size="13" />
              </Button>
            </StackPanel>
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </Grid>
</Window>
