<shadui:Window xmlns="https://github.com/avaloniaui"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI"
               xmlns:vm="using:GitGraph.App.ViewModels"
               xmlns:v="using:GitGraph.App.Views"
               x:Class="GitGraph.App.Views.FolderWindow"
               x:DataType="vm:FolderTabViewModel"
               Title="{Binding Title, StringFormat='{}{0} – Files – Git Graph'}"
               Icon="/Assets/Icons/gitgraph-256.png"
               Width="1280" Height="800" MinWidth="640" MinHeight="400"
               IsTitleBarVisible="True" TitleFontSize="13"
               ShowBottomBorder="True" SaveWindowState="False" EnableTrafficLightPositioning="True" TrafficLightOffset="6,6"
               WindowStartupLocation="CenterOwner"
               Background="{DynamicResource SurfaceBrush}">
  <shadui:Window.LogoContent>
    <Image Source="/Assets/Icons/gitgraph-128.png" Width="16" Height="16" Margin="4,0,2,0" />
  </shadui:Window.LogoContent>
  <!-- The same view as a folder tab, with the tab's terminal underneath. -->
  <Grid RowDefinitions="*,Auto">
    <v:FolderTabView x:Name="Folder" />
    <v:TerminalPanelView Grid.Row="1" DataContext="{Binding Terminal}" />
  </Grid>
</shadui:Window>
