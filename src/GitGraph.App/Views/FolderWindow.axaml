<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GitGraph.App.ViewModels"
        xmlns:v="using:GitGraph.App.Views"
        x:Class="GitGraph.App.Views.FolderWindow"
        x:DataType="vm:FolderTabViewModel"
        Title="{Binding Title, StringFormat='{}{0} – Files – Git Graph'}"
        Icon="/Assets/Icons/gitgraph-256.png"
        Width="1280" Height="800" MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBrush}">
  <!-- The same view as a folder tab, with the tab's terminal underneath. -->
  <Grid RowDefinitions="*,Auto">
    <v:FolderTabView x:Name="Folder" />
    <v:TerminalPanelView Grid.Row="1" DataContext="{Binding Terminal}" />
  </Grid>
</Window>
