<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="GitGraph.App.Views.AboutWindow"
        Title="About Git Graph"
        Icon="/Assets/Icons/gitgraph-256.png"
        Width="420" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <StackPanel Margin="28,24,28,22" Spacing="16">
    <StackPanel Orientation="Horizontal" Spacing="16">
      <Image Source="/Assets/Icons/gitgraph-128.png" Width="56" Height="56" />
      <StackPanel VerticalAlignment="Center" Spacing="2">
        <TextBlock Text="Git Graph" FontSize="20" FontWeight="SemiBold" />
        <SelectableTextBlock x:Name="VersionText" Classes="mono" FontSize="13" />
      </StackPanel>
    </StackPanel>

    <TextBlock Classes="muted" TextWrapping="Wrap"
               Text="Git history, worktrees and diffs across several workspaces, in the spirit of VS Code's Git Graph." />

    <!-- Build and platform, for bug reports -->
    <Grid x:Name="Details" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="4" ColumnSpacing="14">
      <TextBlock Classes="muted small" Text="Commit" VerticalAlignment="Center" />
      <SelectableTextBlock x:Name="CommitText" Grid.Column="1" Classes="mono" />
      <TextBlock Grid.Row="1" Classes="muted small" Text=".NET" VerticalAlignment="Center" />
      <SelectableTextBlock x:Name="RuntimeText" Grid.Row="1" Grid.Column="1" />
      <TextBlock Grid.Row="2" Classes="muted small" Text="Avalonia" VerticalAlignment="Center" />
      <SelectableTextBlock x:Name="AvaloniaText" Grid.Row="2" Grid.Column="1" />
      <TextBlock Grid.Row="3" Classes="muted small" Text="System" VerticalAlignment="Center" />
      <SelectableTextBlock x:Name="OsText" Grid.Row="3" Grid.Column="1" TextWrapping="Wrap" />
    </Grid>

    <!-- Asks GitHub only when clicked -->
    <StackPanel Spacing="6">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button x:Name="CheckButton" Classes="secondary" Click="OnCheckForUpdates">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <LucideIcon Kind="RefreshCw" Size="14" VerticalAlignment="Center" />
            <TextBlock Text="Check for updates" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button x:Name="DownloadButton" Classes="primary" Click="OnDownload" IsVisible="False">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <LucideIcon Kind="Download" Size="14" Foreground="{Binding $parent[Button].Foreground}" VerticalAlignment="Center" />
            <TextBlock Text="Release page" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </StackPanel>
      <TextBlock x:Name="UpdateText" Classes="muted small" TextWrapping="Wrap" IsVisible="False" />
    </StackPanel>

    <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,6,0,0">
      <Button Classes="ghost text" Click="OnOpenRepository" ToolTip.Tip="Open the project page in the browser">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <LucideIcon Kind="ExternalLink" Size="14" VerticalAlignment="Center" />
          <TextBlock Text="Project page" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <Button Grid.Column="2" Classes="secondary" Click="OnCopy" Margin="0,0,8,0">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <LucideIcon x:Name="CopyIcon" Kind="Copy" Size="14" VerticalAlignment="Center" />
          <TextBlock Text="Copy version info" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <Button Grid.Column="3" Classes="primary" Click="OnClose" Content="Close" IsDefault="True" />
    </Grid>
  </StackPanel>
</Window>
