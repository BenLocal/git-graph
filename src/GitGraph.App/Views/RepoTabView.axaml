<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GitGraph.App.ViewModels"
             xmlns:v="using:GitGraph.App.Views"
             xmlns:ctl="using:GitGraph.App.Controls"
             xmlns:svc="using:GitGraph.App.Services"
             x:Class="GitGraph.App.Views.RepoTabView"
             x:DataType="vm:RepoTabViewModel">
  <UserControl.Resources>
    <!-- One menu for every row, and one for every ref label: a flyout is built when it opens and takes the row it
         opened on as its data. A ContextMenu in the row template was built (and styled) for each row as the list
         scrolled, which made scrolling stutter. -->
    <MenuFlyout x:Key="CommitMenu" x:DataType="vm:CommitRowViewModel">
      <MenuItem Header="Stash changes…" Command="{Binding StashChangesCommand}" IsVisible="{Binding IsUncommitted}" />
      <MenuItem Header="Apply stash" Command="{Binding ApplyStashCommand}" IsVisible="{Binding IsStash}"
                ToolTip.Tip="Apply the changes and keep the stash" />
      <MenuItem Header="Pop stash" Command="{Binding PopStashCommand}" IsVisible="{Binding IsStash}"
                ToolTip.Tip="Apply the changes, then drop the stash if they applied cleanly" />
      <MenuItem Header="Create branch from stash…" Command="{Binding StashBranchCommand}" IsVisible="{Binding IsStash}" />
      <MenuItem Header="Drop stash…" Command="{Binding DropStashCommand}" IsVisible="{Binding IsStash}" />
      <MenuItem Header="Copy stash name" Command="{Binding CopyStashNameCommand}" IsVisible="{Binding IsStash}" />
      <Separator IsVisible="{Binding !IsCommit}" />
      <MenuItem Header="Compare with selected commit" Command="{Binding CompareWithSelectedCommand}"
                ToolTip.Tip="Or Ctrl+click a second commit" />
      <Separator IsVisible="{Binding !IsStash}" />
      <MenuItem Header="Add worktree here…" Command="{Binding AddWorktreeCommand}" IsVisible="{Binding !IsStash}" />
      <MenuItem Header="Create branch here…" Command="{Binding CreateBranchCommand}" IsVisible="{Binding IsCommit}" />
      <MenuItem Header="Create tag here…" Command="{Binding CreateTagCommand}" IsVisible="{Binding IsCommit}" />
      <MenuItem Header="Check out this commit…" Command="{Binding CheckoutCommand}" IsVisible="{Binding IsCommit}" />
      <Separator IsVisible="{Binding CanApply}" />
      <MenuItem Header="Merge into current branch…" Command="{Binding MergeCommand}" IsVisible="{Binding CanApply}" />
      <MenuItem Header="Cherry-pick onto current branch…" Command="{Binding CherryPickCommand}" IsVisible="{Binding CanApply}" />
      <MenuItem Header="Rebase current branch onto this commit…" Command="{Binding RebaseCommand}" IsVisible="{Binding CanApply}" />
      <MenuItem Header="Interactive rebase from here…" Command="{Binding InteractiveRebaseCommand}" IsVisible="{Binding CanApply}"
                ToolTip.Tip="Reorder, reword, squash, fix up or drop the commits after this one" />
      <MenuItem Header="Fold staged changes into this commit…" Command="{Binding FoldStagedIntoCommand}" IsVisible="{Binding IsCommit}"
                ToolTip.Tip="Add what is staged to this earlier commit, as if it had been there all along (a fixup and an autosquash rebase)" />
      <Separator IsVisible="{Binding IsCommit}" />
      <MenuItem Header="Revert this commit…" Command="{Binding RevertCommand}" IsVisible="{Binding IsCommit}"
                ToolTip.Tip="Undo its changes with a new commit" />
      <MenuItem Header="Reset current branch to here" IsVisible="{Binding CanApply}">
        <MenuItem Header="Soft: keep the changes staged…" Command="{Binding ResetCommand}" CommandParameter="Soft" />
        <MenuItem Header="Mixed: keep the changes unstaged…" Command="{Binding ResetCommand}" CommandParameter="Mixed" />
        <MenuItem Header="Hard: discard the changes…" Command="{Binding ResetCommand}" CommandParameter="Hard" />
      </MenuItem>
      <Separator IsVisible="{Binding IsCommit}" />
      <MenuItem Header="Copy commit hash" Command="{Binding CopyHashCommand}" IsVisible="{Binding IsCommit}" />
      <MenuItem Header="Copy subject" Command="{Binding CopySubjectCommand}" IsVisible="{Binding IsCommit}" />
      <MenuItem Header="Custom commands" ItemsSource="{Binding CustomCommands}" ItemContainerTheme="{StaticResource CustomCommandItem}"
                IsVisible="{Binding CustomCommands, Converter={x:Static vm:Converters.HasItems}}" />
    </MenuFlyout>
    <MenuFlyout x:Key="RefMenu" x:DataType="vm:RefBadgeViewModel">
      <MenuItem Header="Check out" Command="{Binding CheckoutCommand}" IsVisible="{Binding IsBranch}" />
      <MenuItem Header="Highlight its commits" Command="{Binding HighlightCommand}" IsVisible="{Binding CanHighlight}"
                ToolTip.Tip="Fade every commit that doesn't lead here, to follow this line through the graph (Esc to stop)" />
      <MenuItem Header="Merge into current branch…" Command="{Binding MergeCommand}" IsVisible="{Binding CanMerge}" />
      <MenuItem Header="Rebase current branch onto this…" Command="{Binding RebaseCommand}" IsVisible="{Binding CanMerge}" />
      <MenuItem Header="Add worktree for this branch…" Command="{Binding AddWorktreeCommand}" IsVisible="{Binding IsBranch}" />
      <MenuItem Header="Open worktree" Command="{Binding OpenWorktreeCommand}" IsVisible="{Binding IsWorktree}" />
      <MenuItem Header="Rename…" Command="{Binding RenameCommand}" IsVisible="{Binding IsLocal}" />
      <MenuItem Header="Set upstream…" Command="{Binding SetUpstreamCommand}" IsVisible="{Binding IsLocal}" />
      <MenuItem Header="Push to remote…" Command="{Binding PushTagCommand}" IsVisible="{Binding IsTag}" />
      <MenuItem Header="Copy name" Command="{Binding CopyNameCommand}" />
      <Separator IsVisible="{Binding HasDeleteItem}" />
      <MenuItem Header="Delete…" Command="{Binding DeleteCommand}" IsVisible="{Binding CanDelete}" />
      <MenuItem Header="Delete from remote…" Command="{Binding DeleteRemoteCommand}" IsVisible="{Binding IsRemote}" />
      <MenuItem Header="Custom commands" ItemsSource="{Binding CustomCommands}" ItemContainerTheme="{StaticResource CustomCommandItem}"
                IsVisible="{Binding CustomCommands, Converter={x:Static vm:Converters.HasItems}}" />
    </MenuFlyout>
  </UserControl.Resources>
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding ClearMarksCommand}" />
  </UserControl.KeyBindings>

  <!-- Rows 1–4 are resized from code-behind when the details panel is hidden or maximized. -->
  <Grid x:Name="Layout" RowDefinitions="Auto,Auto,*,Auto,320">
    <StackPanel Grid.Row="0">
      <!-- Toolbar -->
      <Grid ColumnDefinitions="Auto,*,Auto" Margin="16,10,12,8">
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <TextBlock Classes="title" Text="{Binding Title}" VerticalAlignment="Center" MaxWidth="260" TextTrimming="CharacterEllipsis"
                     ToolTip.Tip="{Binding Path}" />
          <Border Background="{DynamicResource RaisedBrush}" CornerRadius="4" Padding="7,2" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <LucideIcon Kind="FolderTree" Size="12" IsVisible="{Binding IsWorktree}"
                            VerticalAlignment="Center" ToolTip.Tip="This is a linked worktree" />
              <TextBlock Classes="small" Text="{Binding BranchLabel}" VerticalAlignment="Center" />
            </StackPanel>
          </Border>
          <!-- Pull/push state: counts to pull and push, a plain sync icon when up to date, or Publish for a new branch. -->
          <Button Classes="ghost syncbutton" Command="{Binding SyncNowCommand}" IsVisible="{Binding ShowSync}" ToolTip.Tip="{Binding SyncTooltip}"
                  Padding="6,3" Margin="-6,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <LucideIcon Kind="ArrowDownUp" Size="14" Classes="sync" Classes.spinning="{Binding IsSyncing}"
                            VerticalAlignment="Center" IsVisible="{Binding !CanPublish}">
                <LucideIcon.RenderTransform>
                  <RotateTransform />
                </LucideIcon.RenderTransform>
              </LucideIcon>
              <LucideIcon Kind="CloudUpload" Size="14" VerticalAlignment="Center" IsVisible="{Binding CanPublish}" />
              <LucideIcon Kind="CloudAlert" Size="14" VerticalAlignment="Center"
                          IsVisible="{Binding FetchError, Converter={x:Static ObjectConverters.IsNotNull}}" />
              <TextBlock Classes="sync small" Text="{Binding SyncCounts}" VerticalAlignment="Center" IsVisible="{Binding !IsInSync}" />
              <TextBlock Classes="small" Text="Publish branch" VerticalAlignment="Center" IsVisible="{Binding CanPublish}" />
            </StackPanel>
          </Button>
          <Button Classes="ghost" Padding="5" Command="{Binding GoToHeadCommand}" Margin="-4,0,0,0"
                  ToolTip.Tip="{Binding Tips[GoToHead], Source={x:Static svc:ShortcutService.Instance}, StringFormat='{}{0}: select the checked-out commit'}">
            <LucideIcon Kind="LocateFixed" Size="15" />
          </Button>
          <TextBlock Classes="muted small" Text="Loading…" VerticalAlignment="Center" IsVisible="{Binding IsLoading}" />
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
          <ComboBox ItemsSource="{Binding BranchOptions}" SelectedItem="{Binding SelectedBranch}" MinWidth="170" MaxWidth="260"
                    VerticalAlignment="Center" ToolTip.Tip="Show one branch, or all of them">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:BranchOption">
                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <CheckBox Content="Remotes" IsChecked="{Binding ShowRemotes}" VerticalAlignment="Center" Margin="4,0"
                    ToolTip.Tip="Include remote-tracking branches in the graph" />

          <Panel Width="230" VerticalAlignment="Center">
            <TextBox x:Name="FindBox" Classes="find" Text="{Binding FindText}" PlaceholderText="{Binding Labels[Find], Source={x:Static svc:ShortcutService.Instance}, StringFormat='Find commits  {0}'}"
                     ToolTip.Tip="Message, author, hash or branch. Enter for next, Shift+Enter for previous. To filter, type author:name, path:src/, code:text (added or removed), since:week|month|3m|year, quoting values with spaces, then Enter.">
              <TextBox.KeyBindings>
                <KeyBinding Gesture="Enter" Command="{Binding FindEnterCommand}" />
                <KeyBinding Gesture="Shift+Enter" Command="{Binding FindPreviousCommand}" />
              </TextBox.KeyBindings>
              <TextBox.InnerRightContent>
                <TextBlock Classes="muted small" Text="{Binding FindStatus}" VerticalAlignment="Center" Margin="0,0,8,0" />
              </TextBox.InnerRightContent>
            </TextBox>
            <LucideIcon Kind="Search" Size="14" HorizontalAlignment="Left" Margin="9,0,0,0" IsHitTestVisible="False" />
          </Panel>
          <Button Classes="ghost" Command="{Binding FindPreviousCommand}" ToolTip.Tip="{Binding Tips[FindPrevious], Source={x:Static svc:ShortcutService.Instance}, StringFormat='{}{0}. Shift+Enter in the find box'}">
            <LucideIcon Kind="ChevronUp" />
          </Button>
          <Button Classes="ghost" Command="{Binding FindNextCommand}" ToolTip.Tip="{Binding Tips[FindNext], Source={x:Static svc:ShortcutService.Instance}, StringFormat='{}{0}. Enter in the find box'}">
            <LucideIcon Kind="ChevronDown" />
          </Button>

          <ToggleButton Classes="ghost" IsChecked="{Binding ShowFilters, Mode=OneWay}" Command="{Binding ToggleFiltersCommand}"
                        ToolTip.Tip="Filter commits by author, date or path">
            <Panel>
              <LucideIcon Kind="ListFilter" />
              <!-- A dot while filters narrow the list -->
              <Ellipse Width="6" Height="6" Fill="{DynamicResource SignalBrush}" HorizontalAlignment="Right" VerticalAlignment="Top"
                       Margin="0,-2,-3,0" IsVisible="{Binding IsFiltered}" />
            </Panel>
          </ToggleButton>

          <Border Width="1" Background="{DynamicResource RuleBrush}" Margin="4,6" />
          <Button Classes="ghost" Command="{Binding BrowseFilesCommand}" ToolTip.Tip="Browse files in a folder tab">
            <LucideIcon Kind="FolderOpen" />
          </Button>
          <ToggleButton Classes="ghost" IsChecked="{Binding ShowStats, Mode=OneWay}" Command="{Binding ToggleStatsCommand}"
                        ToolTip.Tip="{Binding Tips[ToggleContributors], Source={x:Static svc:ShortcutService.Instance}}">
            <LucideIcon Kind="ChartColumn" />
          </ToggleButton>
          <Button Classes="ghost" Command="{Binding FetchCommand}" ToolTip.Tip="{Binding Tips[Fetch], Source={x:Static svc:ShortcutService.Instance}}">
            <LucideIcon Kind="CloudDownload" />
          </Button>
          <Button Classes="ghost" Command="{Binding RefreshCommand}" ToolTip.Tip="{Binding Tips[Refresh], Source={x:Static svc:ShortcutService.Instance}}">
            <LucideIcon Kind="RotateCw" />
          </Button>
        </StackPanel>
      </Grid>

      <!-- Filters: only commits by an author, in a period, touching a path, or adding or removing some code -->
      <StackPanel Orientation="Horizontal" Spacing="8" Margin="16,0,12,10" IsVisible="{Binding ShowFilters}">
        <Panel Width="220">
          <TextBox Classes="find" Text="{Binding AuthorFilter}" PlaceholderText="Author name or email" />
          <LucideIcon Kind="User" Size="14" HorizontalAlignment="Left" Margin="9,0,0,0" IsHitTestVisible="False" />
        </Panel>
        <Panel Width="260">
          <TextBox Classes="find" Text="{Binding PathFilter}" PlaceholderText="File or folder, e.g. src/"
                   ToolTip.Tip="Only commits that changed this path, relative to the repository's top folder" />
          <LucideIcon Kind="FileSearch" Size="14" HorizontalAlignment="Left" Margin="9,0,0,0" IsHitTestVisible="False" />
        </Panel>
        <Panel Width="260">
          <TextBox Classes="find" Text="{Binding CodeFilter}" PlaceholderText="Code added or removed"
                   ToolTip.Tip="Only commits that added or removed this text, matched as written (git log -S). Searching every commit can take a few seconds in a large repository." />
          <LucideIcon Kind="Code" Size="14" HorizontalAlignment="Left" Margin="9,0,0,0" IsHitTestVisible="False" />
        </Panel>
        <ComboBox ItemsSource="{x:Static vm:RepoTabViewModel.SinceOptions}" SelectedItem="{Binding SinceFilter}" MinWidth="140" />
        <TextBlock Classes="muted small" VerticalAlignment="Center" Text="{Binding Rows.Count, StringFormat='{}{0} rows'}"
                   IsVisible="{Binding IsFiltered}" />
      </StackPanel>

      <!-- A highlighted branch: its commits stand out, the others fade -->
      <Border Background="{DynamicResource HoverWashBrush}" Padding="16,6,12,6" IsVisible="{Binding IsHighlighting}">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <LucideIcon Kind="Highlighter" Size="14" Foreground="{DynamicResource SignalBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
          <TextBlock Grid.Column="1" Classes="small" Text="{Binding HighlightText}" TextWrapping="Wrap" VerticalAlignment="Center" />
          <Button Grid.Column="2" Classes="ghost text" Command="{Binding ClearHighlightCommand}" Content="Clear" ToolTip.Tip="Stop highlighting (Esc)" />
        </Grid>
      </Border>

      <!-- A merge, cherry-pick, revert or rebase stopped part-way: continue it or abort it -->
      <Border Background="{DynamicResource SignalWashBrush}" Padding="16,8,12,8" IsVisible="{Binding HasOperation}">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <LucideIcon Kind="GitMerge" Size="15" Foreground="{DynamicResource SignalBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
          <TextBlock Grid.Column="1" Text="{Binding OperationText}" TextWrapping="Wrap" VerticalAlignment="Center" />
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="12,0,0,0" VerticalAlignment="Center">
            <Button Classes="ghost text" Command="{Binding ShowConflictsCommand}" Content="Show changes" />
            <Button Classes="ghost text" Command="{Binding AbortOperationCommand}" Content="Abort" />
            <Button Classes="primary" Command="{Binding ContinueOperationCommand}" Content="Continue"
                    ToolTip.Tip="Go on once every conflict is resolved and staged" />
          </StackPanel>
        </Grid>
      </Border>
    </StackPanel>

    <!-- Column headings -->
    <!-- Like the header of a GitHub box: a tinted band over the list -->
    <Border x:Name="Headings" Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource RuleBrush}" BorderThickness="0,1,0,1">
      <!-- Inset like the rows' selection pills so the columns line up. -->
      <Grid ColumnDefinitions="Auto,*,140,150,84" Height="26" Margin="6,0">
        <TextBlock Classes="section" Width="{Binding GraphWidth}" Padding="10,0,0,0" Text="Graph" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Classes="section" Margin="4,0" Text="Description" VerticalAlignment="Center" />
        <TextBlock Grid.Column="2" Classes="section" Text="Date" VerticalAlignment="Center" />
        <TextBlock Grid.Column="3" Classes="section" Text="Author" VerticalAlignment="Center" />
        <TextBlock Grid.Column="4" Classes="section" Text="Commit" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <!-- The graph -->
    <Panel x:Name="Graph" Grid.Row="2">
      <ListBox x:Name="CommitList" Classes="dense pills" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:CommitRowViewModel">
            <Grid Classes="commit" Classes.uncommitted="{Binding IsUncommitted}" Classes.stash="{Binding IsStash}" Classes.match="{Binding IsMatch}"
                  Classes.compare="{Binding IsCompareTarget}" Classes.dimmed="{Binding IsDimmed}"
                  ColumnDefinitions="Auto,*,140,150,84" Height="{DynamicResource RowHeight}" ContextFlyout="{StaticResource CommitMenu}">

              <ctl:GraphCell Row="{Binding Graph}" IsHead="{Binding IsHead}"
                             Width="{Binding $parent[ListBox].((vm:RepoTabViewModel)DataContext).GraphWidth}" />

              <DockPanel Grid.Column="1" Margin="4,0,12,0">
                <ItemsControl DockPanel.Dock="Left" ItemsSource="{Binding Badges}" IsVisible="{Binding HasBadges}"
                              VerticalAlignment="Center" Margin="0,0,8,0">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" Spacing="4" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:RefBadgeViewModel">
                      <Border Classes="badge" Classes.local="{Binding IsLocal}" Classes.remote="{Binding IsRemote}"
                              Classes.tag="{Binding IsTag}" Classes.wt="{Binding IsWorktree}" Classes.stash="{Binding IsStash}" Classes.current="{Binding IsCurrent}"
                              ToolTip.Tip="{Binding Tooltip}" ContextFlyout="{StaticResource RefMenu}">
                        <StackPanel Orientation="Horizontal">
                          <Border Classes="refblock">
                            <Panel>
                              <LucideIcon Kind="GitBranch" IsVisible="{Binding IsLocal}" />
                              <LucideIcon Kind="Cloud" IsVisible="{Binding IsRemote}" />
                              <LucideIcon Kind="Tag" IsVisible="{Binding IsTag}" />
                              <LucideIcon Kind="FolderTree" IsVisible="{Binding IsWorktree}" />
                              <LucideIcon Kind="Archive" IsVisible="{Binding IsStash}" />
                            </Panel>
                          </Border>
                          <TextBlock Classes="name" Text="{Binding Text}" Margin="5,0,5,0" />
                          <!-- Remotes with the same branch on this commit: "main │ origin" -->
                          <ItemsControl ItemsSource="{Binding Remotes}" IsVisible="{Binding HasRemotes}">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="x:String">
                                <Border Classes="remote">
                                  <TextBlock Text="{Binding}" />
                                </Border>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!-- Review comments on the commit's diff -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="3" Margin="8,0,8,0" VerticalAlignment="Center"
                            IsVisible="{Binding HasComments}" ToolTip.Tip="{Binding CommentTip}">
                  <LucideIcon Kind="MessageSquareText" Size="12" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
                  <TextBlock Classes="muted small" Text="{Binding CommentCount}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Classes="subject" Text="{Binding Subject}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           ToolTip.Tip="{Binding Tooltip}" />
              </DockPanel>

              <TextBlock Grid.Column="2" Classes="muted small" Text="{Binding DateText}" VerticalAlignment="Center" />
              <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" Margin="0,0,10,0">
                <ctl:Avatar Email="{Binding AuthorEmail}" AuthorName="{Binding Author}" Width="18" Height="18" VerticalAlignment="Center" />
                <TextBlock Classes="muted small" Text="{Binding Author}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="118" />
              </StackPanel>
              <TextBlock Grid.Column="4" Classes="mono muted" Text="{Binding ShortHash}" VerticalAlignment="Center" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" MaxWidth="460" IsVisible="{Binding IsEmpty}">
        <TextBlock Classes="title" HorizontalAlignment="Center" Text="No commits yet" IsVisible="{Binding !IsFiltered}" />
        <TextBlock Classes="muted" TextWrapping="Wrap" TextAlignment="Center" IsVisible="{Binding !IsFiltered}"
                   Text="Make the first commit in this repository and its history appears here." />
        <TextBlock Classes="title" HorizontalAlignment="Center" Text="No matching commits" IsVisible="{Binding IsFiltered}" />
        <TextBlock Classes="muted" TextWrapping="Wrap" TextAlignment="Center" IsVisible="{Binding IsFiltered}"
                   Text="No commit matches the filters. Change or clear them to see more." />
      </StackPanel>

      <Border VerticalAlignment="Top" Background="{DynamicResource DelBgBrush}" Padding="14,8" Margin="12"
              CornerRadius="6" IsVisible="{Binding LoadError, Converter={x:Static ObjectConverters.IsNotNull}}">
        <SelectableTextBlock Text="{Binding LoadError, StringFormat='Could not read this repository: {0}'}" TextWrapping="Wrap" />
      </Border>
    </Panel>

    <GridSplitter x:Name="DetailsSplitter" Grid.Row="3" Height="1" ResizeDirection="Rows" />

    <v:DetailsView x:Name="DetailsPane" Grid.Row="4" DataContext="{Binding Details}" />

    <!-- Contributors, in place of the graph and details while switched on -->
    <v:StatsView Grid.Row="1" Grid.RowSpan="4" DataContext="{Binding Stats}" ZIndex="1"
                 IsVisible="{Binding $parent[UserControl].((vm:RepoTabViewModel)DataContext).ShowStats, FallbackValue=False}" />
  </Grid>
</UserControl>
