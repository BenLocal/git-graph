<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GitGraph.App.ViewModels"
             xmlns:ctl="using:GitGraph.App.Controls"
             xmlns:ae="using:AvaloniaEdit"
             xmlns:svc="using:GitGraph.App.Services"
             x:Class="GitGraph.App.Views.FolderTabView"
             x:DataType="vm:FolderTabViewModel">
  <UserControl.Resources>
    <!-- Shared by every row: a flyout is built when it opens and takes the row it opened on as its data (see RepoTabView). -->
    <MenuFlyout x:Key="FileNodeMenu" x:DataType="vm:FileNodeViewModel">
      <MenuItem Header="Open in VS Code" Command="{Binding Owner.OpenInVsCodeCommand}" CommandParameter="{Binding}" />
      <MenuItem Header="File history" Command="{Binding Owner.FileHistoryCommand}" CommandParameter="{Binding}" IsVisible="{Binding IsFile}" />
      <MenuItem Header="Blame" Command="{Binding Owner.BlameCommand}" CommandParameter="{Binding}" IsVisible="{Binding IsFile}" />
      <Separator />
      <MenuItem Header="Copy path" Command="{Binding Owner.CopyPathCommand}" CommandParameter="{Binding}" />
      <MenuItem Header="Copy full path" Command="{Binding Owner.CopyFullPathCommand}" CommandParameter="{Binding}" />
      <MenuItem Header="Custom commands" ItemsSource="{Binding CustomCommands}" ItemContainerTheme="{StaticResource CustomCommandItem}"
                IsVisible="{Binding CustomCommands, Converter={x:Static vm:Converters.HasItems}}" />
    </MenuFlyout>
    <!-- The selected file gets the same amber wash as selections elsewhere. -->
    <!-- Deep folders stay readable in a narrow tree: a smaller indent, and names trim instead of scrolling sideways. -->
    <x:Double x:Key="TreeViewItemIndent">12</x:Double>
    <SolidColorBrush x:Key="TreeViewItemBackgroundSelected" Color="{DynamicResource SignalWashColor}" />
    <SolidColorBrush x:Key="TreeViewItemBackgroundSelectedPointerOver" Color="{DynamicResource SignalWashColor}" />
    <SolidColorBrush x:Key="TreeViewItemBackgroundPointerOver" Color="{DynamicResource HoverWashColor}" />
    <SolidColorBrush x:Key="TreeViewItemForegroundSelected" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="TreeViewItemForegroundSelectedPointerOver" Color="{DynamicResource TextColor}" />
  </UserControl.Resources>
  <UserControl.Styles>
    <!-- Git state of files and folders, coloured like VS Code's explorer -->
    <Style Selector="Grid.gitstate TextBlock.mark">
      <Setter Property="FontFamily" Value="{StaticResource CodeFont}" />
      <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Grid.gitstate.modified TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource GitModifiedBrush}" />
    </Style>
    <Style Selector="Grid.gitstate.added TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource GitAddedBrush}" />
    </Style>
    <Style Selector="Grid.gitstate.untracked TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource GitUntrackedBrush}" />
    </Style>
    <Style Selector="Grid.gitstate.deleted TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource GitDeletedBrush}" />
    </Style>
    <Style Selector="Grid.gitstate.conflict TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource GitConflictBrush}" />
    </Style>
    <Style Selector="Grid.gitstate.ignored">
      <Setter Property="Opacity" Value="0.5" />
    </Style>
    <!-- Open folders follow the view model, which remembers them for next time. -->
    <Style Selector="TreeView.files TreeViewItem" x:DataType="vm:FileNodeViewModel">
      <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
      <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
    </Style>
  </UserControl.Styles>

  <Panel>
    <Grid x:Name="Columns" ColumnDefinitions="300,1,*">
      <!-- The tree -->
      <Grid RowDefinitions="Auto,*" Background="{DynamicResource SurfaceBrush}">
        <Grid ColumnDefinitions="*,Auto" Margin="16,10,8,6">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <LucideIcon Kind="Folder" Size="15" VerticalAlignment="Center" />
            <TextBlock Classes="title" Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Path}" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
            <Button Classes="ghost" Padding="5" ToolTip.Tip="Search the folder">
              <LucideIcon Kind="Search" Size="14" />
              <Button.Flyout>
                <MenuFlyout>
                  <MenuItem Header="Go to File…" Tag="{x:Static vm:SearchKind.Files}" Click="OnSearchMenu"
                            InputGesture="{Binding Keys[QuickOpen], Source={x:Static svc:ShortcutService.Instance}}" />
                  <MenuItem Header="Go to Symbol…" Tag="{x:Static vm:SearchKind.Symbols}" Click="OnSearchMenu"
                            InputGesture="{Binding Keys[GoToSymbol], Source={x:Static svc:ShortcutService.Instance}}" />
                  <MenuItem Header="Find in Files…" Tag="{x:Static vm:SearchKind.Text}" Click="OnSearchMenu"
                            InputGesture="{Binding Keys[FindInFiles], Source={x:Static svc:ShortcutService.Instance}}" />
                </MenuFlyout>
              </Button.Flyout>
            </Button>
            <ToggleButton Classes="ghost" Padding="5" IsChecked="{Binding Terminal.IsVisible, Mode=OneWay}"
                          Command="{Binding ToggleTerminalCommand}" ToolTip.Tip="Toggle terminal">
              <LucideIcon Kind="Terminal" />
            </ToggleButton>
            <Button Classes="ghost" Padding="5" Command="{Binding OpenInVsCodeCommand}" CommandParameter="{x:Null}" ToolTip.Tip="Open the folder in VS Code">
              <LucideIcon Kind="SquareCode" Size="15" />
            </Button>
            <Button Classes="ghost" Padding="5" Command="{Binding RefreshTreeCommand}" ToolTip.Tip="Refresh">
              <LucideIcon Kind="RotateCw" Size="14" />
            </Button>
            <Button Classes="ghost" Padding="5" Command="{Binding CollapseAllCommand}" ToolTip.Tip="Collapse all folders">
              <LucideIcon Kind="ChevronsDownUp" Size="14" />
            </Button>
          </StackPanel>
        </Grid>

        <TreeView x:Name="Tree" Grid.Row="1" Classes="files" ItemsSource="{Binding Root.Children}"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled" Padding="4,0,12,8">
          <TreeView.ItemTemplate>
            <TreeDataTemplate x:DataType="vm:FileNodeViewModel" ItemsSource="{Binding Children}">
              <Grid ColumnDefinitions="Auto,*,Auto" Background="Transparent" ToolTip.Tip="{Binding StatusTooltip}"
                    Classes="gitstate" Classes.modified="{Binding IsModified}" Classes.added="{Binding IsAdded}"
                    Classes.untracked="{Binding IsUntracked}" Classes.deleted="{Binding IsDeleted}"
                    Classes.conflict="{Binding IsConflict}" Classes.ignored="{Binding IsIgnored}" ContextFlyout="{StaticResource FileNodeMenu}">
                <Panel Margin="0,0,7,0">
                  <LucideIcon Kind="Folder" Size="14" VerticalAlignment="Center" IsVisible="{Binding IsDirectory}" />
                  <LucideIcon Kind="File" Size="14" VerticalAlignment="Center" IsVisible="{Binding IsFile}" />
                </Panel>
                <TextBlock Grid.Column="1" Classes="name" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <!-- M, A, U, R, D or ! after a changed file, a dot after a folder with changes, as in VS Code -->
                <TextBlock Grid.Column="2" Classes="mark" Text="{Binding StatusLetter}" IsVisible="{Binding HasMark}" Margin="8,0,2,0" VerticalAlignment="Center" />
              </Grid>
            </TreeDataTemplate>
          </TreeView.ItemTemplate>
        </TreeView>
      </Grid>

      <GridSplitter x:Name="TreeSplitter" Grid.Column="1" Width="1" ResizeDirection="Columns" />

      <!-- The selected file -->
      <Grid x:Name="FileArea" Grid.Column="2" RowDefinitions="Auto,*">
        <Border BorderBrush="{DynamicResource RuleBrush}" BorderThickness="0,0,0,1" Padding="16,8,8,8" IsVisible="{Binding HasFile}">
          <!-- A long path trims from the left, so the file name stays visible; the full path is in the tooltip. -->
          <Grid ColumnDefinitions="Auto,*,Auto,Auto">
            <TextBlock Grid.Column="1" Classes="mono" Text="{Binding FilePath}" VerticalAlignment="Center" TextTrimming="LeadingCharacterEllipsis"
                       Background="Transparent" ToolTip.Tip="{Binding FilePath}" Margin="4,0,0,0">
              <TextBlock.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="Copy path" Command="{Binding CopyPathCommand}" CommandParameter="{x:Null}" />
                  <MenuItem Header="Copy full path" Command="{Binding CopyFullPathCommand}" CommandParameter="{x:Null}" />
                  <Separator />
                  <MenuItem Header="File history" Command="{Binding FileHistoryCommand}" CommandParameter="{x:Null}" />
                  <MenuItem Header="Blame" Command="{Binding BlameCommand}" CommandParameter="{x:Null}" />
                </ContextMenu>
              </TextBlock.ContextMenu>
            </TextBlock>
            <Button Grid.Column="0" Classes="ghost" Padding="4" Margin="-6,0,0,0" Command="{Binding CopyPathCommand}" CommandParameter="{x:Null}"
                    ToolTip.Tip="Copy path">
              <LucideIcon Kind="Copy" Size="13" />
            </Button>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" Margin="12,0,8,0">
              <TextBlock Classes="muted small" Text="{Binding IndexStatus}" VerticalAlignment="Center"
                         IsVisible="{Binding IndexStatus, Converter={x:Static ObjectConverters.IsNotNull}}"
                         ToolTip.Tip="Code navigation reads the files once; until then it searches with git grep." />
              <TextBlock Classes="muted small" Text="{Binding FileInfo}" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2">
              <Button Classes="ghost text" Command="{Binding CopyContentsCommand}" ToolTip.Tip="Copy the whole file">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <LucideIcon Kind="Copy" Size="13" VerticalAlignment="Center" />
                  <TextBlock Classes="small" Text="Copy contents" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Classes="ghost text" Command="{Binding OpenInVsCodeCommand}" CommandParameter="{Binding SelectedNode}" ToolTip.Tip="Open this file in VS Code">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <LucideIcon Kind="SquareCode" Size="14" VerticalAlignment="Center" />
                  <TextBlock Classes="small" Text="Open in VS Code" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Grid>
        </Border>

        <TextBlock Grid.Row="1" Classes="muted" Text="Select a file to see what's in it." HorizontalAlignment="Center" VerticalAlignment="Center"
                   IsVisible="{Binding !HasFile}" />
        <TextBlock Grid.Row="1" Classes="muted" Text="{Binding FileMessage}" Margin="16" TextWrapping="Wrap"
                   IsVisible="{Binding FileMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <ScrollViewer Grid.Row="1" IsVisible="{Binding Image, Converter={x:Static ObjectConverters.IsNotNull}}" HorizontalScrollBarVisibility="Auto">
          <Image Source="{Binding Image}" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16" />
        </ScrollViewer>
        <!-- AvaloniaEdit, read-only: TextMate highlighting as in VS Code, selection across lines, Ctrl+F to search. -->
        <ae:TextEditor x:Name="Editor" Grid.Row="1" IsReadOnly="True" ShowLineNumbers="True"
                       FontFamily="{StaticResource CodeFont}" FontSize="{DynamicResource FontSizeCode}"
                       HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="8,6,0,0"
                       IsVisible="{Binding FileText, Converter={x:Static ObjectConverters.IsNotNull}}">
          <ae:TextEditor.ContextFlyout>
            <MenuFlyout>
              <MenuItem Header="Go to Definition" Tag="{x:Static vm:NavKind.Definition}" Click="OnNavMenu"
                        InputGesture="{Binding Keys[GoToDefinition], Source={x:Static svc:ShortcutService.Instance}}" />
              <MenuItem Header="Find References" Tag="{x:Static vm:NavKind.References}" Click="OnNavMenu"
                        InputGesture="{Binding Keys[FindReferences], Source={x:Static svc:ShortcutService.Instance}}" />
              <MenuItem Header="Go to Implementations" Tag="{x:Static vm:NavKind.Implementations}" Click="OnNavMenu"
                        InputGesture="{Binding Keys[GoToImplementation], Source={x:Static svc:ShortcutService.Instance}}" />
              <Separator />
              <MenuItem Header="Go Back" Command="{Binding GoBackCommand}"
                        InputGesture="{Binding Keys[NavigateBack], Source={x:Static svc:ShortcutService.Instance}}" />
              <MenuItem Header="Go Forward" Command="{Binding GoForwardCommand}"
                        InputGesture="{Binding Keys[NavigateForward], Source={x:Static svc:ShortcutService.Instance}}" />
            </MenuFlyout>
          </ae:TextEditor.ContextFlyout>
        </ae:TextEditor>

        <!-- Lookup results: definitions, references or implementations; or a search's (go to file, go to symbol,
             find in files), with a query box above. Picking one previews it on the left; a double-click or Enter
             jumps there, Esc closes. -->
        <Border Grid.Row="1" Classes="peek" IsVisible="{Binding IsNavOpen}" VerticalAlignment="Top" Margin="24,8,24,0" Height="340">
          <Grid RowDefinitions="Auto,*">
            <Grid ColumnDefinitions="*,Auto,Auto" Margin="12,6,4,6">
              <TextBlock Classes="small" FontWeight="SemiBold" Text="{Binding NavTitle}" VerticalAlignment="Center" IsVisible="{Binding !IsSearching}" />
              <TextBox x:Name="SearchBox" Text="{Binding SearchQuery}" PlaceholderText="{Binding SearchPlaceholder}"
                       IsVisible="{Binding IsSearching}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Classes="small muted" Text="{Binding NavTitle}" VerticalAlignment="Center" Margin="12,0,4,0"
                         IsVisible="{Binding IsSearching}" />
              <Button Grid.Column="2" Classes="ghost" Padding="4" Command="{Binding CloseNavCommand}" ToolTip.Tip="Close (Esc)">
                <LucideIcon Kind="X" Size="13" />
              </Button>
            </Grid>
            <Grid Grid.Row="1" ColumnDefinitions="3*,2*">
              <ae:TextEditor x:Name="Preview" IsReadOnly="True" ShowLineNumbers="True"
                             FontFamily="{StaticResource CodeFont}" FontSize="{DynamicResource FontSizeCode}"
                             HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="8,4,0,0" />
              <Border Grid.Column="1" BorderBrush="{DynamicResource RuleBrush}" BorderThickness="1,0,0,0">
                <ListBox x:Name="NavList" Classes="dense" ItemsSource="{Binding NavResults}" SelectedItem="{Binding SelectedNavItem}"
                         KeyDown="OnNavListKeyDown" IsVisible="{Binding NavResults.Count}">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:NavItem">
                      <StackPanel Background="Transparent" Margin="10,3" DoubleTapped="OnNavItemDoubleTapped">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Classes="mono small muted" Text="{Binding Location}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Grid.Column="1" Classes="small muted" Text="{Binding Detail}" Margin="12,0,0,0" />
                        </Grid>
                        <TextBlock Classes="mono small" Text="{Binding LineText}" TextTrimming="CharacterEllipsis"
                                   IsVisible="{Binding LineText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Border>
            </Grid>
          </Grid>
        </Border>
      </Grid>
    </Grid>

    <!-- Confirms a copy, then fades out. -->
    <Border Classes="toast" Classes.show="{Binding CopyNote.IsVisible}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
            Margin="0,0,16,16" IsHitTestVisible="False">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <LucideIcon Kind="Check" Size="13" VerticalAlignment="Center" Foreground="{DynamicResource AddFgBrush}" />
        <TextBlock Classes="small" Text="{Binding CopyNote.Text}" VerticalAlignment="Center" />
      </StackPanel>
    </Border>
  </Panel>
</UserControl>
