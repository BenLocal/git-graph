<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GitGraph.App.ViewModels"
             xmlns:ctl="using:GitGraph.App.Controls"
             xmlns:svc="using:GitGraph.App.Services"
             x:Class="GitGraph.App.Views.DetailsView"
             x:DataType="vm:DetailsViewModel"
             Background="{DynamicResource SurfaceBrush}">
  <Panel>
    <TextBlock Classes="muted" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !HasContent}"
               Text="Select a commit to see what it changed. Ctrl+click a second one to compare the two." />

    <Panel x:Name="ContentRoot" IsVisible="{Binding HasContent}">
      <!-- Rule under the tab strip; the TabControl template has no border of its own. -->
      <Border Height="34" VerticalAlignment="Top" BorderBrush="{DynamicResource RuleBrush}" BorderThickness="0,0,0,1" />

      <TabControl Classes="pane" SelectedIndex="{Binding SelectedTabIndex}">
        <!-- The full commit message and its metadata -->
        <TabItem Header="Commit">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="MessagePage" Margin="20,14,20,16" Spacing="10" MaxWidth="880" HorizontalAlignment="Left" Background="Transparent">
              <!-- Right-click anywhere in the message: copy what's selected, or the whole message. -->
              <StackPanel.ContextMenu>
                <ContextMenu x:Name="MessageMenu">
                  <MenuItem x:Name="CopySelectionItem" Header="Copy selected text" Click="OnCopySelection" InputGesture="Ctrl+C" />
                  <MenuItem Header="Copy message" Command="{Binding CopyMessageCommand}" />
                  <MenuItem Header="Copy commit hash" Command="{Binding CopyHashCommand}"
                            IsVisible="{Binding HashText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </ContextMenu>
              </StackPanel.ContextMenu>
              <Grid ColumnDefinitions="*,Auto">
                <SelectableTextBlock Text="{Binding Heading}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeTitle}" TextWrapping="Wrap" />
                <Button Grid.Column="1" Classes="ghost" Padding="5" Margin="12,-2,0,0" VerticalAlignment="Top"
                        Command="{Binding CopyMessageCommand}" ToolTip.Tip="Copy message"
                        IsVisible="{Binding HashText, Converter={x:Static ObjectConverters.IsNotNull}}">
                  <LucideIcon Kind="Copy" Size="14" />
                </Button>
              </Grid>
              <TextBlock Classes="muted" Text="{Binding RangeText}" TextWrapping="Wrap"
                         IsVisible="{Binding RangeText, Converter={x:Static ObjectConverters.IsNotNull}}" />
              <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto"
                    IsVisible="{Binding HashText, Converter={x:Static ObjectConverters.IsNotNull}}">
                <TextBlock Classes="muted small" Text="Commit" Margin="0,0,16,4" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                  <SelectableTextBlock Classes="mono" Text="{Binding HashText}" VerticalAlignment="Center" />
                  <Button Classes="ghost" Padding="4" Command="{Binding CopyHashCommand}" ToolTip.Tip="Copy commit hash">
                    <LucideIcon Kind="Copy" Size="13" />
                  </Button>
                </StackPanel>
                <TextBlock Grid.Row="1" Classes="muted small" Text="Author" Margin="0,0,16,4" VerticalAlignment="Center" />
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                  <ctl:Avatar Email="{Binding AuthorEmail}" AuthorName="{Binding AuthorName}" Width="24" Height="24" VerticalAlignment="Center" />
                  <SelectableTextBlock Text="{Binding AuthorText}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Grid.Row="2" Classes="muted small" Text="Date" Margin="0,0,16,0" VerticalAlignment="Center" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DateText}" />
              </Grid>
              <TextBlock Classes="muted small" Text="{Binding CommitterText}" TextWrapping="Wrap"
                         IsVisible="{Binding CommitterText, Converter={x:Static ObjectConverters.IsNotNull}}" />
              <TextBlock Classes="muted small" Text="{Binding ParentsText}" TextWrapping="Wrap"
                         IsVisible="{Binding ParentsText, Converter={x:Static ObjectConverters.IsNotNull}}" />
              <Border BorderBrush="{DynamicResource RuleBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0"
                      IsVisible="{Binding Body, Converter={x:Static ObjectConverters.IsNotNull}}">
                <ctl:MarkdownView Markdown="{Binding Body}" />
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <!-- Changed files and the diff of the selected one -->
        <TabItem>
          <TabItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="7">
              <TextBlock Text="Changes" VerticalAlignment="Center" />
              <Border Classes="count" VerticalAlignment="Center">
                <TextBlock Text="{Binding FileCount}" />
              </Border>
            </StackPanel>
          </TabItem.Header>
          <Grid ColumnDefinitions="320,1,*">
            <Grid RowDefinitions="Auto,*">
              <Border Padding="16,8,16,4">
                <TextBlock Classes="section" Text="{Binding FilesSummary}" />
              </Border>
              <ListBox x:Name="FileList" Grid.Row="1" Classes="dense pills" ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:FileChangeViewModel">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" Height="24" Margin="16,0,12,0" Background="Transparent"
                          ToolTip.Tip="{Binding Tooltip}">
                      <Grid.ContextMenu>
                        <ContextMenu>
                          <MenuItem Header="Open diff in full window" Command="{Binding Owner.OpenFullDiffCommand}"
                                    CommandParameter="{Binding}" InputGesture="Enter" />
                          <Separator />
                          <MenuItem Header="Copy path" Command="{Binding Owner.CopyPathCommand}" CommandParameter="{Binding}" />
                          <MenuItem Header="Copy full path" Command="{Binding Owner.CopyFullPathCommand}" CommandParameter="{Binding}" />
                        </ContextMenu>
                      </Grid.ContextMenu>
                      <TextBlock Classes="status" Classes.added="{Binding IsAdded}" Classes.deleted="{Binding IsDeleted}"
                                 Text="{Binding Status}" VerticalAlignment="Center" />
                      <!-- Name and folder share one line that trims at the end, so the counts always stay visible. -->
                      <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="6,0,8,0" TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding FileName}" />
                        <Run Text="{Binding Directory}" FontSize="{StaticResource FontSizeSmall}" Foreground="{DynamicResource MutedBrush}" />
                      </TextBlock>
                      <TextBlock Grid.Column="2" Classes="add mono" Text="{Binding AddText}" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="11.5" />
                      <TextBlock Grid.Column="3" Classes="del mono" Text="{Binding DelText}" VerticalAlignment="Center" Margin="6,0,0,0" FontSize="11.5" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>

            <GridSplitter Grid.Column="1" Width="1" ResizeDirection="Columns" />

            <!-- Diff of the selected file -->
            <Grid x:Name="DiffArea" Grid.Column="2" RowDefinitions="Auto,*" Background="{DynamicResource CanvasBrush}">
              <Border BorderBrush="{DynamicResource RuleBrush}" BorderThickness="0,0,0,1" Background="{DynamicResource SurfaceBrush}" Padding="14,4,8,4">
                <!-- A long path trims from the left, so the file name stays visible; the full path is in the tooltip. -->
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <TextBlock Grid.Column="1" Classes="mono" VerticalAlignment="Center" TextTrimming="LeadingCharacterEllipsis" Margin="4,0,12,0"
                             Text="{Binding SelectedFile.Change.Path, FallbackValue=''}" Background="Transparent"
                             ToolTip.Tip="{Binding SelectedFile.Change.Path, FallbackValue=''}">
                    <TextBlock.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="Copy path" Command="{Binding CopyPathCommand}" />
                        <MenuItem Header="Copy full path" Command="{Binding CopyFullPathCommand}" />
                      </ContextMenu>
                    </TextBlock.ContextMenu>
                  </TextBlock>
                  <Button Grid.Column="0" Classes="ghost" Padding="4" Margin="-6,0,0,0"
                          Command="{Binding CopyPathCommand}" ToolTip.Tip="Copy path" IsVisible="{Binding HasDiff}">
                    <LucideIcon Kind="Copy" Size="13" />
                  </Button>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
                    <ToggleButton Classes="ghost" IsChecked="{Binding IsUnified, Mode=OneWay}" Command="{Binding ShowUnifiedCommand}" ToolTip.Tip="One column">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <LucideIcon Kind="TextAlignStart" Size="14" VerticalAlignment="Center" />
                        <TextBlock Classes="small" Text="Unified" VerticalAlignment="Center" />
                      </StackPanel>
                    </ToggleButton>
                    <ToggleButton Classes="ghost" IsChecked="{Binding IsSplit, Mode=OneWay}" Command="{Binding ShowSplitCommand}" ToolTip.Tip="Before and after side by side">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <LucideIcon Kind="Columns2" Size="14" VerticalAlignment="Center" />
                        <TextBlock Classes="small" Text="Split" VerticalAlignment="Center" />
                      </StackPanel>
                    </ToggleButton>
                  </StackPanel>
                </Grid>
              </Border>

              <TextBlock Grid.Row="1" Classes="muted" Text="{Binding DiffMessage}" Margin="16" TextWrapping="Wrap"
                         IsVisible="{Binding DiffMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />

              <ListBox Grid.Row="1" Classes="dense plain" ItemsSource="{Binding DiffLines}" IsVisible="{Binding IsUnified}"
                       ItemTemplate="{StaticResource UnifiedLineTemplate}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />

              <ListBox Grid.Row="1" Classes="dense plain" ItemsSource="{Binding SplitRows}" IsVisible="{Binding IsSplit}"
                       ItemTemplate="{StaticResource SplitRowTemplate}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
            </Grid>
          </Grid>
        </TabItem>
      </TabControl>
    </Panel>

    <!-- Confirms a copy, then fades out. -->
    <Border Classes="toast" Classes.show="{Binding IsCopiedNoteVisible}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
            Margin="0,0,16,16" IsHitTestVisible="False">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <LucideIcon Kind="Check" Size="13" VerticalAlignment="Center" Foreground="{DynamicResource AddFgBrush}" />
        <TextBlock Classes="small" Text="{Binding CopiedNote}" VerticalAlignment="Center" />
      </StackPanel>
    </Border>

    <!-- Panel actions on the right of the tab strip, as in VS Code. -->
    <StackPanel Orientation="Horizontal" Spacing="2" Height="34" Margin="0,0,8,0"
                HorizontalAlignment="Right" VerticalAlignment="Top">
      <Button Classes="ghost" Command="{Binding ToggleMaximizeCommand}" ToolTip.Tip="{Binding Tips[MaximizePanel], Source={x:Static svc:ShortcutService.Instance}}" IsVisible="{Binding !IsMaximized}">
        <LucideIcon Kind="ChevronUp" Size="14" />
      </Button>
      <Button Classes="ghost" Command="{Binding ToggleMaximizeCommand}" ToolTip.Tip="Restore panel size" IsVisible="{Binding IsMaximized}">
        <LucideIcon Kind="ChevronDown" Size="14" />
      </Button>
      <Button Classes="ghost" Command="{Binding ClosePanelCommand}" ToolTip.Tip="{Binding Tips[TogglePanel], Source={x:Static svc:ShortcutService.Instance}, StringFormat='Hide panel. {0}'}">
        <LucideIcon Kind="X" Size="14" />
      </Button>
    </StackPanel>
  </Panel>
</UserControl>
