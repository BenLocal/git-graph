<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GitGraph.App.ViewModels"
             xmlns:ctl="using:GitGraph.App.Controls"
             xmlns:svc="using:GitGraph.App.Services"
             x:Class="GitGraph.App.Views.DetailsView"
             x:DataType="vm:DetailsViewModel"
             Background="{DynamicResource SurfaceBrush}">
  <UserControl.Resources>
    <!-- Shared by every row: a flyout is built when it opens and takes the row it opened on as its data (see RepoTabView). -->
    <MenuFlyout x:Key="WorkingFileMenu" x:DataType="vm:FileChangeViewModel">
      <MenuItem Header="Open diff in full window" Command="{Binding Owner.OpenFullDiffCommand}" CommandParameter="{Binding}" />
      <MenuItem Header="File history" Command="{Binding Owner.FileHistoryCommand}" CommandParameter="{Binding}" />
      <MenuItem Header="Blame" Command="{Binding Owner.BlameCommand}" CommandParameter="{Binding}" />
      <Separator />
      <MenuItem Header="Stage" Command="{Binding Owner.StageCommand}" CommandParameter="{Binding}" IsVisible="{Binding CanStage}" />
      <MenuItem Header="Unstage" Command="{Binding Owner.UnstageCommand}" CommandParameter="{Binding}" IsVisible="{Binding CanUnstage}" />
      <MenuItem Header="{Binding DiscardTip, StringFormat='{}{0}…'}" Command="{Binding Owner.DiscardCommand}" CommandParameter="{Binding}"
                IsVisible="{Binding CanDiscard}" />
      <MenuItem Header="Keep current version (ours)" Command="{Binding Owner.TakeOursCommand}" CommandParameter="{Binding}"
                IsVisible="{Binding IsConflicted}"
                ToolTip.Tip="The checked-out branch's version; during a rebase, the branch you are rebasing onto" />
      <MenuItem Header="Take incoming version (theirs)" Command="{Binding Owner.TakeTheirsCommand}" CommandParameter="{Binding}"
                IsVisible="{Binding IsConflicted}"
                ToolTip.Tip="The version being merged, picked or reverted; during a rebase, your commit being replayed" />
      <MenuItem Header="Open in VS Code" Command="{Binding Owner.OpenInVsCodeCommand}" CommandParameter="{Binding}"
                IsVisible="{Binding CanOpen}" />
      <Separator />
      <MenuItem Header="Copy path" Command="{Binding Owner.CopyPathCommand}" CommandParameter="{Binding}" />
      <MenuItem Header="Copy full path" Command="{Binding Owner.CopyFullPathCommand}" CommandParameter="{Binding}" />
      <MenuItem Header="Custom commands" ItemsSource="{Binding CustomCommands}" ItemContainerTheme="{StaticResource CustomCommandItem}"
                IsVisible="{Binding CustomCommands, Converter={x:Static vm:Converters.HasItems}}" />
    </MenuFlyout>
    <MenuFlyout x:Key="ChangedFileMenu" x:DataType="vm:FileChangeViewModel">
      <MenuItem Header="Open diff in full window" Command="{Binding Owner.OpenFullDiffCommand}"
                CommandParameter="{Binding}" InputGesture="Enter" />
      <MenuItem Header="File history" Command="{Binding Owner.FileHistoryCommand}" CommandParameter="{Binding}" />
      <MenuItem Header="Blame" Command="{Binding Owner.BlameCommand}" CommandParameter="{Binding}" />
      <Separator />
      <MenuItem Header="Copy path" Command="{Binding Owner.CopyPathCommand}" CommandParameter="{Binding}" />
      <MenuItem Header="Copy full path" Command="{Binding Owner.CopyFullPathCommand}" CommandParameter="{Binding}" />
      <MenuItem Header="Custom commands" ItemsSource="{Binding CustomCommands}" ItemContainerTheme="{StaticResource CustomCommandItem}"
                IsVisible="{Binding CustomCommands, Converter={x:Static vm:Converters.HasItems}}" />
    </MenuFlyout>
  </UserControl.Resources>
  <Panel>
    <TextBlock Classes="muted" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !HasContent}"
               Text="Select a commit to see what it changed. Ctrl+click a second one to compare the two." />

    <Panel x:Name="ContentRoot" IsVisible="{Binding HasContent}">
      <!-- Rule under the tab strip; the TabControl template has no border of its own. -->
      <Border Height="34" VerticalAlignment="Top" BorderBrush="{DynamicResource RuleBrush}" BorderThickness="0,0,0,1" />

      <TabControl Classes="pane" SelectedIndex="{Binding SelectedTabIndex}">
        <!-- The full commit message and its metadata -->
        <TabItem Header="Commit">
          <Panel>
          <!-- Uncommitted changes: write the message and commit what is staged (the files are on the Changes tab) -->
          <ScrollViewer HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding IsStaging}">
            <StackPanel Margin="20,14,20,16" Spacing="10">
              <TextBlock Text="Commit" FontWeight="SemiBold" FontSize="{DynamicResource FontSizeTitle}" />
              <TextBlock Classes="muted" Text="{Binding StagedText}" TextWrapping="Wrap" />
              <TextBox Text="{Binding CommitMessage}" PlaceholderText="Message (Ctrl+Enter to commit)" AcceptsReturn="True"
                       TextWrapping="Wrap" MinHeight="120" MaxHeight="320" VerticalContentAlignment="Top">
                <TextBox.KeyBindings>
                  <KeyBinding Gesture="Ctrl+Enter" Command="{Binding CommitCommand}" />
                </TextBox.KeyBindings>
              </TextBox>
              <Grid ColumnDefinitions="*,Auto">
                <CheckBox Content="Amend last commit" IsChecked="{Binding Amend}" VerticalAlignment="Center"
                          ToolTip.Tip="Replace the last commit with the staged changes and this message" />
                <Button Grid.Column="1" Classes="primary" Command="{Binding CommitCommand}" ToolTip.Tip="Commit the staged changes (Ctrl+Enter)">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <LucideIcon Kind="GitCommitHorizontal" Size="14" Foreground="{Binding $parent[Button].Foreground}" VerticalAlignment="Center" />
                    <TextBlock Text="Commit" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </Grid>
            </StackPanel>
          </ScrollViewer>

          <ScrollViewer HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding !IsStaging}">
            <StackPanel x:Name="MessagePage" Margin="20,14,20,16" Spacing="10" Background="Transparent">
              <!-- Right-click anywhere in the message: copy what's selected, or the whole message. -->
              <StackPanel.ContextMenu>
                <ContextMenu x:Name="MessageMenu">
                  <MenuItem x:Name="CopySelectionItem" Header="Copy selected text" Click="OnCopySelection" InputGesture="Ctrl+C" />
                  <MenuItem Header="Copy message" Command="{Binding CopyMessageCommand}" />
                  <MenuItem Header="Copy commit hash" Command="{Binding CopyHashCommand}"
                            IsVisible="{Binding HashText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </ContextMenu>
              </StackPanel.ContextMenu>
              <!-- The copy button follows the subject's last word, wherever it wraps -->
              <SelectableTextBlock FontWeight="SemiBold" FontSize="{DynamicResource FontSizeTitle}" TextWrapping="Wrap">
                <Run Text="{Binding Heading}" />
                <InlineUIContainer BaselineAlignment="Center">
                  <Button Classes="ghost" Padding="5" Margin="6,0,0,0" RenderTransform="translate(0px, 3px)"
                          Command="{Binding CopyMessageCommand}" ToolTip.Tip="Copy message"
                          IsVisible="{Binding HashText, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <LucideIcon Kind="Copy" Size="14" />
                  </Button>
                </InlineUIContainer>
              </SelectableTextBlock>
              <TextBlock Classes="muted" Text="{Binding RangeText}" TextWrapping="Wrap"
                         IsVisible="{Binding RangeText, Converter={x:Static ObjectConverters.IsNotNull}}" />
              <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto"
                    IsVisible="{Binding HashText, Converter={x:Static ObjectConverters.IsNotNull}}">
                <TextBlock Classes="muted small" Text="Commit" Margin="0,0,16,4" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                  <SelectableTextBlock Classes="mono" Text="{Binding HashText}" VerticalAlignment="Center" />
                  <Button Classes="ghost" Padding="4" Command="{Binding CopyHashCommand}" ToolTip.Tip="Copy commit hash">
                    <LucideIcon Kind="Copy" Size="13" />
                  </Button>
                </StackPanel>
                <TextBlock Grid.Row="1" Classes="muted small" Text="Author" Margin="0,0,16,4" VerticalAlignment="Center" />
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                  <ctl:Avatar Email="{Binding AuthorEmail}" AuthorName="{Binding AuthorName}" Width="24" Height="24" VerticalAlignment="Center" />
                  <SelectableTextBlock Text="{Binding AuthorText}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Grid.Row="2" Classes="muted small" Text="Date" Margin="0,0,16,0" VerticalAlignment="Center" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DateText}" />
              </Grid>
              <TextBlock Classes="muted small" Text="{Binding CommitterText}" TextWrapping="Wrap"
                         IsVisible="{Binding CommitterText, Converter={x:Static ObjectConverters.IsNotNull}}" />
              <TextBlock Classes="muted small" Text="{Binding ParentsText}" TextWrapping="Wrap"
                         IsVisible="{Binding ParentsText, Converter={x:Static ObjectConverters.IsNotNull}}" />
              <Border BorderBrush="{DynamicResource RuleBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0"
                      IsVisible="{Binding Body, Converter={x:Static ObjectConverters.IsNotNull}}">
                <ctl:MarkdownView Markdown="{Binding Body}" />
              </Border>
            </StackPanel>
          </ScrollViewer>
          </Panel>
        </TabItem>

        <!-- Changed files and the diff of the selected one -->
        <TabItem>
          <TabItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="7">
              <TextBlock Text="Changes" VerticalAlignment="Center" />
              <Border Classes="count" VerticalAlignment="Center">
                <TextBlock Text="{Binding FileCount}" />
              </Border>
            </StackPanel>
          </TabItem.Header>
          <Grid ColumnDefinitions="320,1,*">
            <Grid RowDefinitions="Auto,*">
              <Border Padding="16,8,16,4" IsVisible="{Binding !IsStaging}">
                <TextBlock Classes="section" Text="{Binding FilesSummary}" />
              </Border>

              <!-- Uncommitted files by group, each with stage, unstage and discard buttons -->
              <ScrollViewer x:Name="WorkingList" Grid.Row="1" IsVisible="{Binding IsStaging}" HorizontalScrollBarVisibility="Disabled" Margin="0,4,0,0"
                            Focusable="True" KeyDown="OnWorkingListKeyDown">
                <ItemsControl ItemsSource="{Binding Groups}" Margin="0,0,0,8">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:FileGroupViewModel">
                      <StackPanel>
                        <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="16,8,10,2" Height="24">
                          <TextBlock Classes="section" Text="{Binding Title}" VerticalAlignment="Center" />
                          <Border Grid.Column="1" Classes="count" Margin="7,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Files.Count}" />
                          </Border>
                          <StackPanel Grid.Column="3" Orientation="Horizontal">
                            <Button Classes="ghost" Padding="4" Command="{Binding Owner.DiscardAllCommand}" CommandParameter="{Binding}"
                                    IsVisible="{Binding CanDiscard}" ToolTip.Tip="Discard all changes">
                              <LucideIcon Kind="Undo2" Size="14" />
                            </Button>
                            <Button Classes="ghost" Padding="4" Command="{Binding Owner.StageAllCommand}" CommandParameter="{Binding}"
                                    IsVisible="{Binding CanStage}" ToolTip.Tip="{Binding StageTip}">
                              <LucideIcon Kind="Plus" Size="14" />
                            </Button>
                            <Button Classes="ghost" Padding="4" Command="{Binding Owner.UnstageAllCommand}" CommandParameter="{Binding}"
                                    IsVisible="{Binding CanUnstage}" ToolTip.Tip="Unstage all changes">
                              <LucideIcon Kind="Minus" Size="14" />
                            </Button>
                          </StackPanel>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Files}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:FileChangeViewModel">
                              <Border Classes="filerow" Classes.selected="{Binding IsSelected}" Tapped="OnWorkingFileTapped"
                                      DoubleTapped="OnWorkingFileDoubleTapped" ToolTip.Tip="{Binding Tooltip}" ContextFlyout="{StaticResource WorkingFileMenu}">
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="10,0,6,0">
                                  <TextBlock Classes="status" Classes.added="{Binding IsAdded}" Classes.deleted="{Binding IsDeleted}"
                                             Text="{Binding Status}" VerticalAlignment="Center" />
                                  <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="6,0,8,0" TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding FileName}" />
                                    <Run Text="{Binding Directory}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource MutedBrush}" />
                                  </TextBlock>
                                  <!-- Line counts, replaced by the buttons while the pointer is on the row -->
                                  <StackPanel Grid.Column="2" Classes="counts" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock Classes="add mono" Text="{Binding AddText}" FontSize="{DynamicResource FontSizeSmall}" />
                                    <TextBlock Classes="del mono" Text="{Binding DelText}" FontSize="{DynamicResource FontSizeSmall}" />
                                  </StackPanel>
                                  <StackPanel Grid.Column="3" Classes="rowactions" Orientation="Horizontal">
                                    <Button Classes="ghost" Padding="3" Command="{Binding Owner.DiscardCommand}" CommandParameter="{Binding}"
                                            IsVisible="{Binding CanDiscard}" ToolTip.Tip="{Binding DiscardTip}">
                                      <LucideIcon Kind="Undo2" Size="13" />
                                    </Button>
                                    <Button Classes="ghost" Padding="3" Command="{Binding Owner.StageCommand}" CommandParameter="{Binding}"
                                            IsVisible="{Binding CanStage}" ToolTip.Tip="{Binding StageTip}">
                                      <LucideIcon Kind="Plus" Size="13" />
                                    </Button>
                                    <Button Classes="ghost" Padding="3" Command="{Binding Owner.UnstageCommand}" CommandParameter="{Binding}"
                                            IsVisible="{Binding CanUnstage}" ToolTip.Tip="Unstage">
                                      <LucideIcon Kind="Minus" Size="13" />
                                    </Button>
                                  </StackPanel>
                                </Grid>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>

              <ListBox x:Name="FileList" Grid.Row="1" Classes="dense pills" ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}"
                       IsVisible="{Binding !IsStaging}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:FileChangeViewModel">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" Height="24" Margin="16,0,12,0" Background="Transparent"
                          ToolTip.Tip="{Binding Tooltip}" ContextFlyout="{StaticResource ChangedFileMenu}">
                      <TextBlock Classes="status" Classes.added="{Binding IsAdded}" Classes.deleted="{Binding IsDeleted}"
                                 Text="{Binding Status}" VerticalAlignment="Center" />
                      <!-- Name and folder share one line that trims at the end, so the counts always stay visible. -->
                      <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="6,0,8,0" TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding FileName}" />
                        <Run Text="{Binding Directory}" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource MutedBrush}" />
                      </TextBlock>
                      <TextBlock Grid.Column="2" Classes="add mono" Text="{Binding AddText}" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="{DynamicResource FontSizeSmall}" />
                      <TextBlock Grid.Column="3" Classes="del mono" Text="{Binding DelText}" VerticalAlignment="Center" Margin="6,0,0,0" FontSize="{DynamicResource FontSizeSmall}" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>

            <GridSplitter Grid.Column="1" Width="1" ResizeDirection="Columns" />

            <!-- Diff of the selected file -->
            <Grid x:Name="DiffArea" Grid.Column="2" RowDefinitions="Auto,*" Background="{DynamicResource CanvasBrush}">
              <Border BorderBrush="{DynamicResource RuleBrush}" BorderThickness="0,0,0,1" Background="{DynamicResource SurfaceBrush}" Padding="14,4,8,4">
                <!-- A long path trims from the left, so the file name stays visible; the full path is in the tooltip. -->
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <TextBlock Grid.Column="1" Classes="mono" VerticalAlignment="Center" TextTrimming="LeadingCharacterEllipsis" Margin="4,0,12,0"
                             Text="{Binding SelectedFile.Change.Path, FallbackValue=''}" Background="Transparent"
                             ToolTip.Tip="{Binding SelectedFile.Change.Path, FallbackValue=''}">
                    <TextBlock.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="Copy path" Command="{Binding CopyPathCommand}" />
                        <MenuItem Header="Copy full path" Command="{Binding CopyFullPathCommand}" />
                        <Separator />
                        <MenuItem Header="File history" Command="{Binding FileHistoryCommand}" CommandParameter="{x:Null}" />
                        <MenuItem Header="Blame" Command="{Binding BlameCommand}" CommandParameter="{x:Null}" />
                      </ContextMenu>
                    </TextBlock.ContextMenu>
                  </TextBlock>
                  <Button Grid.Column="0" Classes="ghost" Padding="4" Margin="-6,0,0,0"
                          Command="{Binding CopyPathCommand}" ToolTip.Tip="Copy path" IsVisible="{Binding HasDiff}">
                    <LucideIcon Kind="Copy" Size="13" />
                  </Button>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
                    <Button Classes="ghost" Command="{Binding OpenInVsCodeCommand}" CommandParameter="{x:Null}" IsVisible="{Binding CanOpenSelected}"
                            ToolTip.Tip="Open the file in VS Code">
                      <LucideIcon Kind="SquareArrowOutUpRight" Size="14" />
                    </Button>
                    <Button Classes="ghost" Command="{Binding FileHistoryCommand}" CommandParameter="{x:Null}" IsVisible="{Binding HasDiff}"
                            ToolTip.Tip="File history and blame">
                      <LucideIcon Kind="FileClock" Size="14" />
                    </Button>
                    <ToggleButton Classes="ghost" IsChecked="{Binding IsUnified, Mode=OneWay}" Command="{Binding ShowUnifiedCommand}" ToolTip.Tip="One column">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <LucideIcon Kind="TextAlignStart" Size="14" VerticalAlignment="Center" />
                        <TextBlock Classes="small" Text="Unified" VerticalAlignment="Center" />
                      </StackPanel>
                    </ToggleButton>
                    <ToggleButton Classes="ghost" IsChecked="{Binding IsSplit, Mode=OneWay}" Command="{Binding ShowSplitCommand}" ToolTip.Tip="Before and after side by side">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <LucideIcon Kind="Columns2" Size="14" VerticalAlignment="Center" />
                        <TextBlock Classes="small" Text="Split" VerticalAlignment="Center" />
                      </StackPanel>
                    </ToggleButton>
                  </StackPanel>
                </Grid>
              </Border>

              <TextBlock Grid.Row="1" Classes="muted" Text="{Binding DiffMessage}" Margin="16" TextWrapping="Wrap"
                         IsVisible="{Binding DiffMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />

              <!-- An image file: before and after, side by side -->
              <Grid Grid.Row="1" ColumnDefinitions="*,1,*" IsVisible="{Binding IsImageDiff}">
                <Grid RowDefinitions="Auto,*" Margin="16">
                  <TextBlock Classes="section" Text="{Binding OldImageText, StringFormat='Before  {0}'}" Margin="0,0,0,8" />
                  <Border Grid.Row="1" Classes="imageframe">
                    <Image Source="{Binding OldImage}" Stretch="Uniform" StretchDirection="DownOnly" />
                  </Border>
                </Grid>
                <Border Grid.Column="1" Background="{DynamicResource RuleBrush}" />
                <Grid Grid.Column="2" RowDefinitions="Auto,*" Margin="16">
                  <TextBlock Classes="section" Text="{Binding NewImageText, StringFormat='After  {0}'}" Margin="0,0,0,8" />
                  <Border Grid.Row="1" Classes="imageframe">
                    <Image Source="{Binding NewImage}" Stretch="Uniform" StretchDirection="DownOnly" />
                  </Border>
                </Grid>
              </Grid>

              <ListBox Grid.Row="1" Classes="dense plain" Classes.nowrap="{Binding !WrapLines}" ItemsSource="{Binding DiffLines}"
                       IsVisible="{Binding IsUnified}" ItemTemplate="{StaticResource UnifiedLineTemplate}"
                       ScrollViewer.HorizontalScrollBarVisibility="{Binding WrapLines, Converter={x:Static vm:Converters.ScrollUnlessWrapped}}" />

              <ListBox Grid.Row="1" Classes="dense plain" Classes.nowrap="{Binding !WrapLines}" ItemsSource="{Binding SplitRows}"
                       IsVisible="{Binding IsSplit}" ItemTemplate="{StaticResource SplitRowTemplate}"
                       ScrollViewer.HorizontalScrollBarVisibility="{Binding WrapLines, Converter={x:Static vm:Converters.ScrollUnlessWrapped}}" />
            </Grid>
          </Grid>
        </TabItem>
      </TabControl>
    </Panel>

    <!-- Confirms a copy, then fades out. -->
    <Border Classes="toast" Classes.show="{Binding CopyNote.IsVisible}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
            Margin="0,0,16,16" IsHitTestVisible="False">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <LucideIcon Kind="Check" Size="13" VerticalAlignment="Center" Foreground="{DynamicResource AddFgBrush}" />
        <TextBlock Classes="small" Text="{Binding CopyNote.Text}" VerticalAlignment="Center" />
      </StackPanel>
    </Border>

    <!-- Panel actions on the right of the tab strip, as in VS Code. -->
    <StackPanel Orientation="Horizontal" Spacing="2" Height="34" Margin="0,0,8,0"
                HorizontalAlignment="Right" VerticalAlignment="Top">
      <Button Classes="ghost" Command="{Binding ToggleMaximizeCommand}" ToolTip.Tip="{Binding Tips[MaximizePanel], Source={x:Static svc:ShortcutService.Instance}}" IsVisible="{Binding !IsMaximized}">
        <LucideIcon Kind="ChevronUp" Size="14" />
      </Button>
      <Button Classes="ghost" Command="{Binding ToggleMaximizeCommand}" ToolTip.Tip="Restore panel size" IsVisible="{Binding IsMaximized}">
        <LucideIcon Kind="ChevronDown" Size="14" />
      </Button>
      <Button Classes="ghost" Command="{Binding ClosePanelCommand}" ToolTip.Tip="{Binding Tips[TogglePanel], Source={x:Static svc:ShortcutService.Instance}, StringFormat='Hide panel. {0}'}">
        <LucideIcon Kind="X" Size="14" />
      </Button>
    </StackPanel>
  </Panel>
</UserControl>
