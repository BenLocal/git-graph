<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI"
        xmlns:ctl="using:GitGraph.App.Controls">

  <Styles.Resources>
    <!-- An item of a "Custom commands" submenu: its name, and running it (a CustomCommandItem) -->
    <ControlTheme x:Key="CustomCommandItem" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
      <Setter Property="Header" Value="{ReflectionBinding Name}" />
      <Setter Property="Command" Value="{ReflectionBinding Run}" />
    </ControlTheme>
    <!-- A radio item of an Author avatars submenu (an AvatarStyleItem); the radio group spans the submenus -->
    <ControlTheme x:Key="AvatarStyleItem" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
      <Setter Property="Header" Value="{ReflectionBinding Name}" />
      <Setter Property="ToggleType" Value="Radio" />
      <Setter Property="IsChecked" Value="{ReflectionBinding IsChecked, Mode=OneWay}" />
      <Setter Property="Command" Value="{ReflectionBinding Select}" />
      <Setter Property="CommandParameter" Value="{ReflectionBinding Id}" />
    </ControlTheme>
  </Styles.Resources>

  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource CanvasBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>
  <Style Selector="TextBlock">
    <Setter Property="FontWeight" Value="Normal" />
  </Style>

  <!-- Icons: Lucide (lucide.dev), 16 px by default, a slightly lighter stroke than Lucide's 2 to suit the thin UI -->
  <Style Selector="LucideIcon">
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    <Setter Property="Size" Value="16" />
    <Setter Property="StrokeWidth" Value="1.8" />
  </Style>

  <!-- Text roles -->
  <Style Selector="TextBlock.muted, SelectableTextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
  </Style>
  <Style Selector="TextBlock.small">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
  </Style>
  <Style Selector="TextBlock.mono, SelectableTextBlock.mono">
    <Setter Property="FontFamily" Value="{StaticResource CodeFont}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
  </Style>
  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeTitle}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <!-- Sidebar section heading: sentence case, quiet. -->
  <Style Selector="TextBlock.section">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
  </Style>

  <!-- Disclosure chevrons point down when open and rotate when they change. -->
  <Style Selector="LucideIcon.chevron">
    <Setter Property="RenderTransform" Value="rotate(0deg)" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="LucideIcon.chevron.collapsed">
    <Setter Property="RenderTransform" Value="rotate(-90deg)" />
  </Style>

  <!-- Pull/push counts: the signal colour, because they say "your branch has moved" -->
  <Style Selector="TextBlock.sync">
    <Setter Property="Foreground" Value="{DynamicResource SignalBrush}" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <!-- Counts a periodic fetch just raised, until the repository is opened -->
  <Style Selector="TextBlock.sync.fresh">
    <Setter Property="Background" Value="{DynamicResource SignalWashBrush}" />
    <Setter Property="Padding" Value="4,0" />
  </Style>
  <!-- The sync icon turns while a fetch, pull or push runs, and only then. -->
  <Style Selector="LucideIcon.sync.spinning">
    <Style.Animations>
      <Animation Duration="0:0:1" IterationCount="INFINITE">
        <KeyFrame Cue="0%">
          <Setter Property="RotateTransform.Angle" Value="0" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="RotateTransform.Angle" Value="360" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- A keyboard shortcut drawn as key caps -->
  <Style Selector="Border.keycap">
    <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RuleBrush}" />
    <Setter Property="BorderThickness" Value="1,1,1,2" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Padding" Value="7,2" />
  </Style>
  <Style Selector="Border.keycap TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource CodeFont}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
  </Style>
  <Style Selector="Border.keycap.large">
    <Setter Property="Padding" Value="16,8" />
  </Style>
  <Style Selector="Border.keycap.large TextBlock">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeLarge}" />
  </Style>
  <!-- A command whose shortcut differs from the default -->
  <Style Selector="TextBlock.changed">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- The slider is easier to find while the pointer is over the area it scrolls, as in VS Code. -->
  <Style Selector="ScrollViewer:pointerover /template/ ScrollBar">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="ScrollViewer /template/ ScrollBar">
    <Setter Property="Opacity" Value="0.6" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="ProgressBar.share">
    <Setter Property="MinHeight" Value="6" />
    <Setter Property="Height" Value="6" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
  </Style>

  <!--
    The workspace switcher: a compact, quiet row (icon, name, chevron) rather than a form field; it only
    shows a background on hover or while open, and its list uses the same tight rows.
  -->
  <Style Selector="ComboBox.switcher">
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Padding" Value="8,0,6,0" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
    <Style.Resources>
      <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="{DynamicResource HoverWashColor}" />
      <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="{DynamicResource HoverWashColor}" />
      <SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="Transparent" />
      <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="Transparent" />
      <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="Transparent" />
      <SolidColorBrush x:Key="ComboBoxDropDownGlyphForeground" Color="{DynamicResource MutedColor}" />
    </Style.Resources>
  </Style>
  <Style Selector="ComboBox.switcher:dropdownopen /template/ Border#Background">
    <Setter Property="Background" Value="{DynamicResource HoverWashBrush}" />
  </Style>
  <Style Selector="ComboBox.switcher ComboBoxItem">
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="10,4" />
  </Style>

  <!-- Buttons: PART_Bg does not bind TemplateBinding Background/BorderBrush so ShadUI's default Button states never bleed through -->
  <Style Selector="Button.ghost">
    <Setter Property="Padding" Value="6" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Bg"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <Border.Transitions>
            <Transitions>
              <BrushTransition Property="Background" Duration="0:0:0.12" />
            </Transitions>
          </Border.Transitions>
          <ContentPresenter Name="PART_ContentPresenter"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Button.ghost /template/ Border#PART_Bg">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.ghost:pointerover /template/ Border#PART_Bg">
    <Setter Property="Background" Value="{DynamicResource HoverWashBrush}" />
  </Style>
  <Style Selector="Button.ghost:pressed /template/ Border#PART_Bg">
    <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
  </Style>
  <Style Selector="Button.ghost:focus-visible /template/ Border#PART_Bg">
    <Setter Property="BorderBrush" Value="{DynamicResource SignalBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Button.ghost:disabled /template/ Border#PART_Bg">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="Button.ghost:focus /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="ToggleButton.ghost">
    <Setter Property="Padding" Value="6" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Bg"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <Border.Transitions>
            <Transitions>
              <BrushTransition Property="Background" Duration="0:0:0.12" />
            </Transitions>
          </Border.Transitions>
          <ContentPresenter Name="PART_ContentPresenter"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="ToggleButton.ghost /template/ Border#PART_Bg">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="ToggleButton.ghost:pointerover /template/ Border#PART_Bg">
    <Setter Property="Background" Value="{DynamicResource HoverWashBrush}" />
  </Style>
  <Style Selector="ToggleButton.ghost:pressed /template/ Border#PART_Bg">
    <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
  </Style>
  <Style Selector="ToggleButton.ghost:checked /template/ Border#PART_Bg">
    <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
  </Style>
  <Style Selector="ToggleButton.ghost:focus-visible /template/ Border#PART_Bg">
    <Setter Property="BorderBrush" Value="{DynamicResource SignalBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="ToggleButton.ghost:disabled /template/ Border#PART_Bg">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ToggleButton.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="ToggleButton.ghost:focus /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="Button.ghost:pointerover LucideIcon">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="ToggleButton.ghost:checked LucideIcon">
    <Setter Property="Foreground" Value="{DynamicResource SignalBrush}" />
  </Style>
  <!-- A button that can't act right now looks it -->
  <Style Selector="Button.ghost:disabled LucideIcon">
    <Setter Property="Opacity" Value="0.35" />
  </Style>
  <Style Selector="ToggleButton.ghost:disabled LucideIcon">
    <Setter Property="Opacity" Value="0.35" />
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
  </Style>
  <Style Selector="Button.text">
    <Setter Property="Padding" Value="10,5" />
  </Style>

  <!-- GitHub's buttons: green for the main action, a bordered grey one for the rest -->
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="14,7" />
  </Style>
  <!-- ShadUI's Button template fades in its own Border#HoverBackground (near white in Light) on hover, so colour that layer -->
  <Style Selector="Button.primary:pointerover /template/ Border#HoverBackground">
    <Setter Property="Background" Value="{DynamicResource PrimaryHoverBrush}" />
  </Style>
  <Style Selector="Button.primary.danger">
    <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.primary.danger:pointerover /template/ Border#HoverBackground">
    <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
    <Setter Property="Opacity" Value="0.9" />
  </Style>
  <Style Selector="Button.secondary">
    <Setter Property="Background" Value="{DynamicResource ButtonBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RuleBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="14,6" />
  </Style>
  <Style Selector="Button.secondary:pointerover /template/ Border#HoverBackground">
    <Setter Property="Background" Value="{DynamicResource ButtonHoverBrush}" />
  </Style>

  <Style Selector="Button.Outline">
    <Setter Property="FontWeight" Value="Normal" />
  </Style>
  <Style Selector="Button.Ghost">
    <Setter Property="FontWeight" Value="Normal" />
  </Style>
  <Style Selector="Button.Secondary">
    <Setter Property="FontWeight" Value="Normal" />
  </Style>

  <!-- Inputs -->
  <!-- Field colours and sizes live in Fields.axaml; shape and type here. -->
  <Style Selector="TextBox">
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="shadui:ControlAssist.MinHeight" Value="30" />
    <Setter Property="Padding" Value="10,4,10,4" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBox[AcceptsReturn=False]">
    <Setter Property="Height" Value="30" />
    <Setter Property="shadui:ControlAssist.Height" Value="30" />
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="shadui:ControlAssist.MinHeight" Value="30" />
    <Setter Property="shadui:ControlAssist.Height" Value="30" />
    <Setter Property="Padding" Value="10,0,8,0" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <!-- An open dropdown keeps the signal border, like a focused text box. -->
  <Style Selector="ComboBox:dropdownopen /template/ Border#Background">
    <Setter Property="BorderBrush" Value="{DynamicResource SignalBrush}" />
  </Style>
  <Style Selector="TextBox.find">
    <Setter Property="Padding" Value="30,4,8,4" />
  </Style>

  <!-- Sidebar navigation rows: flat pill with left accent indicator when active -->
  <Style Selector="Button.nav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="8,5,8,5" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Bg"
                Background="{TemplateBinding Background}"
                CornerRadius="{TemplateBinding CornerRadius}">
          <Border.Transitions>
            <Transitions>
              <BrushTransition Property="Background" Duration="0:0:0.12" />
            </Transitions>
          </Border.Transitions>
          <Panel>
            <Border Name="PART_Indicator"
                    Width="2.5" Height="14" CornerRadius="2"
                    HorizontalAlignment="Left" VerticalAlignment="Center"
                    Margin="2,0,0,0"
                    Background="{DynamicResource SignalBrush}"
                    Opacity="0" />
            <ContentPresenter Name="PART_ContentPresenter"
                              Margin="{TemplateBinding Padding}"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="Center" />
          </Panel>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Button.nav:pointerover">
    <Setter Property="Background" Value="{DynamicResource HoverWashBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="Button.nav.active">
    <Setter Property="Background" Value="{DynamicResource TabFillBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="Button.nav.active:pointerover">
    <Setter Property="Background" Value="{DynamicResource TabFillBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="Button.nav.active /template/ Border#PART_Indicator">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="Button.nav.active TextBlock.name">
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>

  <!-- Flat borderless file explorer tree -->
  <Style Selector="TreeView.files">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="6,4" />
  </Style>
  <Style Selector="TreeView.files TreeViewItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel>
          <Border Name="PART_LayoutRoot"
                  Background="Transparent"
                  BorderThickness="0"
                  CornerRadius="6"
                  MinHeight="{TemplateBinding MinHeight}"
                  Padding="4,0,6,0"
                  Cursor="Hand">
            <Grid ColumnDefinitions="18,*">
              <ToggleButton Name="PART_ExpandCollapseChevron"
                            Grid.Column="0"
                            IsChecked="{TemplateBinding IsExpanded, Mode=TwoWay}"
                            IsVisible="{TemplateBinding ItemCount, Converter={x:Static ObjectConverters.NotEqual}, ConverterParameter=0}"
                            Focusable="False"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            Width="16" Height="16"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                <ToggleButton.Template>
                  <ControlTemplate>
                    <Border Background="Transparent" Width="16" Height="16">
                      <Path Name="PART_ChevronPath"
                            Data="M 6,4 L 10,8 L 6,12"
                            Stroke="{DynamicResource MutedBrush}"
                            StrokeThickness="1.5"
                            StrokeLineCap="Round"
                            StrokeJoin="Round"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center" />
                    </Border>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <ContentPresenter Name="PART_HeaderPresenter"
                                Grid.Column="1"
                                Content="{TemplateBinding Header}"
                                ContentTemplate="{TemplateBinding HeaderTemplate}"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Stretch" />
            </Grid>
          </Border>
          <ItemsPresenter Name="PART_ItemsPresenter"
                          IsVisible="{TemplateBinding IsExpanded}"
                          ItemsPanel="{TemplateBinding ItemsPanel}"
                          Margin="14,0,0,0" />
        </StackPanel>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="TreeView.files TreeViewItem /template/ ToggleButton#PART_ExpandCollapseChevron:checked /template/ Path#PART_ChevronPath">
    <Setter Property="RenderTransform" Value="rotate(90deg)" />
  </Style>
  <Style Selector="TreeView.files TreeViewItem /template/ Border#PART_LayoutRoot:pointerover">
    <Setter Property="Background" Value="{DynamicResource HoverWashBrush}" />
  </Style>
  <Style Selector="TreeView.files TreeViewItem:selected /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource SignalWashBrush}" />
  </Style>
  <Style Selector="TreeView.files TreeViewItem:selected /template/ Border#PART_LayoutRoot:pointerover">
    <Setter Property="Background" Value="{DynamicResource SignalWashBrush}" />
  </Style>

  <!-- The sheet that holds the open repository, flush edge-to-edge like Winc's editor canvas -->
  <Style Selector="Border.sheet">
    <Setter Property="Background" Value="{DynamicResource CanvasBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <!-- Menu rows: body size, normal font weight, rounded hover pills inside the overlay's padding -->
  <Style Selector="AccessText">
    <Setter Property="FontWeight" Value="Normal" />
  </Style>
  <Style Selector="ContextMenu">
    <Setter Property="FontWeight" Value="Normal" />
  </Style>
  <Style Selector="MenuFlyoutPresenter">
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Background" Value="{DynamicResource OverlayBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RuleBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="4" />
  </Style>
  <Style Selector="MenuItem">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>
  <Style Selector="MenuItem /template/ AccessText">
    <Setter Property="FontWeight" Value="Normal" />
  </Style>
  <Style Selector="MenuItem /template/ ContentPresenter">
    <Setter Property="FontWeight" Value="Normal" />
  </Style>
  <Style Selector="Separator">
    <Setter Property="Background" Value="{DynamicResource RuleBrush}" />
  </Style>
  <!-- Actions that destroy work (drop, delete, hard reset, discard) read in Primer's danger red, on a red wash on hover -->
  <Style Selector="MenuItem.danger">
    <Setter Property="Foreground" Value="{DynamicResource DelFgBrush}" />
  </Style>
  <Style Selector="MenuItem.danger:pointerover /template/ ContentPresenter#PART_HeaderPresenter">
    <Setter Property="Foreground" Value="{DynamicResource DelFgBrush}" />
  </Style>
  <Style Selector="MenuItem.danger:pointerover /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource DelBgBrush}" />
  </Style>
  <Style Selector="MenuItem.danger:selected /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource DelBgBrush}" />
  </Style>
  <!-- Tooltips: high-contrast overlay surface -->
  <Style Selector="ToolTip">
    <Setter Property="Background" Value="{DynamicResource OverlayBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RuleBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>
  <!-- Checkboxes: GitHub's 16 px box instead of Fluent's 20 px, at body size, the label 8 px from the box.
       Fluent's template sets the box and glyph sizes itself, which outranks a plain style; the always-true
       [IsVisible=True] condition makes these setters triggers, which outrank the template. -->
  <Style Selector="CheckBox">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Padding" Value="6,0,0,0" />
  </Style>
  <Style Selector="CheckBox[IsVisible=True] /template/ Border#NormalRectangle">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>
  <Style Selector="CheckBox[IsVisible=True] /template/ Viewbox">
    <Setter Property="Width" Value="12" />
    <Setter Property="Height" Value="12" />
  </Style>
  <Style Selector="ToggleButton.bar">
    <Setter Property="Padding" Value="5" />
  </Style>

  <!-- Rows nested under a sidebar row (a folder's worktrees), with a faint guide line on the left -->
  <Style Selector="Border.nest">
    <Setter Property="Margin" Value="26,0,0,2" />
    <Setter Property="Padding" Value="6,0,0,0" />
    <Setter Property="BorderThickness" Value="1,0,0,0" />
    <Setter Property="BorderBrush" Value="{DynamicResource RuleBrush}" />
  </Style>

  <!-- Row buttons that only show on hover, like the remove button on a sidebar folder -->
  <Style Selector="Button.nav Button.hover">
    <Setter Property="Opacity" Value="0" />
  </Style>
  <Style Selector="Button.nav:pointerover Button.hover">
    <Setter Property="Opacity" Value="1" />
  </Style>

  <!-- Repository tabs: Winc-style pill tabs (26 px tall, 8 px radius, 4 px gap, solid fill when active). -->
  <Style Selector="ListBox.tabs">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.tabs ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,0,2,0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Height" Value="26" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <DockPanel>
          <Border Name="PART_Divider" DockPanel.Dock="Left" Width="1" Height="14" VerticalAlignment="Center"
                  Margin="0,0,2,0" Background="{DynamicResource TabDividerBrush}" />
          <ContentPresenter Name="PART_ContentPresenter"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Content="{TemplateBinding Content}"
                            Padding="{TemplateBinding Padding}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" />
        </DockPanel>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="ListBox.tabs ListBoxItem:nth-child(1) /template/ Border#PART_Divider, ListBox.tabs ListBoxItem:selected /template/ Border#PART_Divider, ListBox.tabs ListBoxItem:pointerover /template/ Border#PART_Divider">
    <Setter Property="Opacity" Value="0" />
  </Style>
  <Style Selector="ListBox.tabs ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="ListBox.tabs ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverWashBrush}" />
  </Style>
  <Style Selector="ListBox.tabs ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource TabFillBrush}" />
  </Style>
  <Style Selector="ListBox.tabs ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource TabFillBrush}" />
  </Style>
  <Style Selector="ListBox.tabs ListBoxItem TextBlock.name">
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
  </Style>
  <!-- Italic glyphs lean past the text's advance width and the trimming TextBlock clips them, cutting off the
       last letter; the padding gives the lean room and the negative margin keeps the tab's width. -->
  <Style Selector="ListBox.tabs ListBoxItem TextBlock.name.preview">
    <Setter Property="FontStyle" Value="Italic" />
    <Setter Property="Padding" Value="0,0,3,0" />
    <Setter Property="Margin" Value="0,0,-3,0" />
  </Style>
  <Style Selector="ListBox.tabs ListBoxItem:selected TextBlock.name">
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="ListBox.tabs ListBoxItem Button.close">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Opacity" Value="0" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="ListBox.tabs ListBoxItem:selected Button.close, ListBox.tabs ListBoxItem:pointerover Button.close">
    <Setter Property="Opacity" Value="1" />
  </Style>

  <!-- Details and history pane tabs: Winc-style pill tabs over a 1 px bottom rule. -->
  <Style Selector="TabControl.pane">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <StackPanel Orientation="Horizontal" />
      </ItemsPanelTemplate>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <DockPanel>
          <Border DockPanel.Dock="Top" Height="36" Padding="10,5"
                  BorderBrush="{DynamicResource RuleBrush}" BorderThickness="0,0,0,1"
                  Background="Transparent">
            <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
          </Border>
          <ContentPresenter Name="PART_SelectedContentHost"
                            Content="{TemplateBinding SelectedContent}"
                            ContentTemplate="{TemplateBinding SelectedContentTemplate}" />
        </DockPanel>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="TabControl.pane TabItem">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
    <Setter Property="Height" Value="26" />
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="Margin" Value="0,0,4,0" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Pill"
                Background="{TemplateBinding Background}"
                CornerRadius="8"
                Height="26"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter Name="PART_ContentPresenter"
                            Content="{TemplateBinding Header}"
                            ContentTemplate="{TemplateBinding HeaderTemplate}"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="TabControl.pane TabItem:pointerover">
    <Setter Property="Background" Value="{DynamicResource HoverWashBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="TabControl.pane TabItem:selected">
    <Setter Property="Background" Value="{DynamicResource TabFillBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="TabControl.pane TabItem:selected:pointerover">
    <Setter Property="Background" Value="{DynamicResource TabFillBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <!-- File count next to the Changes tab label. -->
  <Style Selector="Border.count">
    <Setter Property="Background" Value="{DynamicResource HoverWashBrush}" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="MinWidth" Value="18" />
  </Style>
  <Style Selector="Border.count TextBlock">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>

  <!-- A short confirmation that rises in and fades out on its own. -->
  <Style Selector="Border.toast">
    <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RuleBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="BoxShadow" Value="0 4 12 0 #26000000" />
    <Setter Property="Opacity" Value="0" />
    <Setter Property="RenderTransform" Value="translateY(6px)" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.18" />
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.toast.show">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="RenderTransform" Value="translateY(0px)" />
  </Style>

  <!-- Code navigation results over the code viewer, raised like the toast. -->
  <Style Selector="Border.peek">
    <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RuleBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="BoxShadow" Value="0 4 12 0 #26000000" />
  </Style>

  <!-- Dense lists: commit graph, file changes, diff -->
  <Style Selector="ListBox.dense">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.dense ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter Name="PART_ContentPresenter"
                          Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          CornerRadius="{TemplateBinding CornerRadius}"
                          ContentTemplate="{TemplateBinding ContentTemplate}"
                          Content="{TemplateBinding Content}"
                          Padding="{TemplateBinding Padding}"
                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" />
      </ControlTemplate>
    </Setter>
  </Style>
  <!-- Rounded, inset selection for the commit and file lists. -->
  <Style Selector="ListBox.pills ListBoxItem">
    <Setter Property="Margin" Value="6,0" />
  </Style>
  <Style Selector="ListBox.pills ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="ListBox.dense ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverWashBrush}" />
  </Style>
  <Style Selector="ListBox.dense ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SignalWashBrush}" />
  </Style>
  <Style Selector="ListBox.dense ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SignalWashBrush}" />
  </Style>
  <Style Selector="ListBox.dense ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SignalWashBrush}" />
  </Style>
  <!-- Stage / Unstage / Discard on a hunk header: small, so the row keeps its height -->
  <Style Selector="Button.hunkaction">
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
  </Style>

  <!-- Image diffs: each side on a raised panel, so transparent images show their edges -->
  <Style Selector="Border.imageframe">
    <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="12" />
  </Style>

  <!-- Sidebar section headings: the whole heading folds its section -->
  <Style Selector="Button.sectionhead">
    <Setter Property="Padding" Value="4,3" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
  </Style>

  <!-- Rows of the uncommitted changes list, which isn't a ListBox: hover and selection look the same as one -->
  <Style Selector="Border.filerow">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Margin" Value="6,0" />
    <Setter Property="Height" Value="24" />
  </Style>
  <Style Selector="Border.filerow:pointerover">
    <Setter Property="Background" Value="{DynamicResource HoverWashBrush}" />
  </Style>
  <Style Selector="Border.filerow.selected">
    <Setter Property="Background" Value="{DynamicResource SignalWashBrush}" />
  </Style>
  <Style Selector="Border.filerow StackPanel.rowactions">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="Border.filerow:pointerover StackPanel.rowactions">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <Style Selector="Border.filerow:pointerover StackPanel.counts">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="ListBox.plain ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter, ListBox.plain ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- Commit rows -->
  <Style Selector="Grid.commit">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Grid.commit TextBlock.subject">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="Grid.commit.uncommitted TextBlock.subject">
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    <Setter Property="FontStyle" Value="Italic" />
  </Style>
  <Style Selector="Grid.commit.stash TextBlock.subject">
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
  </Style>
  <Style Selector="Grid.commit.match TextBlock.subject">
    <Setter Property="Foreground" Value="{DynamicResource SignalBrush}" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <!-- Another branch is highlighted: commits that don't lead to it fade -->
  <Style Selector="Grid.commit.dimmed">
    <Setter Property="Opacity" Value="0.28" />
  </Style>
  <Style Selector="Grid.commit.compare">
    <Setter Property="Background" Value="{DynamicResource SignalWashBrush}" />
  </Style>
  <!-- Commits selected together with Shift+click -->
  <Style Selector="Grid.commit.inrange">
    <Setter Property="Background" Value="{DynamicResource SignalWashBrush}" />
  </Style>

  <!--
    Ref labels: pills like GitHub's labels, filled with the commit's lane colour, dark text and icon on it (a branch, tag or cloud icon
    first), a local branch and its remote copies in one label ("main │ origin"), the checked-out branch bold.
    Worktree labels are neutral: they mark a checkout, not a ref.
  -->
  <Style Selector="Border.badge">
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Height" Value="18" />
    <Setter Property="Background" Value="{ReflectionBinding LaneBrush}" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Border.badge TextBlock">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource OnLaneBrush}" />
  </Style>
  <Style Selector="Border.badge.current TextBlock.name">
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="Border.badge Border.refblock">
    <Setter Property="Width" Value="20" />
    <Setter Property="Padding" Value="6,2,0,2" />
  </Style>
  <Style Selector="Border.badge Border.refblock LucideIcon">
    <Setter Property="Foreground" Value="{DynamicResource OnLaneBrush}" />
    <Setter Property="Size" Value="12" />
    <Setter Property="StrokeWidth" Value="2.4" />
  </Style>
  <Style Selector="Border.badge Border.remote">
    <Setter Property="BorderThickness" Value="1,0,0,0" />
    <Setter Property="BorderBrush" Value="#59000000" />
    <Setter Property="Padding" Value="5,0" />
  </Style>
  <Style Selector="Border.badge Border.remote TextBlock">
    <Setter Property="FontStyle" Value="Italic" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Opacity" Value="0.8" />
  </Style>
  <Style Selector="Border.badge.wt">
    <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
  </Style>
  <Style Selector="Border.badge.wt TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>
  <Style Selector="Border.badge.wt Border.refblock LucideIcon">
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
  </Style>
  <!-- A stash is not a ref of the graph's lanes: quiet, like a worktree label -->
  <Style Selector="Border.badge.stash">
    <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
  </Style>
  <Style Selector="Border.badge.stash TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>
  <Style Selector="Border.badge.stash Border.refblock LucideIcon">
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
  </Style>

  <!-- File status letters -->
  <Style Selector="TextBlock.status">
    <Setter Property="FontFamily" Value="{StaticResource CodeFont}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Width" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
  </Style>
  <Style Selector="TextBlock.status.added">
    <Setter Property="Foreground" Value="{DynamicResource AddFgBrush}" />
  </Style>
  <Style Selector="TextBlock.status.deleted">
    <Setter Property="Foreground" Value="{DynamicResource DelFgBrush}" />
  </Style>
  <Style Selector="TextBlock.add">
    <Setter Property="Foreground" Value="{DynamicResource AddFgBrush}" />
  </Style>
  <Style Selector="TextBlock.del">
    <Setter Property="Foreground" Value="{DynamicResource DelFgBrush}" />
  </Style>

  <!-- Diff lines. The code wraps unless the list has the nowrap class (View → Wrap long lines in diffs). -->
  <Style Selector="SelectableTextBlock.code">
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="ListBox.nowrap SelectableTextBlock.code">
    <Setter Property="TextWrapping" Value="NoWrap" />
  </Style>
  <Style Selector="Grid.diffline TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource CodeFont}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeCode}" />
    <Setter Property="LineHeight" Value="{DynamicResource DiffLineHeight}" />
  </Style>
  <Style Selector="Grid.diffline SelectableTextBlock">
    <Setter Property="FontFamily" Value="{StaticResource CodeFont}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeCode}" />
    <Setter Property="LineHeight" Value="{DynamicResource DiffLineHeight}" />
  </Style>
  <Style Selector="Grid.diffline TextBlock.lineno">
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    <Setter Property="TextAlignment" Value="Right" />
    <Setter Property="Opacity" Value="0.75" />
    <Setter Property="Margin" Value="0,0,8,0" />
  </Style>
  <!-- Blame: the commit column, shaded in alternate runs, with the commit named on each run's first line -->
  <Style Selector="Border.blame">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource RuleBrush}" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Border.blame.odd">
    <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
  </Style>
  <Style Selector="Border.blame.start">
    <Setter Property="BorderThickness" Value="0,1,1,0" />
  </Style>
  <Style Selector="Border.blame:pointerover">
    <Setter Property="Background" Value="{DynamicResource HoverWashBrush}" />
  </Style>
  <Style Selector="Border.blame TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
  </Style>
  <Style Selector="Grid.diffline.add">
    <Setter Property="Background" Value="{DynamicResource AddBgBrush}" />
  </Style>
  <Style Selector="Border.cell.add">
    <Setter Property="Background" Value="{DynamicResource AddBgBrush}" />
  </Style>
  <Style Selector="Grid.diffline.del">
    <Setter Property="Background" Value="{DynamicResource DelBgBrush}" />
  </Style>
  <Style Selector="Border.cell.del">
    <Setter Property="Background" Value="{DynamicResource DelBgBrush}" />
  </Style>
  <Style Selector="Grid.diffline.add TextBlock.sign">
    <Setter Property="Foreground" Value="{DynamicResource AddFgBrush}" />
  </Style>
  <Style Selector="Grid.diffline.del TextBlock.sign">
    <Setter Property="Foreground" Value="{DynamicResource DelFgBrush}" />
  </Style>
  <Style Selector="Grid.diffline.hunk">
    <Setter Property="Background" Value="{DynamicResource HunkBgBrush}" />
  </Style>
  <Style Selector="Border.hunk">
    <Setter Property="Background" Value="{DynamicResource HunkBgBrush}" />
  </Style>
  <Style Selector="Grid.diffline.hunk TextBlock, Border.hunk TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource HunkFgBrush}" />
  </Style>
  <Style Selector="Grid.diffline.hunk SelectableTextBlock">
    <Setter Property="Foreground" Value="{DynamicResource HunkFgBrush}" />
  </Style>
  <!-- Picking lines of an uncommitted hunk: the line-number gutter is a toggle; a picked line gets a signal bar -->
  <Style Selector="ToggleButton.linepick">
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="BorderThickness" Value="3,0,0,0" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="ToggleButton.linepick:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SignalWashBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SignalBrush}" />
  </Style>
  <!-- Review comments: an add button that shows on the hovered line, and the comments under their lines -->
  <Style Selector="Button.commentadd">
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource SignalBrush}" />
    <Setter Property="Opacity" Value="0" />
  </Style>
  <Style Selector="Grid.diffline:pointerover Button.commentadd">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="Grid.diffline.commentable:pointerover TextBlock.sign">
    <Setter Property="Opacity" Value="0" />
  </Style>
  <Style Selector="Border.comment">
    <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RuleBrush}" />
    <Setter Property="BorderThickness" Value="3,1,1,1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="MaxWidth" Value="720" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>
  <Style Selector="Border.comment.mine">
    <Setter Property="BorderBrush" Value="{DynamicResource SignalBrush}" />
  </Style>
  <Style Selector="Border.cell.empty">
    <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
    <Setter Property="Opacity" Value="0.5" />
  </Style>
  <!-- Lines selected for copying (DiffLineCopy) take the editor's selection colour; after the add and delete washes so
       they win. A side-by-side row highlights only the side being copied. -->
  <Style Selector="ListBox.copylines ListBoxItem:selected StackPanel > Grid.diffline">
    <Setter Property="Background" Value="{DynamicResource EditorSelectionBrush}" />
  </Style>
  <Style Selector="ListBox.copyleft ListBoxItem:selected Border.cell.left">
    <Setter Property="Background" Value="{DynamicResource EditorSelectionBrush}" />
  </Style>
  <Style Selector="ListBox.copyright ListBoxItem:selected Border.cell.right">
    <Setter Property="Background" Value="{DynamicResource EditorSelectionBrush}" />
  </Style>

  <Style Selector="GridSplitter">
    <Setter Property="Background" Value="{DynamicResource RuleBrush}" />
    <Setter Property="MinWidth" Value="1" />
    <Setter Property="MinHeight" Value="1" />
  </Style>
  <Style Selector="GridSplitter:pointerover">
    <Setter Property="Background" Value="{DynamicResource SignalBrush}" />
  </Style>
</Styles>
