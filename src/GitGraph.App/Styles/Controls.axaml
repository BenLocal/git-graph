<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="using:GitGraph.App.Controls">

  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource CanvasBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
  </Style>

  <Style Selector="ctl|IconView">
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
  </Style>

  <!-- Text roles -->
  <Style Selector="TextBlock.muted, SelectableTextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
  </Style>
  <Style Selector="TextBlock.small">
    <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
  </Style>
  <Style Selector="TextBlock.mono, SelectableTextBlock.mono">
    <Setter Property="FontFamily" Value="{StaticResource CodeFont}" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="{StaticResource FontSizeTitle}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <!-- Sidebar section heading: sentence case, quiet. -->
  <Style Selector="TextBlock.section">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
  </Style>

  <!-- Disclosure chevrons point down when open and rotate when they change. -->
  <Style Selector="ctl|IconView.chevron">
    <Setter Property="RenderTransform" Value="rotate(0deg)" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="ctl|IconView.chevron.collapsed">
    <Setter Property="RenderTransform" Value="rotate(-90deg)" />
  </Style>
  <Style Selector="ctl|IconView.chevron.flipped">
    <Setter Property="RenderTransform" Value="rotate(180deg)" />
  </Style>

  <!-- Pull/push counts: the signal colour, because they say "your branch has moved" -->
  <Style Selector="TextBlock.sync">
    <Setter Property="Foreground" Value="{DynamicResource SignalBrush}" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <!-- The sync icon turns while a pull or push runs, and only then. -->
  <Style Selector="ctl|IconView.sync.spinning">
    <Style.Animations>
      <Animation Duration="0:0:1" IterationCount="INFINITE">
        <KeyFrame Cue="0%">
          <Setter Property="RotateTransform.Angle" Value="0" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="RotateTransform.Angle" Value="360" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- A keyboard shortcut drawn as key caps -->
  <Style Selector="Border.keycap">
    <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RuleBrush}" />
    <Setter Property="BorderThickness" Value="1,1,1,2" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Padding" Value="7,2" />
  </Style>
  <Style Selector="Border.keycap TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource CodeFont}" />
    <Setter Property="FontSize" Value="11.5" />
  </Style>
  <Style Selector="Border.keycap.large">
    <Setter Property="Padding" Value="16,8" />
  </Style>
  <Style Selector="Border.keycap.large TextBlock">
    <Setter Property="FontSize" Value="17" />
  </Style>
  <!-- A command whose shortcut differs from the default -->
  <Style Selector="TextBlock.changed">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- The slider is easier to find while the pointer is over the area it scrolls, as in VS Code. -->
  <Style Selector="ScrollViewer:pointerover /template/ ScrollBar">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="ScrollViewer /template/ ScrollBar">
    <Setter Property="Opacity" Value="0.6" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
  </Style>

  <!-- Buttons -->
  <Style Selector="Button.ghost /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.ghost /template/ ContentPresenter#PART_ContentPresenter, Button.nav /template/ ContentPresenter#PART_ContentPresenter, Button.fold /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.ghost, ToggleButton.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="6" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverWashBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="Button.ghost:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
  </Style>
  <Style Selector="Button.ghost:pointerover ctl|IconView">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="ToggleButton.ghost:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="ToggleButton.ghost:checked ctl|IconView">
    <Setter Property="Foreground" Value="{DynamicResource SignalBrush}" />
  </Style>
  <Style Selector="Button.text">
    <Setter Property="Padding" Value="10,5" />
  </Style>

  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource SignalBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource OnLaneBrush}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="14,7" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SystemAccentColorLight1}" />
    <Setter Property="Foreground" Value="{DynamicResource OnLaneBrush}" />
  </Style>
  <Style Selector="Button.primary.danger">
    <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.primary.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="Opacity" Value="0.9" />
  </Style>
  <Style Selector="Button.secondary">
    <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="14,7" />
  </Style>

  <!-- Inputs -->
  <Style Selector="TextBox, ComboBox">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
  </Style>
  <Style Selector="TextBox.find">
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="28,5,8,5" />
  </Style>

  <!-- Sidebar navigation rows -->
  <Style Selector="Button.nav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverWashBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="Button.nav.active /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SignalWashBrush}" />
  </Style>
  <Style Selector="Button.nav.active TextBlock.name">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- Menu bar -->
  <Style Selector="Border.menubar">
    <Setter Property="Background" Value="{DynamicResource FrameBrush}" />
    <Setter Property="Height" Value="32" />
  </Style>

  <!-- The sheet that holds the open repository, lit above the frame -->
  <Style Selector="Border.sheet">
    <Setter Property="Background" Value="{DynamicResource CanvasBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RuleBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Margin" Value="8,0,8,8" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="BoxShadow" Value="0 6 24 0 #38000000" />
  </Style>
  <Style Selector="Border.menubar Menu > MenuItem">
    <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="Height" Value="31" />
  </Style>
  <Style Selector="ToggleButton.bar">
    <Setter Property="Padding" Value="5" />
  </Style>

  <!-- Row buttons that only show on hover, like the remove button on a sidebar folder -->
  <Style Selector="Button.nav Button.hover">
    <Setter Property="Opacity" Value="0" />
  </Style>
  <Style Selector="Button.nav:pointerover Button.hover">
    <Setter Property="Opacity" Value="1" />
  </Style>

  <!-- Repository tabs: folder tabs on the frame; the selected one takes the sheet's colour and joins it. -->
  <Style Selector="ListBox.tabs">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.tabs ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,0,2,0" />
    <Setter Property="MinHeight" Value="0" />
  </Style>
  <Style Selector="ListBox.tabs ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="8,8,0,0" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="ListBox.tabs ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverWashBrush}" />
  </Style>
  <Style Selector="ListBox.tabs ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource CanvasBrush}" />
  </Style>
  <!-- The signal bar on top of the selected tab grows out from its centre. -->
  <Style Selector="ListBox.tabs ListBoxItem Border.tabline">
    <Setter Property="Background" Value="{DynamicResource SignalBrush}" />
    <Setter Property="Margin" Value="10,0" />
    <Setter Property="CornerRadius" Value="0,0,2,2" />
    <Setter Property="RenderTransform" Value="scaleX(0)" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="ListBox.tabs ListBoxItem:selected Border.tabline">
    <Setter Property="RenderTransform" Value="scaleX(1)" />
  </Style>
  <Style Selector="ListBox.tabs ListBoxItem TextBlock.name">
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
  </Style>
  <Style Selector="ListBox.tabs ListBoxItem TextBlock.name.preview">
    <Setter Property="FontStyle" Value="Italic" />
  </Style>
  <Style Selector="ListBox.tabs ListBoxItem:selected TextBlock.name">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="ListBox.tabs ListBoxItem Button.close">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="ListBox.tabs ListBoxItem:selected Button.close, ListBox.tabs ListBoxItem:pointerover Button.close">
    <Setter Property="Opacity" Value="1" />
  </Style>

  <!-- Details pane tabs: quiet labels, the selected one gets the signal underline like the repository tabs. -->
  <Style Selector="TabControl.pane">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Style.Resources>
      <x:Double x:Key="TabItemHeaderFontSize">13</x:Double>
      <x:Double x:Key="TabItemHeaderPipeThickness">2</x:Double>
      <SolidColorBrush x:Key="TabItemHeaderSelectedPipeFill" Color="{DynamicResource SignalColor}" />
      <SolidColorBrush x:Key="TabItemHeaderForegroundUnselected" Color="{DynamicResource MutedColor}" />
      <SolidColorBrush x:Key="TabItemHeaderForegroundUnselectedPointerOver" Color="{DynamicResource TextColor}" />
      <SolidColorBrush x:Key="TabItemHeaderForegroundUnselectedPressed" Color="{DynamicResource TextColor}" />
      <SolidColorBrush x:Key="TabItemHeaderForegroundSelected" Color="{DynamicResource TextColor}" />
      <SolidColorBrush x:Key="TabItemHeaderForegroundSelectedPointerOver" Color="{DynamicResource TextColor}" />
      <SolidColorBrush x:Key="TabItemHeaderForegroundSelectedPressed" Color="{DynamicResource TextColor}" />
    </Style.Resources>
  </Style>
  <Style Selector="TabControl.pane /template/ ItemsPresenter#PART_ItemsPresenter">
    <Setter Property="Margin" Value="8,0,0,0" />
  </Style>
  <Style Selector="TabControl.pane TabItem">
    <Setter Property="Height" Value="34" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="TabControl.pane TabItem:selected">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <!-- File count next to the Changes tab label. -->
  <Style Selector="Border.count">
    <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="MinWidth" Value="18" />
  </Style>
  <Style Selector="Border.count TextBlock">
    <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>

  <!-- A short confirmation that rises in and fades out on its own. -->
  <Style Selector="Border.toast">
    <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RuleBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="BoxShadow" Value="0 4 14 0 #33000000" />
    <Setter Property="Opacity" Value="0" />
    <Setter Property="RenderTransform" Value="translateY(6px)" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.18" />
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.toast.show">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="RenderTransform" Value="translateY(0px)" />
  </Style>

  <!-- Dense lists: commit graph, file changes, diff -->
  <Style Selector="ListBox.dense">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.dense ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="ListBox.dense ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.1" />
      </Transitions>
    </Setter>
  </Style>
  <!-- Rounded, inset selection for the commit and file lists. -->
  <Style Selector="ListBox.pills ListBoxItem">
    <Setter Property="Margin" Value="6,0" />
  </Style>
  <Style Selector="ListBox.pills ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="ListBox.dense ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverWashBrush}" />
  </Style>
  <Style Selector="ListBox.dense ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SignalWashBrush}" />
  </Style>
  <Style Selector="ListBox.dense ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SignalWashBrush}" />
  </Style>
  <Style Selector="ListBox.dense ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SignalWashBrush}" />
  </Style>
  <Style Selector="ListBox.plain ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter, ListBox.plain ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- Commit rows -->
  <Style Selector="Grid.commit">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Grid.commit TextBlock.subject">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="Grid.commit.uncommitted TextBlock.subject">
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    <Setter Property="FontStyle" Value="Italic" />
  </Style>
  <Style Selector="Grid.commit.match TextBlock.subject">
    <Setter Property="Foreground" Value="{DynamicResource SignalBrush}" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="Grid.commit.compare">
    <Setter Property="Background" Value="{DynamicResource SignalWashBrush}" />
  </Style>

  <!-- Ref badges: route plates in the lane's colour -->
  <Style Selector="Border.badge">
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Padding" Value="5,0" />
    <Setter Property="Height" Value="18" />
    <Setter Property="BorderThickness" Value="1.5" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.badge TextBlock">
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.badge.local">
    <Setter Property="Background" Value="{ReflectionBinding LaneBrush}" />
    <Setter Property="BorderBrush" Value="{ReflectionBinding LaneBrush}" />
  </Style>
  <Style Selector="Border.badge.remote">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{ReflectionBinding LaneBrush}" />
  </Style>
  <Style Selector="Border.badge.local TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource OnLaneBrush}" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="Border.badge.current">
    <Setter Property="BorderBrush" Value="{DynamicResource SignalBrush}" />
  </Style>
  <Style Selector="Border.badge.current TextBlock">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Border.badge.remote TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="Border.badge.tag">
    <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RuleBrush}" />
  </Style>
  <Style Selector="Border.badge.tag TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="Border.badge.wt">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource RuleBrush}" />
  </Style>
  <Style Selector="Border.badge.wt TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
  </Style>

  <!-- File status letters -->
  <Style Selector="TextBlock.status">
    <Setter Property="FontFamily" Value="{StaticResource CodeFont}" />
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Width" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
  </Style>
  <Style Selector="TextBlock.status.added">
    <Setter Property="Foreground" Value="{DynamicResource AddFgBrush}" />
  </Style>
  <Style Selector="TextBlock.status.deleted">
    <Setter Property="Foreground" Value="{DynamicResource DelFgBrush}" />
  </Style>
  <Style Selector="TextBlock.add">
    <Setter Property="Foreground" Value="{DynamicResource AddFgBrush}" />
  </Style>
  <Style Selector="TextBlock.del">
    <Setter Property="Foreground" Value="{DynamicResource DelFgBrush}" />
  </Style>

  <!-- Folded unchanged lines in the full-screen diff -->
  <Style Selector="Button.fold">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Background" Value="{DynamicResource HunkBgBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource HunkFgBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="20,4" />
  </Style>
  <Style Selector="Button.fold:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverWashBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>

  <!-- Diff lines -->
  <Style Selector="Grid.diffline TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource CodeFont}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeCode}" />
    <Setter Property="LineHeight" Value="19" />
  </Style>
  <Style Selector="Grid.diffline SelectableTextBlock">
    <Setter Property="FontFamily" Value="{StaticResource CodeFont}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeCode}" />
    <Setter Property="LineHeight" Value="19" />
  </Style>
  <Style Selector="Grid.diffline TextBlock.lineno">
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    <Setter Property="TextAlignment" Value="Right" />
    <Setter Property="Opacity" Value="0.75" />
    <Setter Property="Margin" Value="0,0,8,0" />
  </Style>
  <Style Selector="Grid.diffline.add">
    <Setter Property="Background" Value="{DynamicResource AddBgBrush}" />
  </Style>
  <Style Selector="Border.cell.add">
    <Setter Property="Background" Value="{DynamicResource AddBgBrush}" />
  </Style>
  <Style Selector="Grid.diffline.del">
    <Setter Property="Background" Value="{DynamicResource DelBgBrush}" />
  </Style>
  <Style Selector="Border.cell.del">
    <Setter Property="Background" Value="{DynamicResource DelBgBrush}" />
  </Style>
  <Style Selector="Grid.diffline.add TextBlock.sign">
    <Setter Property="Foreground" Value="{DynamicResource AddFgBrush}" />
  </Style>
  <Style Selector="Grid.diffline.del TextBlock.sign">
    <Setter Property="Foreground" Value="{DynamicResource DelFgBrush}" />
  </Style>
  <Style Selector="Grid.diffline.hunk">
    <Setter Property="Background" Value="{DynamicResource HunkBgBrush}" />
  </Style>
  <Style Selector="Border.hunk">
    <Setter Property="Background" Value="{DynamicResource HunkBgBrush}" />
  </Style>
  <Style Selector="Grid.diffline.hunk TextBlock, Border.hunk TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource HunkFgBrush}" />
  </Style>
  <Style Selector="Border.cell.empty">
    <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
    <Setter Property="Opacity" Value="0.5" />
  </Style>

  <Style Selector="GridSplitter">
    <Setter Property="Background" Value="{DynamicResource RuleBrush}" />
    <Setter Property="MinWidth" Value="1" />
    <Setter Property="MinHeight" Value="1" />
  </Style>
  <Style Selector="GridSplitter:pointerover">
    <Setter Property="Background" Value="{DynamicResource SignalBrush}" />
  </Style>
</Styles>
