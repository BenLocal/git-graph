<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    Design tokens, after GitHub's Primer: a dark header frame, a plain canvas, 1 px borders, blue for focus and
    selection, green for the main action, a coral underline on the selected tab. The graph's lane colours are the
    one bright thing; everything around them stays in Primer's quiet greys.
  -->
  <!--
    The interface uses the system sans GitHub asks for (Segoe UI on Windows, Noto Sans on Linux), falling back to
    the bundled IBM Plex Sans, with Noto Sans CJK SC for Chinese. Code uses the same fonts as the user's Ghostty
    terminal (Ubuntu Sans Mono, Noto Sans CJK SC, DejaVu Sans Mono), falling back to the bundled IBM Plex Mono.
  -->
  <FontFamily x:Key="UiFont">Segoe UI, Noto Sans, avares://GitGraph/Assets/Fonts#IBM Plex Sans, Noto Sans CJK SC</FontFamily>
  <FontFamily x:Key="CodeFont">Ubuntu Sans Mono, Noto Sans CJK SC, DejaVu Sans Mono, avares://GitGraph/Assets/Fonts#IBM Plex Mono</FontFamily>

  <x:Double x:Key="FontSizeSmall">11.5</x:Double>
  <x:Double x:Key="FontSizeBody">13</x:Double>
  <x:Double x:Key="FontSizeTitle">15</x:Double>
  <x:Double x:Key="FontSizeCode">13</x:Double>
  <x:Double x:Key="FontSizeCaption">12</x:Double>
  <x:Double x:Key="FontSizeLarge">17</x:Double>
  <x:Double x:Key="DiffLineHeight">19</x:Double>
  <x:Double x:Key="RowHeight">26</x:Double>

  <ResourceDictionary.ThemeDictionaries>
    <!-- Primer dark -->
    <ResourceDictionary x:Key="Dark">
      <Color x:Key="FrameColor">#010409</Color>
      <Color x:Key="CanvasColor">#0D1117</Color>
      <Color x:Key="SurfaceColor">#151B23</Color>
      <Color x:Key="RaisedColor">#212830</Color>
      <Color x:Key="RuleColor">#3D444D</Color>
      <Color x:Key="TextColor">#F0F6FC</Color>
      <Color x:Key="MutedColor">#9198A1</Color>
      <Color x:Key="SignalColor">#4493F8</Color>
      <Color x:Key="SignalWashColor">#26388BFD</Color>
      <!-- Selected text in the code viewer, as in VS Code: the text keeps its own colours on it -->
      <Color x:Key="EditorSelectionColor">#264F78</Color>
      <Color x:Key="HoverWashColor">#33656C76</Color>
      <Color x:Key="OnLaneColor">#0D1117</Color>
      <Color x:Key="AddBgColor">#262EA043</Color>
      <Color x:Key="AddWordBgColor">#662EA043</Color>
      <Color x:Key="AddFgColor">#3FB950</Color>
      <Color x:Key="DelBgColor">#1AF85149</Color>
      <Color x:Key="DelWordBgColor">#66F85149</Color>
      <Color x:Key="DelFgColor">#F85149</Color>
      <Color x:Key="HunkBgColor">#1A388BFD</Color>
      <Color x:Key="HunkFgColor">#9198A1</Color>
      <Color x:Key="LinkColor">#4493F8</Color>
      <Color x:Key="ScrollThumbColor">#30FFFFFF</Color>
      <Color x:Key="BadgeFillColor">#14FFFFFF</Color>
      <Color x:Key="FieldColor">#0D1117</Color>
      <!-- Primer's attention, success, danger and severe colours, as GitHub marks changed files -->
      <Color x:Key="GitModifiedColor">#D29922</Color>
      <Color x:Key="GitAddedColor">#3FB950</Color>
      <Color x:Key="GitUntrackedColor">#3FB950</Color>
      <Color x:Key="GitDeletedColor">#F85149</Color>
      <Color x:Key="GitConflictColor">#DB6D28</Color>
      <Color x:Key="ScrollThumbHoverColor">#55FFFFFF</Color>
      <Color x:Key="ScrollThumbActiveColor">#80FFFFFF</Color>
      <Color x:Key="DangerColor">#DA3633</Color>
      <!-- The main action (GitHub's green button) and the selected tab's underline -->
      <Color x:Key="PrimaryColor">#238636</Color>
      <Color x:Key="PrimaryHoverColor">#29903B</Color>
      <Color x:Key="TabLineColor">#F78166</Color>
      <Color x:Key="ButtonColor">#212830</Color>
      <Color x:Key="ButtonHoverColor">#262C36</Color>

      <Color x:Key="SystemAccentColor">#1F6FEB</Color>
      <Color x:Key="SystemAccentColorDark1">#1158C7</Color>
      <Color x:Key="SystemAccentColorLight1">#4493F8</Color>
    </ResourceDictionary>
    <!-- Primer light -->
    <ResourceDictionary x:Key="Light">
      <Color x:Key="FrameColor">#F6F8FA</Color>
      <Color x:Key="CanvasColor">#FFFFFF</Color>
      <Color x:Key="SurfaceColor">#F6F8FA</Color>
      <Color x:Key="RaisedColor">#EFF2F5</Color>
      <Color x:Key="RuleColor">#D1D9E0</Color>
      <Color x:Key="TextColor">#1F2328</Color>
      <Color x:Key="MutedColor">#59636E</Color>
      <Color x:Key="SignalColor">#0969DA</Color>
      <Color x:Key="SignalWashColor">#1F0969DA</Color>
      <Color x:Key="EditorSelectionColor">#ADD6FF</Color>
      <Color x:Key="HoverWashColor">#1F818B98</Color>
      <Color x:Key="OnLaneColor">#11161F</Color>
      <Color x:Key="AddBgColor">#DAFBE1</Color>
      <Color x:Key="AddWordBgColor">#ACEEBB</Color>
      <Color x:Key="AddFgColor">#1A7F37</Color>
      <Color x:Key="DelBgColor">#FFEBE9</Color>
      <Color x:Key="DelWordBgColor">#FFCECB</Color>
      <Color x:Key="DelFgColor">#D1242F</Color>
      <Color x:Key="HunkBgColor">#DDF4FF</Color>
      <Color x:Key="HunkFgColor">#59636E</Color>
      <Color x:Key="LinkColor">#0969DA</Color>
      <Color x:Key="ScrollThumbColor">#2A1C2330</Color>
      <Color x:Key="BadgeFillColor">#0A1C2330</Color>
      <Color x:Key="FieldColor">#FFFFFF</Color>
      <Color x:Key="GitModifiedColor">#9A6700</Color>
      <Color x:Key="GitAddedColor">#1A7F37</Color>
      <Color x:Key="GitUntrackedColor">#1A7F37</Color>
      <Color x:Key="GitDeletedColor">#D1242F</Color>
      <Color x:Key="GitConflictColor">#BC4C00</Color>
      <Color x:Key="ScrollThumbHoverColor">#501C2330</Color>
      <Color x:Key="ScrollThumbActiveColor">#781C2330</Color>
      <Color x:Key="DangerColor">#CF222E</Color>
      <Color x:Key="PrimaryColor">#1F883D</Color>
      <Color x:Key="PrimaryHoverColor">#1C8139</Color>
      <Color x:Key="TabLineColor">#FD8C73</Color>
      <Color x:Key="ButtonColor">#F6F8FA</Color>
      <Color x:Key="ButtonHoverColor">#EFF2F5</Color>

      <Color x:Key="SystemAccentColor">#0969DA</Color>
      <Color x:Key="SystemAccentColorDark1">#0550AE</Color>
      <Color x:Key="SystemAccentColorLight1">#218BFF</Color>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <SolidColorBrush x:Key="FrameBrush" Color="{DynamicResource FrameColor}" />
  <SolidColorBrush x:Key="CanvasBrush" Color="{DynamicResource CanvasColor}" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="{DynamicResource SurfaceColor}" />
  <SolidColorBrush x:Key="RaisedBrush" Color="{DynamicResource RaisedColor}" />
  <SolidColorBrush x:Key="RuleBrush" Color="{DynamicResource RuleColor}" />
  <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
  <SolidColorBrush x:Key="MutedBrush" Color="{DynamicResource MutedColor}" />
  <SolidColorBrush x:Key="SignalBrush" Color="{DynamicResource SignalColor}" />
  <SolidColorBrush x:Key="SignalWashBrush" Color="{DynamicResource SignalWashColor}" />
  <SolidColorBrush x:Key="EditorSelectionBrush" Color="{DynamicResource EditorSelectionColor}" />
  <SolidColorBrush x:Key="HoverWashBrush" Color="{DynamicResource HoverWashColor}" />
  <SolidColorBrush x:Key="OnLaneBrush" Color="{DynamicResource OnLaneColor}" />
  <SolidColorBrush x:Key="AddBgBrush" Color="{DynamicResource AddBgColor}" />
  <SolidColorBrush x:Key="AddFgBrush" Color="{DynamicResource AddFgColor}" />
  <SolidColorBrush x:Key="DelBgBrush" Color="{DynamicResource DelBgColor}" />
  <SolidColorBrush x:Key="AddWordBgBrush" Color="{DynamicResource AddWordBgColor}" />
  <SolidColorBrush x:Key="DelWordBgBrush" Color="{DynamicResource DelWordBgColor}" />
  <SolidColorBrush x:Key="DelFgBrush" Color="{DynamicResource DelFgColor}" />
  <SolidColorBrush x:Key="HunkBgBrush" Color="{DynamicResource HunkBgColor}" />
  <SolidColorBrush x:Key="HunkFgBrush" Color="{DynamicResource HunkFgColor}" />
  <SolidColorBrush x:Key="LinkBrush" Color="{DynamicResource LinkColor}" />
  <SolidColorBrush x:Key="GitModifiedBrush" Color="{DynamicResource GitModifiedColor}" />
  <SolidColorBrush x:Key="GitAddedBrush" Color="{DynamicResource GitAddedColor}" />
  <SolidColorBrush x:Key="GitUntrackedBrush" Color="{DynamicResource GitUntrackedColor}" />
  <SolidColorBrush x:Key="GitDeletedBrush" Color="{DynamicResource GitDeletedColor}" />
  <SolidColorBrush x:Key="GitConflictBrush" Color="{DynamicResource GitConflictColor}" />
  <SolidColorBrush x:Key="BadgeFillBrush" Color="{DynamicResource BadgeFillColor}" />
  <SolidColorBrush x:Key="ScrollThumbBrush" Color="{DynamicResource ScrollThumbColor}" />
  <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="{DynamicResource ScrollThumbHoverColor}" />
  <SolidColorBrush x:Key="ScrollThumbActiveBrush" Color="{DynamicResource ScrollThumbActiveColor}" />
  <SolidColorBrush x:Key="DangerBrush" Color="{DynamicResource DangerColor}" />
  <SolidColorBrush x:Key="PrimaryBrush" Color="{DynamicResource PrimaryColor}" />
  <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{DynamicResource PrimaryHoverColor}" />
  <SolidColorBrush x:Key="TabLineBrush" Color="{DynamicResource TabLineColor}" />
  <SolidColorBrush x:Key="ButtonBrush" Color="{DynamicResource ButtonColor}" />
  <SolidColorBrush x:Key="ButtonHoverBrush" Color="{DynamicResource ButtonHoverColor}" />
</ResourceDictionary>
