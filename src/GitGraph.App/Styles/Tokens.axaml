<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    Design tokens. The graph is drawn like a transit map: each lane is a line with its own colour,
    commits are stations on it. Everything around the graph stays in quiet slate so the lines carry the colour.
    The chrome (menu bar, sidebar, tab strip) sits on a darker frame; the open repository is one lit sheet in it.
  -->
  <!--
    Code uses the same fonts as the user's Ghostty terminal (Ubuntu Sans Mono, Noto Sans CJK SC for Chinese,
    DejaVu Sans Mono), falling back to the bundled IBM Plex Mono where those aren't installed.
    The interface keeps IBM Plex Sans, with Noto Sans CJK SC for Chinese.
  -->
  <FontFamily x:Key="UiFont">avares://GitGraph/Assets/Fonts#IBM Plex Sans, Noto Sans CJK SC</FontFamily>
  <FontFamily x:Key="CodeFont">Ubuntu Sans Mono, Noto Sans CJK SC, DejaVu Sans Mono, avares://GitGraph/Assets/Fonts#IBM Plex Mono</FontFamily>

  <x:Double x:Key="FontSizeSmall">11.5</x:Double>
  <x:Double x:Key="FontSizeBody">13</x:Double>
  <x:Double x:Key="FontSizeTitle">15</x:Double>
  <x:Double x:Key="FontSizeCode">13</x:Double>
  <x:Double x:Key="RowHeight">26</x:Double>

  <ResourceDictionary.ThemeDictionaries>
    <!-- Night map -->
    <ResourceDictionary x:Key="Dark">
      <Color x:Key="FrameColor">#11151C</Color>
      <Color x:Key="CanvasColor">#171C26</Color>
      <Color x:Key="SurfaceColor">#1C222D</Color>
      <Color x:Key="RaisedColor">#262E3B</Color>
      <Color x:Key="RuleColor">#29313F</Color>
      <Color x:Key="TextColor">#E4E8EF</Color>
      <Color x:Key="MutedColor">#8B95A7</Color>
      <Color x:Key="SignalColor">#F2B33D</Color>
      <Color x:Key="SignalWashColor">#2EF2B33D</Color>
      <Color x:Key="HoverWashColor">#14FFFFFF</Color>
      <Color x:Key="OnLaneColor">#10141B</Color>
      <Color x:Key="AddBgColor">#1D3A32</Color>
      <Color x:Key="AddWordBgColor">#2F6652</Color>
      <Color x:Key="AddFgColor">#7FD1B0</Color>
      <Color x:Key="DelBgColor">#41242B</Color>
      <Color x:Key="DelWordBgColor">#74343F</Color>
      <Color x:Key="DelFgColor">#F08A86</Color>
      <Color x:Key="HunkBgColor">#222B3E</Color>
      <Color x:Key="HunkFgColor">#8EA2D4</Color>
      <Color x:Key="LinkColor">#7FA6F5</Color>
      <Color x:Key="ScrollThumbColor">#30FFFFFF</Color>
      <Color x:Key="BadgeFillColor">#14FFFFFF</Color>
      <!-- VS Code's git decoration colours (Dark+) -->
      <Color x:Key="GitModifiedColor">#E2C08D</Color>
      <Color x:Key="GitAddedColor">#81B88B</Color>
      <Color x:Key="GitUntrackedColor">#73C991</Color>
      <Color x:Key="GitDeletedColor">#C74E39</Color>
      <Color x:Key="GitConflictColor">#E4676B</Color>
      <Color x:Key="ScrollThumbHoverColor">#55FFFFFF</Color>
      <Color x:Key="ScrollThumbActiveColor">#80FFFFFF</Color>
      <Color x:Key="DangerColor">#F07167</Color>

      <Color x:Key="SystemAccentColor">#F2B33D</Color>
      <Color x:Key="SystemAccentColorDark1">#D99C2B</Color>
      <Color x:Key="SystemAccentColorLight1">#F5C364</Color>
    </ResourceDictionary>
    <!-- Day map -->
    <ResourceDictionary x:Key="Light">
      <Color x:Key="FrameColor">#E4E8EE</Color>
      <Color x:Key="CanvasColor">#FFFFFF</Color>
      <Color x:Key="SurfaceColor">#F7F8FA</Color>
      <Color x:Key="RaisedColor">#ECEFF4</Color>
      <Color x:Key="RuleColor">#DFE4EB</Color>
      <Color x:Key="TextColor">#1C2330</Color>
      <Color x:Key="MutedColor">#5D697C</Color>
      <Color x:Key="SignalColor">#B07206</Color>
      <Color x:Key="SignalWashColor">#26E9A21B</Color>
      <Color x:Key="HoverWashColor">#0C1C2330</Color>
      <Color x:Key="OnLaneColor">#11161F</Color>
      <Color x:Key="AddBgColor">#E1F3EA</Color>
      <Color x:Key="AddWordBgColor">#B5E3CB</Color>
      <Color x:Key="AddFgColor">#1E7652</Color>
      <Color x:Key="DelBgColor">#FBE6E4</Color>
      <Color x:Key="DelWordBgColor">#F5C1BB</Color>
      <Color x:Key="DelFgColor">#B13A32</Color>
      <Color x:Key="HunkBgColor">#E8EEF8</Color>
      <Color x:Key="HunkFgColor">#4760A0</Color>
      <Color x:Key="LinkColor">#2F5FC4</Color>
      <Color x:Key="ScrollThumbColor">#2A1C2330</Color>
      <Color x:Key="BadgeFillColor">#0A1C2330</Color>
      <!-- VS Code's git decoration colours (Light+) -->
      <Color x:Key="GitModifiedColor">#895503</Color>
      <Color x:Key="GitAddedColor">#587C0C</Color>
      <Color x:Key="GitUntrackedColor">#007100</Color>
      <Color x:Key="GitDeletedColor">#AD0707</Color>
      <Color x:Key="GitConflictColor">#AD0707</Color>
      <Color x:Key="ScrollThumbHoverColor">#501C2330</Color>
      <Color x:Key="ScrollThumbActiveColor">#781C2330</Color>
      <Color x:Key="DangerColor">#C2382E</Color>

      <Color x:Key="SystemAccentColor">#B07206</Color>
      <Color x:Key="SystemAccentColorDark1">#966104</Color>
      <Color x:Key="SystemAccentColorLight1">#C88A1F</Color>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <SolidColorBrush x:Key="FrameBrush" Color="{DynamicResource FrameColor}" />
  <SolidColorBrush x:Key="CanvasBrush" Color="{DynamicResource CanvasColor}" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="{DynamicResource SurfaceColor}" />
  <SolidColorBrush x:Key="RaisedBrush" Color="{DynamicResource RaisedColor}" />
  <SolidColorBrush x:Key="RuleBrush" Color="{DynamicResource RuleColor}" />
  <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
  <SolidColorBrush x:Key="MutedBrush" Color="{DynamicResource MutedColor}" />
  <SolidColorBrush x:Key="SignalBrush" Color="{DynamicResource SignalColor}" />
  <SolidColorBrush x:Key="SignalWashBrush" Color="{DynamicResource SignalWashColor}" />
  <SolidColorBrush x:Key="HoverWashBrush" Color="{DynamicResource HoverWashColor}" />
  <SolidColorBrush x:Key="OnLaneBrush" Color="{DynamicResource OnLaneColor}" />
  <SolidColorBrush x:Key="AddBgBrush" Color="{DynamicResource AddBgColor}" />
  <SolidColorBrush x:Key="AddFgBrush" Color="{DynamicResource AddFgColor}" />
  <SolidColorBrush x:Key="DelBgBrush" Color="{DynamicResource DelBgColor}" />
  <SolidColorBrush x:Key="AddWordBgBrush" Color="{DynamicResource AddWordBgColor}" />
  <SolidColorBrush x:Key="DelWordBgBrush" Color="{DynamicResource DelWordBgColor}" />
  <SolidColorBrush x:Key="DelFgBrush" Color="{DynamicResource DelFgColor}" />
  <SolidColorBrush x:Key="HunkBgBrush" Color="{DynamicResource HunkBgColor}" />
  <SolidColorBrush x:Key="HunkFgBrush" Color="{DynamicResource HunkFgColor}" />
  <SolidColorBrush x:Key="LinkBrush" Color="{DynamicResource LinkColor}" />
  <SolidColorBrush x:Key="GitModifiedBrush" Color="{DynamicResource GitModifiedColor}" />
  <SolidColorBrush x:Key="GitAddedBrush" Color="{DynamicResource GitAddedColor}" />
  <SolidColorBrush x:Key="GitUntrackedBrush" Color="{DynamicResource GitUntrackedColor}" />
  <SolidColorBrush x:Key="GitDeletedBrush" Color="{DynamicResource GitDeletedColor}" />
  <SolidColorBrush x:Key="GitConflictBrush" Color="{DynamicResource GitConflictColor}" />
  <SolidColorBrush x:Key="BadgeFillBrush" Color="{DynamicResource BadgeFillColor}" />
  <SolidColorBrush x:Key="ScrollThumbBrush" Color="{DynamicResource ScrollThumbColor}" />
  <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="{DynamicResource ScrollThumbHoverColor}" />
  <SolidColorBrush x:Key="ScrollThumbActiveBrush" Color="{DynamicResource ScrollThumbActiveColor}" />
  <SolidColorBrush x:Key="DangerBrush" Color="{DynamicResource DangerColor}" />
</ResourceDictionary>
