<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    Design tokens, after GitHub's Primer: a dark header frame, a plain canvas, 1 px borders, blue for focus and
    selection, green for the main action, a coral underline on the selected tab. The graph's lane colours are the
    one bright thing; everything around them stays in Primer's quiet greys.
  -->
  <!--
    The interface uses the system sans GitHub asks for (Segoe UI on Windows, Noto Sans on Linux), falling back to
    the bundled IBM Plex Sans, with Noto Sans CJK SC for Chinese. Code uses the same fonts as the user's Ghostty
    terminal (Ubuntu Sans Mono, Noto Sans CJK SC, DejaVu Sans Mono), falling back to the bundled IBM Plex Mono.
  -->
  <FontFamily x:Key="UiFont">Segoe UI, Noto Sans, avares://GitGraph/Assets/Fonts#IBM Plex Sans, Noto Sans CJK SC</FontFamily>
  <FontFamily x:Key="CodeFont">Ubuntu Sans Mono, Noto Sans CJK SC, DejaVu Sans Mono, avares://GitGraph/Assets/Fonts#IBM Plex Mono</FontFamily>

  <x:Double x:Key="FontSizeSmall">11.5</x:Double>
  <x:Double x:Key="FontSizeBody">13</x:Double>
  <x:Double x:Key="FontSizeTitle">15</x:Double>
  <x:Double x:Key="FontSizeCode">13</x:Double>
  <x:Double x:Key="FontSizeCaption">12</x:Double>
  <x:Double x:Key="FontSizeLarge">17</x:Double>
  <x:Double x:Key="DiffLineHeight">19</x:Double>
  <x:Double x:Key="RowHeight">26</x:Double>

  <ResourceDictionary.ThemeDictionaries>
    <!-- Claude Code warm charcoal dark -->
    <ResourceDictionary x:Key="Dark">
      <Color x:Key="FrameColor">#141413</Color>
      <Color x:Key="CanvasColor">#1E1D1B</Color>
      <Color x:Key="SurfaceColor">#1A1917</Color>
      <Color x:Key="RaisedColor">#282623</Color>
      <Color x:Key="RuleColor">#2E2C28</Color>
      <Color x:Key="TextColor">#ECEAE4</Color>
      <Color x:Key="MutedColor">#9C988F</Color>
      <Color x:Key="SignalColor">#D97757</Color>
      <Color x:Key="SignalWashColor">#28D97757</Color>
      <!-- Selected text in the code viewer -->
      <Color x:Key="EditorSelectionColor">#3D2E27</Color>
      <Color x:Key="HoverWashColor">#18ECEAE4</Color>
      <Color x:Key="OnLaneColor">#141413</Color>
      <Color x:Key="AddBgColor">#243A6B4A</Color>
      <Color x:Key="AddWordBgColor">#594EA868</Color>
      <Color x:Key="AddFgColor">#4EA868</Color>
      <Color x:Key="DelBgColor">#247A3632</Color>
      <Color x:Key="DelWordBgColor">#59E06C65</Color>
      <Color x:Key="DelFgColor">#E06C65</Color>
      <Color x:Key="HunkBgColor">#1ED97757</Color>
      <Color x:Key="HunkFgColor">#9C988F</Color>
      <Color x:Key="LinkColor">#E0876A</Color>
      <Color x:Key="ScrollThumbColor">#2CECEAE4</Color>
      <Color x:Key="BadgeFillColor">#14ECEAE4</Color>
      <Color x:Key="FieldColor">#171614</Color>
      <!-- Warm earth-toned git status colors -->
      <Color x:Key="GitModifiedColor">#D99B38</Color>
      <Color x:Key="GitAddedColor">#4EA868</Color>
      <Color x:Key="GitUntrackedColor">#4EA868</Color>
      <Color x:Key="GitDeletedColor">#E06C65</Color>
      <Color x:Key="GitConflictColor">#D97757</Color>
      <Color x:Key="ScrollThumbHoverColor">#4CECEAE4</Color>
      <Color x:Key="ScrollThumbActiveColor">#73ECEAE4</Color>
      <Color x:Key="DangerColor">#C94A4A</Color>
      <!-- Primary terracotta action and Winc-style active tab fill -->
      <Color x:Key="PrimaryColor">#D97757</Color>
      <Color x:Key="PrimaryForegroundColor">#FFFFFF</Color>
      <Color x:Key="PrimaryHoverColor">#E28567</Color>
      <Color x:Key="TabLineColor">#D97757</Color>
      <Color x:Key="TabFillColor">#2A2723</Color>
      <Color x:Key="TabDividerColor">#1AECEAE4</Color>
      <Color x:Key="ButtonColor">#24221F</Color>
      <Color x:Key="ButtonHoverColor">#2E2C28</Color>
      <!-- Menus and other overlays -->
      <Color x:Key="OverlayColor">#1F1E1B</Color>
      <!-- Tooltips -->
      <Color x:Key="TooltipColor">#2E2C28</Color>
      <Color x:Key="OnTooltipColor">#ECEAE4</Color>
      <!-- The edge of a small control such as an unchecked checkbox, stronger than a rule so it stays visible -->
      <Color x:Key="ControlEdgeColor">#45423C</Color>
      <!-- Folder icons in a folder tab's tree -->
      <Color x:Key="FolderIconColor">#D99B56</Color>

      <Color x:Key="SystemAccentColor">#D97757</Color>
      <Color x:Key="SystemAccentColorDark1">#C06243</Color>
      <Color x:Key="SystemAccentColorLight1">#E58D70</Color>
    </ResourceDictionary>
    <!-- Claude Code warm paper light -->
    <ResourceDictionary x:Key="Light">
      <Color x:Key="FrameColor">#F0EDE6</Color>
      <Color x:Key="CanvasColor">#FAF9F5</Color>
      <Color x:Key="SurfaceColor">#F5F3EE</Color>
      <Color x:Key="RaisedColor">#ECE8DF</Color>
      <Color x:Key="RuleColor">#E2DDD3</Color>
      <Color x:Key="TextColor">#1A1917</Color>
      <Color x:Key="MutedColor">#6E6A61</Color>
      <Color x:Key="SignalColor">#C96442</Color>
      <Color x:Key="SignalWashColor">#1FC96442</Color>
      <Color x:Key="EditorSelectionColor">#F3D5C9</Color>
      <Color x:Key="HoverWashColor">#121A1917</Color>
      <Color x:Key="OnLaneColor">#141413</Color>
      <Color x:Key="AddBgColor">#DCF3E2</Color>
      <Color x:Key="AddWordBgColor">#B0E5BF</Color>
      <Color x:Key="AddFgColor">#1E7A40</Color>
      <Color x:Key="DelBgColor">#FCE8E6</Color>
      <Color x:Key="DelWordBgColor">#F7C7C2</Color>
      <Color x:Key="DelFgColor">#C43B33</Color>
      <Color x:Key="HunkBgColor">#14C96442</Color>
      <Color x:Key="HunkFgColor">#6E6A61</Color>
      <Color x:Key="LinkColor">#C96442</Color>
      <Color x:Key="ScrollThumbColor">#261A1917</Color>
      <Color x:Key="BadgeFillColor">#0D1A1917</Color>
      <Color x:Key="FieldColor">#FAF9F5</Color>
      <Color x:Key="GitModifiedColor">#9A6700</Color>
      <Color x:Key="GitAddedColor">#1E7A40</Color>
      <Color x:Key="GitUntrackedColor">#1E7A40</Color>
      <Color x:Key="GitDeletedColor">#C43B33</Color>
      <Color x:Key="GitConflictColor">#C96442</Color>
      <Color x:Key="ScrollThumbHoverColor">#451A1917</Color>
      <Color x:Key="ScrollThumbActiveColor">#661A1917</Color>
      <Color x:Key="DangerColor">#C43B33</Color>
      <Color x:Key="PrimaryColor">#C96442</Color>
      <Color x:Key="PrimaryForegroundColor">#FFFFFF</Color>
      <Color x:Key="PrimaryHoverColor">#B85636</Color>
      <Color x:Key="TabLineColor">#C96442</Color>
      <Color x:Key="TabFillColor">#EAE5DB</Color>
      <Color x:Key="TabDividerColor">#1A1A1917</Color>
      <Color x:Key="ButtonColor">#FAF9F5</Color>
      <Color x:Key="ButtonHoverColor">#EFECE4</Color>
      <Color x:Key="OverlayColor">#FAF9F5</Color>
      <Color x:Key="TooltipColor">#1A1917</Color>
      <Color x:Key="OnTooltipColor">#FAF9F5</Color>
      <Color x:Key="ControlEdgeColor">#CFC9BC</Color>
      <Color x:Key="FolderIconColor">#C96442</Color>

      <Color x:Key="SystemAccentColor">#C96442</Color>
      <Color x:Key="SystemAccentColorDark1">#AD5031</Color>
      <Color x:Key="SystemAccentColorLight1">#D97757</Color>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <SolidColorBrush x:Key="FrameBrush" Color="{DynamicResource FrameColor}" />
  <SolidColorBrush x:Key="CanvasBrush" Color="{DynamicResource CanvasColor}" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="{DynamicResource SurfaceColor}" />
  <SolidColorBrush x:Key="RaisedBrush" Color="{DynamicResource RaisedColor}" />
  <SolidColorBrush x:Key="RuleBrush" Color="{DynamicResource RuleColor}" />
  <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
  <SolidColorBrush x:Key="MutedBrush" Color="{DynamicResource MutedColor}" />
  <SolidColorBrush x:Key="SignalBrush" Color="{DynamicResource SignalColor}" />
  <SolidColorBrush x:Key="SignalWashBrush" Color="{DynamicResource SignalWashColor}" />
  <SolidColorBrush x:Key="EditorSelectionBrush" Color="{DynamicResource EditorSelectionColor}" />
  <SolidColorBrush x:Key="HoverWashBrush" Color="{DynamicResource HoverWashColor}" />
  <SolidColorBrush x:Key="OnLaneBrush" Color="{DynamicResource OnLaneColor}" />
  <SolidColorBrush x:Key="AddBgBrush" Color="{DynamicResource AddBgColor}" />
  <SolidColorBrush x:Key="AddFgBrush" Color="{DynamicResource AddFgColor}" />
  <SolidColorBrush x:Key="DelBgBrush" Color="{DynamicResource DelBgColor}" />
  <SolidColorBrush x:Key="AddWordBgBrush" Color="{DynamicResource AddWordBgColor}" />
  <SolidColorBrush x:Key="DelWordBgBrush" Color="{DynamicResource DelWordBgColor}" />
  <SolidColorBrush x:Key="DelFgBrush" Color="{DynamicResource DelFgColor}" />
  <SolidColorBrush x:Key="HunkBgBrush" Color="{DynamicResource HunkBgColor}" />
  <SolidColorBrush x:Key="HunkFgBrush" Color="{DynamicResource HunkFgColor}" />
  <SolidColorBrush x:Key="LinkBrush" Color="{DynamicResource LinkColor}" />
  <SolidColorBrush x:Key="GitModifiedBrush" Color="{DynamicResource GitModifiedColor}" />
  <SolidColorBrush x:Key="GitAddedBrush" Color="{DynamicResource GitAddedColor}" />
  <SolidColorBrush x:Key="GitUntrackedBrush" Color="{DynamicResource GitUntrackedColor}" />
  <SolidColorBrush x:Key="GitDeletedBrush" Color="{DynamicResource GitDeletedColor}" />
  <SolidColorBrush x:Key="GitConflictBrush" Color="{DynamicResource GitConflictColor}" />
  <SolidColorBrush x:Key="BadgeFillBrush" Color="{DynamicResource BadgeFillColor}" />
  <SolidColorBrush x:Key="ScrollThumbBrush" Color="{DynamicResource ScrollThumbColor}" />
  <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="{DynamicResource ScrollThumbHoverColor}" />
  <SolidColorBrush x:Key="ScrollThumbActiveBrush" Color="{DynamicResource ScrollThumbActiveColor}" />
  <SolidColorBrush x:Key="DangerBrush" Color="{DynamicResource DangerColor}" />
  <SolidColorBrush x:Key="PrimaryBrush" Color="{DynamicResource PrimaryColor}" />
  <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{DynamicResource PrimaryHoverColor}" />
  <SolidColorBrush x:Key="TabLineBrush" Color="{DynamicResource TabLineColor}" />
  <SolidColorBrush x:Key="TabFillBrush" Color="{DynamicResource TabFillColor}" />
  <SolidColorBrush x:Key="TabDividerBrush" Color="{DynamicResource TabDividerColor}" />
  <SolidColorBrush x:Key="ButtonBrush" Color="{DynamicResource ButtonColor}" />
  <SolidColorBrush x:Key="ButtonHoverBrush" Color="{DynamicResource ButtonHoverColor}" />
  <SolidColorBrush x:Key="OverlayBrush" Color="{DynamicResource OverlayColor}" />
  <SolidColorBrush x:Key="FolderIconBrush" Color="{DynamicResource FolderIconColor}" />

  <!--
    Menus (context menus, flyouts, the menu bar's drop-downs and their submenus) after Primer's ActionMenu: the
    overlay surface with a 1 px border, rows inset from its edge that light up as rounded grey pills, full-width
    dividers and muted shortcuts. These replace Fluent's resources of the same keys, which its templates read directly.
  -->
  <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="{DynamicResource OverlayColor}" />
  <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="{DynamicResource RuleColor}" />
  <Thickness x:Key="MenuFlyoutPresenterBorderThemeThickness">1</Thickness>
  <Thickness x:Key="MenuFlyoutPresenterThemePadding">4</Thickness>
  <Thickness x:Key="MenuFlyoutItemThemePadding">10,6,10,6</Thickness>
  <Thickness x:Key="MenuFlyoutItemThemePaddingNarrow">10,6,10,6</Thickness>
  <Thickness x:Key="MenuFlyoutSeparatorThemePadding">-4,4,-4,4</Thickness>
  <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver" Color="{DynamicResource HoverWashColor}" />
  <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPressed" Color="{DynamicResource HoverWashColor}" />
  <SolidColorBrush x:Key="MenuFlyoutItemForeground" Color="{DynamicResource TextColor}" />
  <SolidColorBrush x:Key="MenuFlyoutItemForegroundPointerOver" Color="{DynamicResource TextColor}" />
  <SolidColorBrush x:Key="MenuFlyoutItemForegroundPressed" Color="{DynamicResource TextColor}" />
  <SolidColorBrush x:Key="MenuFlyoutItemKeyboardAcceleratorTextForeground" Color="{DynamicResource MutedColor}" />
  <SolidColorBrush x:Key="MenuFlyoutItemKeyboardAcceleratorTextForegroundPointerOver" Color="{DynamicResource MutedColor}" />
  <SolidColorBrush x:Key="MenuFlyoutItemKeyboardAcceleratorTextForegroundPressed" Color="{DynamicResource MutedColor}" />
  <SolidColorBrush x:Key="MenuFlyoutSubItemChevron" Color="{DynamicResource MutedColor}" />
  <SolidColorBrush x:Key="MenuFlyoutSubItemChevronPointerOver" Color="{DynamicResource TextColor}" />
  <SolidColorBrush x:Key="MenuFlyoutSubItemChevronPressed" Color="{DynamicResource TextColor}" />
  <SolidColorBrush x:Key="MenuFlyoutSubItemChevronSubMenuOpened" Color="{DynamicResource TextColor}" />
</ResourceDictionary>
