<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AssemblyName>GitGraph</AssemblyName>
    <ApplicationIcon>Assets\Icons\gitgraph.ico</ApplicationIcon>
    <RootNamespace>GitGraph.App</RootNamespace>
    <!-- Published builds are precompiled: startup to a loaded diff took 1.7 s instead of 2.5 s, for 19 MB more. -->
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <!-- TextMate grammars TextMateSharp.Grammars lacks (Services/SyntaxHighlighter.cs). -->
    <EmbeddedResource Include="Syntaxes\*.tmLanguage.json" LogicalName="GitGraph.App.Syntaxes.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Wayland" Version="12.1.3" />
    <PackageReference Include="ShadUI" Version="0.2.4" />
    <PackageReference Include="Iciclecreek.Avalonia.Terminal" Version="4.1.1" />
    <PackageReference Include="TextMateSharp.Grammars" Version="2.0.3" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Lucide.Avalonia" Version="0.2.24" />
    <PackageReference Include="Markdig" Version="1.3.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GitGraph.Core\GitGraph.Core.csproj" />
  </ItemGroup>
</Project>
