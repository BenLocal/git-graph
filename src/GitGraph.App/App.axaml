<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GitGraph.App.App"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://GitGraph/Styles/Tokens.axaml" />
        <ResourceInclude Source="avares://GitGraph/Styles/DiffTemplates.axaml" />
        <ResourceInclude Source="avares://GitGraph/Styles/ScrollBar.axaml" />
        <ResourceInclude Source="avares://GitGraph/Styles/Fields.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <!-- Fluent's accent is GitHub's blue; without it, the light theme takes the desktop's accent (Ubuntu's orange) -->
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" Accent="#0969DA" />
        <ColorPaletteResources x:Key="Dark" Accent="#1F6FEB" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
    <StyleInclude Source="avares://GitGraph/Styles/Controls.axaml" />
  </Application.Styles>
</Application>
